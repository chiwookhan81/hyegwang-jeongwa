const tx = (x, y, s, t, col = '#334155', o = '') => `<text x="${x}" y="${y}" font-size="${s}" text-anchor="middle" dominant-baseline="central" fill="${col}" ${o}>${t}</text>`;
const badge = (x, y, n, col = '#ef4444', r = 15) => `<circle cx="${x}" cy="${y}" r="${r}" fill="${col}" stroke="#fff" stroke-width="3"/>${tx(x, y + 1, r * 1.1, n, '#fff')}`;
const pill = (x, y, t, bg = '#0ea5e9', s = 24) => { const w = Math.max(60, String(t).replace(/<[^>]+>/g, '').length * s * .62 + 28); return `<rect x="${x - w / 2}" y="${y - s * .8}" width="${w}" height="${s * 1.6}" rx="${s * .8}" fill="${bg}"/>${tx(x, y + 1, s, t, '#fff')}`; };
const star = (x, y) => em(x, y, 34, '⭐');

