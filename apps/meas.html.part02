", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]}];   // 예: [{ name:'공통', src:'data:audio/mpeg;base64,...', clips:{ '맞아요':[0.0, 0.8] } }]
let VOICES = [], VOICE = null, LAST_AUDIO = [], playToken = 0, curSrc = null;
// 기기 목소리가 단위를 영어 글자로 읽지 않게 (cm → 센티미터)
const UNIT_SAY = { cm: '센티미터', mm: '밀리미터', km: '킬로미터', mL: '밀리리터', ml: '밀리리터', kg: '킬로그램', m: '미터', L: '리터', g: '그램' };
function sayUnits(t) {
  return String(t).replace(/(^|[^A-Za-z])(cm|mm|km|mL|ml|kg|m|L|g)(?![A-Za-z0-9자])/g, (_, p, u) => p + UNIT_SAY[u])
    .replace(/(센티미터|밀리미터|킬로미터|밀리리터|킬로그램|미터|리터|그램)\s*\(\1\)/g, '$1');
}
function cleanSay(t) {
  // 1.2.0: 동그라미 번호(①②③)는 숫자로, 단위(L·mL·cm·kg 등)는 우리말로 읽어요
  t = String(t).replace(/[\u2460-\u2473]/g, c => String(c.charCodeAt(0) - 0x245F)).replace(/\s*(°C|℃)/g, ' 도').replace(/\s*°/g, ' 도').replace(/(^|[^A-Za-z])(cm|mm|km|kg|mL|g|L|m)(?=[^A-Za-z0-9자]|$)/g, (m, a, u) => a + ({ cm: ' 센티미터', mm: ' 밀리미터', km: ' 킬로미터', kg: ' 킬로그램', mL: ' 밀리리터', g: ' 그램', L: ' 리터', m: ' 미터' })[u]).replace(/(\d)\s*mL\b/gi, '$1 밀리리터').replace(/(\d)\s*L\b/g, '$1 리터').replace(/(\d)\s*km\b/g, '$1 킬로미터').replace(/(\d)\s*cm\b/g, '$1 센티미터').replace(/(\d)\s*mm\b/g, '$1 밀리미터').replace(/(\d)\s*kg\b/g, '$1 킬로그램').replace(/(\d)\s*g\b/g, '$1 그램').replace(/(\d)\s*m\b/g, '$1 미터').replace(/(\d)\s*(°C|℃)/g, '$1 도');
  return sayUnits(String(t).replace(/<[^>]+>/g, ' ')).replace(/&nbsp;/g, ' ')
    .replace(/[~～〜]/g, '').replace(/[→←⇒▶◀›»]/g, ', ').replace(/[·•ㆍ]/g, ', ')
    .replace(/[…]/g, '. ').replace(/[※★☆♪♥#*_|\/\\"'“”‘’「」『』\[\]{}<>]/g, ' ')
    .replace(/[()]/g, ', ').replace(/[\u{1F300}-\u{1FAFF}\u{1F000}-\u{1F2FF}←-⇿⌀-➿⬀-⯿️‍]/gu, '')
    .replace(/\s*,\s*(,\s*)+/g, ', ').replace(/\s+/g, ' ').trim();
}
function voiceScore(v) {
  const n = v.name; let s = 0;
  if (/natural|neural|online/i.test(n)) s += 50;
  if (/google/i.test(n)) s += 30;
  if (/sunhi|injoon|hyunsu|yuna|sora|jimin|seoyeon/i.test(n)) s += 15;
  if (v.localService === false) s += 5;
  return s;
}
function loadVoices() {
  try {
    VOICES = speechSynthesis.getVoices().filter(v => /^ko/i.test(v.lang)).sort((a, b) => voiceScore(b) - voiceScore(a));
    let saved = null; try { saved = localStorage.getItem(VOICE_KEY); } catch (e) {}
    VOICE = VOICES.find(v => v.name === saved) || VOICES[0] || null;
    const sel = document.getElementById('voice-sel');
    if (sel) sel.innerHTML = (VOICE_SPRITES.length ? '<option value="__rec">🎙️ 녹음 목소리</option>' : '') + (VOICES.length ? VOICES.map(v => `<option ${v === VOICE ? 'selected' : ''}>${v.name}</option>`).join('') : '<option>기본 목소리</option>');
  } catch (e) {}
}
function pickVoice(name) { if (name !== '__rec') { VOICE = VOICES.find(v => v.name === name) || VOICE; try { localStorage.setItem(VOICE_KEY, name); } catch (e) {} } playLines(['맞아요']); }
try { loadVoices(); speechSynthesis.onvoiceschanged = loadVoices; } catch (e) {}
// 녹음은 대사마다 따로 담아 두고, 말할 대사만 그때그때 풀어요.
// (긴 녹음을 한꺼번에 풀면 메모리를 많이 써서 느린 컴에서 멈출 수 있어요)
async function loadSprite() {}
const CLIPBUF = new Map();   // 최근에 쓴 대사만 기억해요
function findClip(l) { for (const sp of VOICE_SPRITES) if (sp.parts && sp.parts[l] != null) return [sp, l]; return null; }
async function clipBuf(sp, l) {
  const k = sp.name + '|' + l;
  if (CLIPBUF.has(k)) { const b = CLIPBUF.get(k); CLIPBUF.delete(k); CLIPBUF.set(k, b); return b; }
  const s = atob(sp.data[sp.parts[l]]), u = new Uint8Array(s.length); for (let i = 0; i < s.length; i++) u[i] = s.charCodeAt(i);
  const b = await ac().decodeAudioData(u.buffer);
  CLIPBUF.set(k, b); if (CLIPBUF.size > 60) CLIPBUF.delete(CLIPBUF.keys().next().value);
  return b;
}
function stopVoice() { VQ_GEN++; VQ_RUN = false; VQ.splice(0).forEach(q => q.res()); _hardStop(); }
function _hardStop() { playToken++; try { speechSynthesis.cancel(); } catch (e) {} try { curSrc && curSrc.stop(); } catch (e) {} }
// 녹음 목소리 크기: 녹음 파일을 미리 두 배 정도(+7dB) 키워 두었어요. 더 키우려면 VOICE_GAIN 을 올려요.
const VOICE_GAIN = 1;
let VOUT = null;
function voiceOut() { const a = ac(); if (VOUT && VOUT.context === a) return VOUT; const g = a.createGain(); g.gain.value = VOICE_GAIN; g.connect(a.destination); VOUT = g; return g; }
function playClip([sp, l]) {
  const tok = playToken;
  return new Promise(async res => { try { const buf = await clipBuf(sp, l); if (tok !== playToken) { res(); return; } const a = ac(); const s = a.createBufferSource(); s.buffer = buf; s.connect(voiceOut()); curSrc = s; s.onended = res; s.start(0); } catch (e) { res(); } });
}
function ttsLine(t) {
  return new Promise(res => {
    try {
      const u = new SpeechSynthesisUtterance(cleanSay(t));
      u.lang = 'ko-KR'; if (VOICE) u.voice = VOICE;
      const nat = VOICE && voiceScore(VOICE) >= 30; u.rate = nat ? 1 : .92; u.pitch = nat ? 1 : 1.08;
      let done = false; const fin = () => { if (!done) { done = true; res(); } };
      u.onend = fin; u.onerror = fin; setTimeout(fin, 1500 + t.length * 260);
      speechSynthesis.speak(u);
    } catch (e) { res(); }
  });
}
// lines: 읽을 대사 조각 배열
// 목소리 차례 지키기: 하던 말은 끝까지 하고, 다음 말은 2초 쉬고 나와요
var VOICE_GAP = 2000, VOICE_END = 0, VQ = [], VQ_RUN = false, VQ_GEN = 0, VOICE_BUSY = Promise.resolve();
// 1.1.3 말 끊기 규칙 (세 가지)
// ① 목소리가 나오는 중에 단추를 누르면(급한 아이) 하던 말과 줄 선 말을 바로 끊고 새 화면의 말을 해요.
// ② 말이 다 끝난 뒤에 누르면(천천히 하는 아이) 끊을 것이 없어 설명을 끝까지 다 들어요.
// ③ 말하는 중에 끊는 일이 두 번 이어지면 급한 아이로 보고, 말 사이 쉼을 2초→0.5초로 줄이고 설명이 끝나길 기다리지 않아요.
//    말이 끝난 뒤에 누르면 다시 2초로 돌아가요. 빈 곳을 만지는 것은 세지 않아요(단추·끌어 옮기는 그림·스위치 키만).
var TAP_AT = 0, TAP_FRESH = false, CUTS = 0;
const isBtn = t => { try { return !!(t && t.closest && t.closest('button,a,input,select,label,[onclick],[role="button"],[tabindex]')) || !!(t && t.nodeType === 1 && /pointer|grab|move/.test(getComputedStyle(t).cursor)); } catch (e) { return false; } };
const FAST = () => CUTS >= 2;
const VOICE_ON = () => VQ_RUN || VQ.length > 0;
const vGap = () => FAST() ? 500 : VOICE_GAP;
function onTap(e) {
  if (e.type === 'pointerdown' && !isBtn(e.target)) return;
  TAP_AT = Date.now(); TAP_FRESH = true;
  if (VOICE_ON()) { CUTS++; VQ_GEN++; VQ_RUN = false; VQ.splice(0).forEach(q => q.res()); _hardStop(); VOICE_END = 0; }   // ① 급한 아이: 바로 끊어요
  else CUTS = 0;                                                                                                          // ② 천천히: 다 들었어요
}
addEventListener('pointerdown', onTap, true); addEventListener('keydown', onTap, true);
addEventListener('pointerup', () => { if (Date.now() - TAP_AT < 1500) TAP_FRESH = true; }, true);
function playLines(lines) {
  const key = JSON.stringify(lines || []);
  const tap = TAP_FRESH && Date.now() - TAP_AT < 800;
  if (tap || FAST()) {
    if (tap) TAP_FRESH = false;
    VQ_GEN++; VQ_RUN = false; VQ.splice(0).forEach(q => q.res()); _hardStop(); VOICE_END = 0;
  } else {
    const same = VQ.find(q => q.key === key); if (same) return same.p;
  }
  let res; const p = new Promise(r => res = r);
  VQ.push({ lines, key, res, p }); while (VQ.length > 3) VQ.shift().res();
  VOICE_BUSY = p; if (!VQ_RUN) vqRun(); return p;
}
async function vqRun() {
  VQ_RUN = true; const gen = VQ_GEN;
  while (VQ.length && gen === VQ_GEN) {
    const w = VOICE_END ? vGap() - (Date.now() - VOICE_END) : 0;
    if (w > 0) await new Promise(r => setTimeout(r, w));
    if (gen !== VQ_GEN || !VQ.length) break;
    const q = VQ.shift(); try { await _playLines(q.lines); } catch (e) {}
    if (gen === VQ_GEN) VOICE_END = Date.now(); q.res();
  }
  if (gen === VQ_GEN) VQ_RUN = false;
}
async function whenQuiet(min = 0) {
  const t0 = Date.now(); let p;
  do { p = VOICE_BUSY; try { await p; } catch (e) {} } while (p !== VOICE_BUSY);
  const w = min - (Date.now() - t0); if (w > 0) await new Promise(r => setTimeout(r, w));
}
// 말이 다 끝나고 2초 쉰 뒤에 다음 화면으로 (말이 없었으면 ms만 기다려요)
async function calm(ms = 0) {
  const t0 = Date.now();
  if (FAST()) { await new Promise(r => setTimeout(r, Math.min(ms || 600, 800))); return; }   // 빨리 푸는 중이면 설명을 기다리지 않아요
  await whenQuiet();
  const need = Math.max(ms - (Date.now() - t0), VOICE_END ? vGap() - (Date.now() - VOICE_END) : 0);
  if (need > 0) await new Promise(r => setTimeout(r, need));
}
async function _playLines(lines) {
  if (typeof onVoiceUsed === 'function') onVoiceUsed(lines);
  LAST_AUDIO = lines || []; _hardStop();
  if (!soundOn || !lines || !lines.length) return;
  await loadSprite();
  const tok = playToken;
  const cs = lines.map(findClip);
  // 한 번에 읽는 말은 한 목소리로: 녹음이 모두 있으면 녹음, 하나라도 없으면 전체를 기기 목소리로
  if (cs.every(Boolean)) { for (const c of cs) { if (tok !== playToken) return; await playClip(c); } }
  else if (tok === playToken) await ttsLine(lines.join(' '));
}
function sayAgain() { playLines(LAST_AUDIO); }


function sfx(n) {
  if (!soundOn) return; const a = ac(); if (!a) return; const t = a.currentTime;
  if (n === 'good') { tone(523, t, .1, 'triangle', .16); tone(784, t + .08, .18, 'triangle', .16); }
  if (n === 'wrong') { tone(300, t, .2, 'square', .07, 200); }
  if (n === 'clear') { [523, 659, 784, 1047, 1319].forEach((f, i) => tone(f, t + i * .11, .3, 'triangle', .16)); }
  if (n === 'tap') tone(900, t, .05, 'sine', .08);
}
