    h:'두 컵의 크기가 똑같아요. 물의 높이를 비교해요.', e:'크기가 같은 컵이면 물이 높이 찬 쪽이 더 많아요.' },
  { q:'물이 가장 적게 담긴 컵은 어느 것일까요?', v:{k:'glasses', items:[{lab:'가',w:120,h:240,lvl:.7},{lab:'나',w:120,h:240,lvl:.3,ok:1},{lab:'다',w:120,h:240,lvl:.55}]}, o:['가','나','다'], a:1,
    h:'물의 높이가 가장 낮은 컵을 찾아요.', e:'손님이 조금만 달라고 하면 적게 담아요.' },
  { q:'두 병의 물을 똑같은 컵에 따랐어요. 어느 병에 물이 더 많았을까요?', v:{k:'cups', groups:[{lab:'가 병', n:3, from:'🍶'},{lab:'나 병', n:5, from:'🍶'}]}, o:['가 병','나 병'], a:1,
    h:'병에서 나온 컵 수를 세어 비교해요.', e:'같은 컵으로 재면 어느 그릇에 더 많이 들어가는지 알 수 있어요.' },
  { q:'두 컵의 물 높이가 같아요. 물이 더 많은 컵은 어느 것일까요?', v:{k:'glasses', items:[{lab:'가',w:90,h:240,lvl:.6},{lab:'나',w:230,h:240,lvl:.6,ok:1}]}, o:['가','나'], a:1,
    h:'물 높이가 같으면 더 넓은 컵에 물이 더 많아요.', e:'컵이 넓으면 같은 높이라도 물이 더 많이 들어가요.' },
  { q:'작은 컵 2개로 큰 컵 1개가 가득 차요. 큰 컵 2개를 채우려면 작은 컵이 몇 개 필요할까요?', v:{k:'cups', cont:1, groups:[{lab:'큰 컵 1', n:2, target:'🥤'},{lab:'큰 컵 2', n:0, ghost:2, target:'🥤'}]}, o:['2개','3개','4개'], a:2,
    h:'큰 컵 하나에 작은 컵 2개씩이에요. 2개씩 두 번 세어 봐요.', x:'2개 + 2개 = ?', e:'바리스타는 컵 크기를 알고 음료 양을 맞춰요.' }
]},
{ id:'bal', tier:0, icon:'⚖️', name:'무게 비교하기', job:'🧑‍💼 과일가게 사장님', what:'과일의 무게', sc:{bg:'#fee2e2', main:'🧑‍💼', tools:['🍉','🍎','⚖️','🍊']},
  intro:'과일가게 사장님은 저울로 과일 무게를 비교해요. 양팔저울에서는 무거운 쪽이 아래로 내려가요.',
