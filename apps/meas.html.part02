    h:'바늘이 가리키는 큰 숫자를 읽어요.', e:'빵 반죽에는 밀가루를 정확하게 넣어야 해요.' },
  { q:'설탕의 무게는 몇 g일까요?', v:{k:'dial', max:1000, lab:100, tick:50, val:150, unit:'g', item:'🍬'}, o:['100g','150g','200g'], a:1,
    h:'바늘이 100과 200 사이 가운데에 있어요. 가운데는 150이에요.', x:'100 + 50 = ?', e:'설탕을 너무 많이 넣으면 빵이 너무 달아져요.' },
  { q:'버터의 무게는 몇 g일까요?', v:{k:'dial', max:1000, lab:100, tick:50, val:450, unit:'g', item:'🧈'}, o:['400g','450g','500g'], a:1,
    h:'400과 500 사이 가운데 눈금이에요.', x:'400 + 50 = ?', e:'버터를 재서 넣으면 쿠키가 늘 똑같이 고소해요.' },
  { q:'밀가루 500g이 필요한데 저울은 400g이에요. 어떻게 할까요?', v:{k:'dial', max:1000, lab:100, tick:50, val:400, unit:'g', item:'🌾'}, o:['더 넣어요','덜어 내요','딱 맞아요'], a:0,
    h:'400은 500보다 작아요. 모자라요.', e:'모자라면 더 넣고, 많으면 덜어 내요.' },
  { q:'초콜릿의 무게는 몇 g일까요?', v:{k:'dial', max:1000, lab:100, tick:50, val:700, unit:'g', item:'🍫'}, o:['600g','700g','800g'], a:1,
    h:'바늘 끝에 있는 큰 숫자를 읽어요.', e:'제빵사는 초콜릿 무게를 재서 케이크를 만들어요.' }
]},
{ id:'kg', tier:1, icon:'📦', name:'kg 저울 읽기', job:'🚚 택배 기사', what:'상자의 무게', sc:{bg:'#ffedd5', main:'🚚', tools:['📦','📦','⚖️','🏠']},
  intro:'택배 기사님은 상자의 무게를 kg(킬로그램)으로 재요. 무거운 상자는 배달비가 더 들고, 조심해서 옮겨요.',
  done:'kg 저울을 읽을 수 있어요! 무거운 것은 kg, 가벼운 것은 g이에요.',
  qs:[
  { q:'상자의 무게는 몇 kg일까요?', v:{k:'dial', max:10, lab:1, tick:1, val:3, unit:'kg', item:'📦', body:'#ffedd5'}, o:['2kg','3kg','4kg'], a:1,
    h:'바늘이 가리키는 숫자를 읽어요.', e:'택배 기사님은 상자 무게를 보고 배달비를 정해요.' },
  { q:'수박의 무게는 몇 kg일까요?', v:{k:'dial', max:10, lab:1, tick:1, val:6, unit:'kg', item:'🍉', body:'#ffedd5'}, o:['5kg','6kg','7kg'], a:1,
    h:'바늘 끝 숫자를 읽어요.', e:'시장 상인도 수박을 kg으로 재서 팔아요.' },
  { q:'쌀 포대의 무게는 몇 kg일까요?', v:{k:'dial', max:20, lab:5, tick:1, val:12, unit:'kg', item:'🌾', body:'#ffedd5'}, o:['10kg','12kg','15kg'], a:1,
    h:'바늘이 10을 지났어요. 10에서 작은 눈금을 세어 봐요.', x:'10 + 2 = ?', e:'무거운 쌀 포대는 둘이 함께 들어요.' },
  { q:'5kg보다 무거운 상자는 배달비가 더 들어요. 이 상자는 어떨까요?', v:{k:'dial', max:10, lab:1, tick:1, val:7, unit:'kg', item:'📦', body:'#ffedd5'}, o:['5kg보다 무거워요','5kg보다 가벼워요'], a:0,
    h:'바늘이 5보다 더 많이 돌아갔어요.', e:'7kg은 5kg보다 무거워서 배달비가 더 들어요.' },
  { q:'사과 1개의 무게에 알맞은 단위는 무엇일까요?', v:{k:'card', emo:'🍎', t:'사과 1개는 약 300'}, o:['g','kg'], a:0,
    h:'사과는 가벼워요. 가벼운 것은 g으로 재요.', e:'1kg은 1000g이에요. 사과 300kg이면 사과 상자 수십 개만큼 무거워요!' },
  { q:'수박 1통의 무게에 알맞은 단위는 무엇일까요?', v:{k:'card', emo:'🍉', t:'수박 1통은 약 6'}, o:['g','kg'], a:1,
    h:'수박은 무거워요. 무거운 것은 kg으로 재요.', e:'6g이면 사탕 몇 개 무게예요. 수박은 6kg쯤이에요.' }
]},
{ id:'ml', tier:1, icon:'☕', name:'mL 계량컵 읽기', job:'🧑‍🍳 바리스타', what:'우유와 물의 양', sc:{bg:'#fef9c3', main:'🧑‍🍳', tools:['☕','🥛','🧋','🍵']},
  intro:'바리스타는 우유와 물을 mL(밀리리터)로 재요. 늘 같은 양을 넣어야 언제 마셔도 맛이 똑같아요.',
  done:'계량컵을 읽을 수 있어요! 바리스타처럼 mL로 재요.',
  qs:[
  { q:'우유는 몇 mL일까요?', v:{k:'mcup', max:500, lab:100, tick:50, unit:'mL', cups:[{val:200, col:'#fde68a'}]}, o:['100mL','200mL','300mL'], a:1,
    h:'우유 윗면과 같은 높이의 숫자를 읽어요.', e:'라떼에는 우유를 정확하게 재서 넣어요.' },
  { q:'물은 몇 mL일까요?', v:{k:'mcup', max:500, lab:100, tick:50, unit:'mL', cups:[{val:350}]}, o:['300mL','350mL','400mL'], a:1,
    h:'300과 400 사이 가운데 눈금이에요.', x:'300 + 50 = ?', e:'아메리카노는 물의 양으로 맛이 진하거나 연해져요.' },
  { q:'커피는 몇 mL일까요?', v:{k:'mcup', max:500, lab:100, tick:50, unit:'mL', cups:[{val:150, col:'#c08443'}]}, o:['100mL','150mL','250mL'], a:1,
    h:'100과 200 사이 가운데 눈금이에요.', x:'100 + 50 = ?', e:'커피를 정해진 양만큼 담아요.' },
  { q:'라떼에 우유 300mL가 필요해요. 지금 200mL예요. 어떻게 할까요?', v:{k:'mcup', max:500, lab:100, tick:50, unit:'mL', target:300, cups:[{val:200, col:'#fde68a'}]}, o:['더 부어요','덜어 내요','딱 맞아요'], a:0,
    h:'우유가 빨간 점선까지 오지 않았어요.', e:'모자라면 빨간 선까지 더 부어요.' },
  { q:'더 많이 담긴 컵은 어느 것일까요?', v:{k:'mcup', max:300, lab:100, tick:50, unit:'mL', cups:[{val:150, lab:'가'},{val:250, lab:'나', ok:1}]}, o:['가','나'], a:1,
    h:'두 컵의 눈금 숫자를 읽고 비교해요.', e:'mL 숫자가 클수록 양이 많아요.' }
]},
{ id:'liter', tier:1, icon:'🐠', name:'L 읽기', job:'🧑‍🔬 수족관 사육사', what:'어항과 물통의 물', sc:{bg:'#cffafe', main:'🧑‍🔬', tools:['🐠','🐟','🐙','💧']},
  intro:'수족관 사육사는 어항의 물을 L(리터)로 재요. 많은 양은 L로, 적은 양은 mL로 재요. 1L는 1000mL예요.',
  done:'L를 읽을 수 있어요! 많은 양은 L, 적은 양은 mL예요.',
  qs:[
  { q:'어항의 물은 몇 L일까요?', v:{k:'mcup', w:320, max:5, lab:1, tick:1, unit:'L', deco:'🐠', cups:[{val:3, col:'#67e8f9'}]}, o:['2L','3L','4L'], a:1,
    h:'물 윗면과 같은 높이의 숫자를 읽어요.', e:'사육사는 물고기 수에 맞게 물의 양을 맞춰요.' },
  { q:'물통의 물은 몇 L일까요?', v:{k:'mcup', w:240, max:5, lab:1, tick:1, unit:'L', cups:[{val:4}]}, o:['3L','4L','5L'], a:1,
    h:'물 윗면 옆 숫자를 읽어요.', e:'큰 물통의 물은 L로 재요.' },
  { q:'1L는 몇 mL일까요?', v:{k:'card', emo:'🧃', t:'1L ='}, o:['10mL','100mL','1000mL'], a:2,
    h:'1L는 아주 많은 양이에요. 1 뒤에 0이 3개 붙어요.', e:'1L는 1000mL예요. 큰 우유갑 하나가 1L예요.' },
  { q:'우유 한 컵의 양에 알맞은 단위는 무엇일까요?', v:{k:'card', emo:'🥛', t:'우유 한 컵은 약 200'}, o:['mL','L'], a:0,
    h:'한 컵은 적은 양이에요. 적은 양은 mL로 재요.', e:'200L라면 욕조를 가득 채울 만큼이에요!' },
  { q:'욕조에 받은 물의 양에 알맞은 단위는 무엇일까요?', v:{k:'card', emo:'🛁', t:'욕조의 물은 약 200'}, o:['mL','L'], a:1,
    h:'욕조는 아주 커요. 많은 양은 L로 재요.', e:'욕조처럼 큰 그릇의 물은 L로 재요.' }
]},
{ id:'temp', tier:1, icon:'🌡️', name:'온도 재기', job:'🧑‍⚕️ 간호사', what:'몸과 날씨의 온도', sc:{bg:'#fee2e2', main:'🧑‍⚕️', tools:['🌡️','🤒','☀️','🔥']},
  intro:'간호사는 체온계로 몸의 온도를 재서 열이 나는지 알아봐요. 요리사는 오븐 온도를, 도예가는 가마 온도를 맞춰요. 온도는 ℃(도)로 읽어요.',
  done:'온도를 읽을 수 있어요! 체온 37.5도부터는 열이 있어요.',
  qs:[
  { q:'오늘 기온은 몇 도일까요?', v:{k:'thermo', min:0, max:40, lab:10, tick:1, val:25, item:'☀️'}, o:['20도','25도','30도'], a:1,
    h:'빨간 기둥 끝이 20과 30 사이 가운데에 있어요.', x:'20 + 5 = ?', e:'기온을 알면 어떤 옷을 입을지 정할 수 있어요.' },
  { q:'체온이 36.5도예요. 37.5도부터 열이에요. 열이 있나요?', v:{k:'digital', list:[{val:'36.5', unit:'℃', item:'🌡️', lab:'체온계'}]}, o:['열이 없어요','열이 있어요'], a:0,
    h:'36.5는 37.5보다 낮아요.', e:'36.5도쯤이 건강한 사람의 체온이에요.' },
  { q:'체온이 38.2도예요. 열이 있나요?', v:{k:'digital', list:[{val:'38.2', unit:'℃', item:'🤒', lab:'체온계'}]}, o:['열이 없어요','열이 있어요'], a:1,
    h:'38.2는 37.5보다 높아요.', e:'열이 나면 보건 선생님께 알리고 쉬어야 해요.' },
  { q:'추운 날 기온은 몇 도일까요?', v:{k:'thermo', min:0, max:40, lab:10, tick:1, val:5, item:'⛄'}, o:['5도','15도','25도'], a:0,
    h:'빨간 기둥이 아주 짧아요. 0과 10 사이 가운데예요.', x:'0 + 5 = ?', e:'추운 날에는 두꺼운 옷을 입어요.' },
  { q:'물이 펄펄 끓을 때 온도는 몇 도쯤일까요?', v:{k:'card', emo:'🍜', t:'라면 물이 펄펄 끓어요', blank:false}, o:['약 0도','약 36도','약 100도'], a:2,
    h:'아주 뜨거운 온도를 골라요.', e:'물은 약 100도에서 끓어요. 0도에서는 얼음이 돼요.' }
]},
// ---------------- 3부: 재고 계산해요 ----------------
{ id:'addL', tier:2, icon:'➕', name:'길이 더하기', job:'✂️ 재단사', what:'천 이어 붙이기', sc:{bg:'#fce7f3', main:'🧑‍🎨', tools:['👗','🧵','✂️','📏']},
  intro:'재단사는 천 두 장을 이어 붙여 옷을 만들어요. 이어 붙인 길이는 두 길이를 더해서 구해요.',
  done:'길이를 더할 수 있어요! 재단사처럼 천을 이어 붙여요.',
  qs:[
  { q:'40cm 천과 30cm 천을 이어 붙였어요. 모두 몇 cm일까요?', v:{k:'bars', max:80, rows:[{t:'천', segs:[{v:40,lab:'40cm',col:'#f9a8d4'},{v:30,lab:'30cm',col:'#c4b5fd'}], brace:'? cm'}]}, a:[70], u:['cm'],
    h:'두 길이를 더해요.', x:'40 + 30 = ?', e:'재단사는 천 길이를 더해서 옷 길이를 정해요.' },
  { q:'25cm 끈 2개를 이어서 허리끈을 만들어요. 모두 몇 cm일까요?', v:{k:'bars', max:60, rows:[{t:'허리끈', segs:[{v:25,lab:'25cm'},{v:25,lab:'25cm'}], brace:'? cm'}]}, a:[50], u:['cm'],
    h:'25와 25를 더해요. 20+20=40, 5+5=10이에요.', x:'25 + 25 = ?', e:'허리끈 길이가 맞아야 치마가 흘러내리지 않아요.' },
  { q:'커튼 천 60cm에 45cm를 이어 붙였어요. 모두 몇 cm일까요?', v:{k:'bars', max:110, rows:[{t:'커튼 천', segs:[{v:60,lab:'60cm'},{v:45,lab:'45cm'}], brace:'? cm'}]}, a:[105], u:['cm'],
    h:'60과 45를 더해요. 60+40=100, 거기에 5를 더해요.', x:'60 + 45 = ?', e:'긴 커튼은 천을 이어 붙여서 만들어요.' },
  { q:'10cm 리본 3개를 이었어요. 모두 몇 cm일까요?', v:{k:'bars', max:40, rows:[{t:'리본', segs:[{v:10,lab:'10cm'},{v:10,lab:'10cm'},{v:10,lab:'10cm'}], brace:'? cm'}]}, a:[30], u:['cm'],
    h:'10씩 세어 봐요. 10, 20, 30.', x:'10 + 10 + 10 = ?', e:'리본을 이어서 선물 포장을 해요.' },
  { q:'바지 길이 80cm에 10cm를 더 늘렸어요. 바지는 몇 cm가 될까요?', v:{k:'bars', max:100, rows:[{t:'바지', segs:[{v:80,lab:'80cm',col:'#93c5fd'},{v:10,lab:'10cm',col:'#fcd34d'}], brace:'? cm'}]}, a:[90], u:['cm'],
    h:'80에 10을 더해요.', x:'80 + 10 = ?', e:'키가 크면 옷 길이를 늘려서 고쳐 입어요.' }
]},
{ id:'subL', tier:2, icon:'➖', name:'길이 빼기', job:'🧑‍🔧 목수', what:'자르고 남은 나무', sc:{bg:'#fef3c7', main:'🧑‍🔧', tools:['🪚','🪵','🪑','📏']},
  intro:'목수는 긴 나무에서 필요한 만큼 잘라 써요. 남은 나무의 길이는 빼기로 구해요.',
  done:'길이를 뺄 수 있어요! 목수처럼 남은 길이를 계산해요.',
  qs:[
  { q:'100cm 나무에서 30cm를 잘랐어요. 남은 나무는 몇 cm일까요?', v:{k:'bars', max:100, rows:[{t:'나무', segs:[{v:30,lab:'30cm',cut:1},{v:70,lab:'?',q:1,col:'#d6a76c'}], brace:'100cm'}]}, a:[70], u:['cm'],
    h:'전체 100cm에서 자른 30cm를 빼요.', x:'100 − 30 = ?', e:'남은 나무로 다른 물건을 만들 수 있어요.' },
  { q:'90cm 나무에서 40cm를 잘랐어요. 남은 나무는 몇 cm일까요?', v:{k:'bars', max:90, rows:[{t:'나무', segs:[{v:40,lab:'40cm',cut:1},{v:50,lab:'?',q:1,col:'#d6a76c'}], brace:'90cm'}]}, a:[50], u:['cm'],
    h:'90에서 40을 빼요. 9−4를 생각해 봐요.', x:'90 − 40 = ?', e:'목수는 나무를 아껴 쓰려고 남은 길이를 계산해요.' },
  { q:'80cm 판자에서 25cm를 잘랐어요. 남은 판자는 몇 cm일까요?', v:{k:'bars', max:80, rows:[{t:'판자', segs:[{v:25,lab:'25cm',cut:1},{v:55,lab:'?',q:1,col:'#d6a76c'}], brace:'80cm'}]}, a:[55], u:['cm'],
    h:'80에서 20을 빼고, 5를 더 빼요.', x:'80 − 25 = ?', e:'선반 하나를 만들고 남은 판자로 작은 상자를 만들어요.' },
  { q:'120cm 나무에서 50cm를 잘랐어요. 남은 나무는 몇 cm일까요?', v:{k:'bars', max:120, rows:[{t:'나무', segs:[{v:50,lab:'50cm',cut:1},{v:70,lab:'?',q:1,col:'#d6a76c'}], brace:'120cm'}]}, a:[70], u:['cm'],
    h:'120에서 50을 빼요. 100에서 50을 빼면 50, 거기에 20을 더해요.', x:'120 − 50 = ?', e:'긴 나무는 잘라서 여러 곳에 나누어 써요.' },
  { q:'책상 다리를 70cm로 만들려고 해요. 85cm 나무에서 몇 cm를 잘라 내야 할까요?', v:{k:'bars', max:85, rows:[{t:'나무', segs:[{v:70,lab:'70cm',col:'#d6a76c'},{v:15,lab:'?',cut:1,q:1}], brace:'85cm'}]}, a:[15], u:['cm'],
    h:'85에서 70을 빼면 잘라 낼 길이가 나와요.', x:'85 − 70 = ?', e:'필요한 길이만 남기고 나머지를 잘라 내요.' }
]},
{ id:'mcm', tier:2, icon:'🪟', name:'m와 cm 바꾸기', job:'🧑‍💼 커튼 가게 사장님', what:'창문과 커튼의 길이', sc:{bg:'#e0e7ff', main:'🧑‍💼', tools:['🪟','📏','🧵','🏠']},
  intro:'커튼 가게에서는 창문 길이를 m와 cm로 재요. 1m는 100cm예요. 1m 20cm는 100cm와 20cm를 합한 120cm예요.',
  done:'m와 cm를 바꿀 수 있어요! 1m는 100cm예요.',
  qs:[
  { q:'1m 20cm는 몇 cm일까요?', v:{k:'bars', max:130, rows:[{t:'창문', segs:[{v:100,lab:'1m = 100cm'},{v:20,lab:'20cm'}], brace:'? cm'}]}, a:[120], u:['cm'],
    h:'1m는 100cm예요. 100에 20을 더해요.', x:'100 + 20 = ?', e:'커튼 가게에서는 cm로 바꿔서 천을 잘라요.' },
  { q:'2m는 몇 cm일까요?', v:{k:'bars', max:210, rows:[{t:'커튼', segs:[{v:100,lab:'1m'},{v:100,lab:'1m'}], brace:'? cm'}]}, a:[200], u:['cm'],
    h:'1m가 100cm니까 100을 두 번 더해요.', x:'100 + 100 = ?', e:'긴 커튼은 2m가 넘기도 해요.' },
  { q:'150cm는 몇 m 몇 cm일까요?', v:{k:'bars', max:160, rows:[{t:'커튼', segs:[{v:100,lab:'100cm'},{v:50,lab:'50cm'}], brace:'150cm'}]}, a:[1,50], u:['m','cm'],
    h:'100cm가 1m예요. 150cm는 100cm와 50cm예요.', x:'150cm = 100cm + 50cm', e:'150cm를 1m 50cm라고도 말해요.' },
  { q:'1m 5cm는 몇 cm일까요?', v:{k:'bars', max:120, rows:[{t:'창문', segs:[{v:100,lab:'1m = 100cm'},{v:5,lab:''}], brace:'? cm'}]}, a:[105], u:['cm'],
    h:'100에 5를 더해요. 150이 아니에요!', x:'100 + 5 = ?', e:'5cm는 아주 짧아요. 1m 5cm는 105cm예요.' },
  { q:'창문 길이는 1m 40cm예요. 커튼은 창문보다 20cm 더 길게 만들어요. 커튼은 몇 cm일까요?', v:{k:'bars', max:170, rows:[{t:'창문', segs:[{v:140,lab:'1m 40cm',col:'#bae6fd'}]},{t:'커튼', segs:[{v:140,lab:'140cm',col:'#f9a8d4'},{v:20,lab:'20cm',col:'#fcd34d'}], brace:'? cm'}]}, a:[160], u:['cm'],
    h:'1m 40cm는 140cm예요. 거기에 20cm를 더해요.', x:'140 + 20 = ?', e:'커튼을 창문보다 조금 길게 하면 빛이 새지 않아요.' }
]},
{ id:'wcalc', tier:2, icon:'📦', name:'무게 더하기·빼기', job:'🚚 택배 기사 · 🧑‍🍳 제빵사', what:'상자와 재료의 무게', sc:{bg:'#ffedd5', main:'🚚', tools:['📦','📚','🥣','🧈']},
  intro:'택배 기사님은 상자 무게를 더해서 한 번에 옮길 수 있는지 계산해요. 제빵사는 그릇 무게를 빼고 재료 무게만 구해요.',
  done:'무게를 더하고 뺄 수 있어요! 그릇 무게를 빼는 것도 잊지 마요.',
  qs:[
  { q:'1kg 상자에 3kg 책을 넣었어요. 모두 몇 kg일까요?', v:{k:'items', seq:[{e:'📦',l:'1kg'},{op:'+'},{e:'📚',l:'3kg'},{op:'='},{e:'📦',l:'? kg'}]}, a:[4], u:['kg'],
    h:'1과 3을 더해요.', x:'1 + 3 = ?', e:'택배 기사님은 전체 무게를 알고 상자를 옮겨요.' },
  { q:'그릇에 밀가루를 담았더니 500g이에요. 그릇만 재면 200g이에요. 밀가루만 몇 g일까요?', v:{k:'digital', list:[{val:'500', unit:'g', item:'🥣', lab:'그릇 + 밀가루'},{val:'200', unit:'g', item:'🥣', lab:'그릇만'}]}, a:[300], u:['g'],
    h:'전체 무게에서 그릇 무게를 빼요.', x:'500 − 200 = ?', e:'제빵사는 그릇 무게를 빼서 재료 무게만 알아내요.' },
  { q:'5kg 수박과 2kg 멜론을 한 봉지에 담았어요. 모두 몇 kg일까요?', v:{k:'items', seq:[{e:'🍉',l:'5kg'},{op:'+'},{e:'🍈',l:'2kg'},{op:'='},{e:'🛍️',l:'? kg'}]}, a:[7], u:['kg'],
    h:'5와 2를 더해요.', x:'5 + 2 = ?', e:'무거운 봉지는 두 개로 나누어 들어요.' },
  { q:'택배 상자는 10kg까지 보낼 수 있어요. 지금 6kg이에요. 몇 kg 더 넣을 수 있을까요?', v:{k:'bars', max:10, rows:[{t:'상자', segs:[{v:6,lab:'6kg',col:'#fdba74'},{v:4,lab:'?',q:1,empty:1}], brace:'10kg까지'}]}, a:[4], u:['kg'],
    h:'10에서 6을 빼요.', x:'10 − 6 = ?', e:'정해진 무게를 넘지 않게 담아야 택배를 보낼 수 있어요.' },
  { q:'설탕 300g과 버터 250g을 그릇에 넣었어요. 모두 몇 g일까요?', v:{k:'items', seq:[{e:'🍬',l:'300g'},{op:'+'},{e:'🧈',l:'250g'},{op:'='},{e:'🥣',l:'? g'}]}, a:[550], u:['g'],
    h:'300에 200을 더하고, 50을 더 더해요.', x:'300 + 250 = ?', e:'재료 무게를 더하면 반죽 무게를 알 수 있어요.' }
]},
{ id:'kgg', tier:2, icon:'🌾', name:'kg과 g 바꾸기', job:'🧑‍🌾 쌀가게 사장님', what:'쌀의 무게', sc:{bg:'#fef9c3', main:'🧑‍🌾', tools:['🌾','🍚','⚖️','🛍️']},
  intro:'쌀가게와 마트에서는 무게를 kg과 g으로 말해요. 1kg은 1000g이에요.',
  done:'kg과 g을 바꿀 수 있어요! 1kg은 1000g이에요.',
  qs:[
  { q:'1kg은 몇 g일까요?', v:{k:'items', seq:[{e:'🍚',l:'1kg'},{op:'='},{e:'⚖️',l:'? g'}]}, a:[1000], u:['g'],
    h:'1kg은 1 뒤에 0이 3개 붙어요.', x:'1kg = ?', e:'1kg은 1000g이에요. 큰 우유갑 하나쯤의 무게예요.' },
  { q:'2kg은 몇 g일까요?', v:{k:'bars', max:2100, rows:[{t:'쌀', segs:[{v:1000,lab:'1kg = 1000g'},{v:1000,lab:'1kg = 1000g'}], brace:'? g'}]}, a:[2000], u:['g'],
    h:'1000을 두 번 더해요.', x:'1000 + 1000 = ?', e:'쌀 2kg은 2000g이에요.' },
  { q:'쌀 1kg 500g은 몇 g일까요?', v:{k:'bars', max:1600, rows:[{t:'쌀', segs:[{v:1000,lab:'1kg = 1000g'},{v:500,lab:'500g'}], brace:'? g'}]}, a:[1500], u:['g'],
    h:'1kg은 1000g이에요. 1000에 500을 더해요.', x:'1000 + 500 = ?', e:'쌀가게는 g으로 바꿔서 봉지에 나누어 담아요.' },
  { q:'3000g은 몇 kg일까요?', v:{k:'bars', max:3100, rows:[{t:'쌀', segs:[{v:1000,lab:'1000g'},{v:1000,lab:'1000g'},{v:1000,lab:'1000g'}], brace:'3000g'}]}, a:[3], u:['kg'],
    h:'1000g이 1kg이에요. 1000g이 몇 개인지 세어 봐요.', x:'1000g이 3개 = ?', e:'3000g은 3kg이에요. kg으로 말하면 더 간단해요.' },
  { q:'쌀 1kg을 500g 봉지에 나누어 담아요. 몇 봉지가 될까요?', v:{k:'bars', max:1050, rows:[{t:'쌀', count:1, segs:[{v:500,lab:'500g'},{v:500,lab:'500g',hide:1}], brace:'1kg = 1000g'}]}, a:[2], u:['봉지'],
    h:'500과 500을 더하면 1000이에요.', x:'500g + 500g = 1000g → ?', e:'쌀가게는 큰 포대를 작은 봉지에 나누어 팔아요.' }
]},
{ id:'vcalc', tier:2, icon:'🍲', name:'들이 더하기·빼기', job:'🧑‍🍳 요리사', what:'물과 육수의 양', sc:{bg:'#e0f2fe', main:'🧑‍🍳', tools:['🍲','🥛','💧','🥄']},
  intro:'요리사는 국을 끓일 때 물과 육수의 양을 더하고 빼요. 1L는 1000mL예요.',
  done:'들이를 더하고 뺄 수 있어요! 1L는 1000mL예요.',
  qs:[
  { q:'물 500mL와 우유 300mL를 섞었어요. 모두 몇 mL일까요?', v:{k:'items', seq:[{e:'💧',l:'500mL'},{op:'+'},{e:'🥛',l:'300mL'},{op:'='},{e:'🍲',l:'? mL'}]}, a:[800], u:['mL'],
    h:'500과 300을 더해요. 5+3을 생각해요.', x:'500 + 300 = ?', e:'요리사는 재료의 양을 더해서 냄비 크기를 골라요.' },
  { q:'1L 우유에서 200mL를 따랐어요. 남은 우유는 몇 mL일까요?', v:{k:'bars', max:1000, rows:[{t:'우유', segs:[{v:200,lab:'200mL',cut:1},{v:800,lab:'?',q:1,col:'#fde68a'}], brace:'1L = 1000mL'}]}, a:[800], u:['mL'],
    h:'1L는 1000mL예요. 1000에서 200을 빼요.', x:'1000 − 200 = ?', e:'남은 양을 알면 장을 볼 때 무엇이 필요한지 알 수 있어요.' },
  { q:'육수 1L에 물 500mL를 더 넣었어요. 모두 몇 mL일까요?', v:{k:'bars', max:1600, rows:[{t:'국물', segs:[{v:1000,lab:'1L = 1000mL'},{v:500,lab:'500mL'}], brace:'? mL'}]}, a:[1500], u:['mL'],
    h:'1000에 500을 더해요.', x:'1000 + 500 = ?', e:'국물이 짜면 물을 더 넣어 맛을 맞춰요.' },
  { q:'국을 끓이려면 물 900mL가 필요해요. 지금 600mL를 넣었어요. 몇 mL 더 넣어야 할까요?', v:{k:'mcup', max:1000, lab:100, tick:100, unit:'mL', target:900, nohint:1, cups:[{val:600}]}, a:[300], u:['mL'],
    h:'900에서 600을 빼요. 빨간 점선까지 몇 칸이 남았는지 세어도 돼요.', x:'900 − 600 = ?', e:'정해진 양을 맞춰야 국 맛이 늘 똑같아요.' },
  { q:'물 2L에서 500mL를 썼어요. 남은 물은 몇 mL일까요?', v:{k:'bars', max:2000, rows:[{t:'물', segs:[{v:500,lab:'500mL',cut:1},{v:1500,lab:'?',q:1}], brace:'2L = 2000mL'}]}, a:[1500], u:['mL'],
    h:'2L는 2000mL예요. 2000에서 500을 빼요.', x:'2000 − 500 = ?', e:'요리사는 남은 물로 다음 요리를 준비해요.' }
]},
{ id:'mul', tier:2, icon:'✖️', name:'곱하기로 재기', job:'🧑‍🔧 목수 · 🧑‍🍳 제빵사', what:'똑같은 것 여러 개', sc:{bg:'#dcfce7', main:'🧑‍🍳', tools:['🎂','🪑','🎁','📦']},
  intro:'똑같은 것을 여러 개 만들 때는 곱하기를 써요. 목수는 의자 다리 4개를, 제빵사는 케이크 여러 개를 만들어요.',
  done:'곱하기로 계산할 수 있어요! 같은 수를 여러 번 더하는 것과 같아요.',
  qs:[
  { q:'의자 다리 1개는 40cm예요. 다리 4개를 만들려면 나무가 몇 cm 필요할까요?', v:{k:'bars', max:170, rows:[{t:'다리 4개', count:1, segs:[{v:40,lab:'40cm',col:'#d6a76c'},{v:40,lab:'40cm',col:'#c08443'},{v:40,lab:'40cm',col:'#d6a76c'},{v:40,lab:'40cm',col:'#c08443'}], brace:'? cm'}]}, a:[160], u:['cm'],
    h:'40을 4번 더해요. 40, 80, 120, 160.', x:'40 × 4 = ?', e:'목수는 필요한 나무 길이를 미리 계산해서 사요.' },
  { q:'케이크 1개에 밀가루 200g이 들어가요. 케이크 2개를 만들려면 몇 g이 필요할까요?', v:{k:'items', seq:[{e:'🎂',l:'200g'},{op:'+'},{e:'🎂',l:'200g'},{op:'='},{e:'🌾',l:'? g'}]}, a:[400], u:['g'],
    h:'200을 2번 더해요.', x:'200 × 2 = ?', e:'제빵사는 만들 개수만큼 재료를 곱해서 준비해요.' },
  { q:'컵 3개에 우유를 200mL씩 담아요. 우유가 모두 몇 mL 필요할까요?', v:{k:'mcup', max:300, lab:100, tick:50, unit:'mL', nohint:1, nodone:1, cups:[{val:200, col:'#fde68a', lab:'200mL'},{val:200, col:'#fde68a', lab:'200mL'},{val:200, col:'#fde68a', lab:'200mL'}]}, a:[600], u:['mL'],
    h:'200을 3번 더해요. 200, 400, 600.', x:'200 × 3 = ?', e:'바리스타는 손님 수만큼 우유를 준비해요.' },
  { q:'2kg 상자가 5개 있어요. 모두 몇 kg일까요?', v:{k:'bars', max:11, rows:[{t:'상자 5개', count:1, segs:[{v:2,lab:'2kg'},{v:2,lab:'2kg'},{v:2,lab:'2kg'},{v:2,lab:'2kg'},{v:2,lab:'2kg'}], brace:'? kg'}]}, a:[10], u:['kg'],
    h:'2씩 5번 세어 봐요. 2, 4, 6, 8, 10.', x:'2 × 5 = ?', e:'택배 기사님은 상자 수와 무게로 전체 무게를 알아요.' },
  { q:'선물 6개에 리본을 30cm씩 묶어요. 리본이 모두 몇 cm 필요할까요?', v:{k:'bars', max:190, rows:[{t:'리본', count:1, segs:[{v:30,lab:'30'},{v:30,lab:'30'},{v:30,lab:'30'},{v:30,lab:'30'},{v:30,lab:'30'},{v:30,lab:'30'}], brace:'? cm'}]}, a:[180], u:['cm'],
    h:'30을 6번 더해요. 30, 60, 90, 120, 150, 180.', x:'30 × 6 = ?', e:'포장하는 사람은 리본이 모자라지 않게 미리 계산해요.' }
]},
{ id:'div', tier:2, icon:'➗', name:'나누기로 재기', job:'🧑‍🎨 도예가 · 바리스타', what:'똑같이 나누기', sc:{bg:'#ede9fe', main:'🧑‍🎨', tools:['🏺','🥛','🎀','🌾']},
  intro:'많은 양을 똑같이 나눌 때는 나누기를 써요. 바리스타는 우유를 여러 컵에, 도예가는 점토를 여러 덩이로 나눠요.',
