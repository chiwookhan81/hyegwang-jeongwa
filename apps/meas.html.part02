  { q:'귤은 바둑돌 몇 개와 무게가 같을까요?', v:{k:'balance', bals:[{L:['🍊'], R:['s4'], t:'='}]}, o:['3개','4개','5개'], a:1,
    h:'바둑돌을 하나씩 짚으며 세어 봐요.', e:'귤은 사과보다 가벼워서 바둑돌이 더 적어요.' },
  { q:'감자는 바둑돌 8개, 양파는 바둑돌 5개와 무게가 같아요. 더 무거운 것은 무엇일까요?', v:{k:'balance', bals:[{L:['🥔'], R:['s8'], t:'='},{L:['🧅'], R:['s5'], t:'='}]}, o:['🥔 감자','🧅 양파'], a:0,
    h:'바둑돌이 많을수록 더 무거워요.', e:'바둑돌 수를 비교하면 어느 것이 더 무거운지 알 수 있어요.' },
  { q:'감자는 양파보다 바둑돌 몇 개만큼 더 무거울까요?', v:{k:'balance', bals:[{L:['🥔'], R:['s8'], t:'='},{L:['🧅'], R:['s5'], t:'='}]}, o:['2개','3개','4개'], a:1,
    h:'8개와 5개의 차이를 세어 봐요.', x:'8개 − 5개 = ?', e:'무게의 차이도 바둑돌로 알 수 있어요.' },
  { q:'배 쪽으로 저울이 내려갔어요. 배는 바둑돌 5개보다 어떨까요?', v:{k:'balance', bals:[{L:['🍐'], R:['s5'], t:'L'}]}, o:['더 무거워요','더 가벼워요','같아요'], a:0,
    h:'내려간 쪽이 더 무거워요.', e:'저울이 기울면 두 쪽의 무게가 다르다는 뜻이에요.' }
]},
{ id:'why', tier:0, icon:'🤔', name:'왜 단위가 필요할까?', job:'🧑‍💼 가구점 직원', what:'누구나 똑같은 길이', sc:{bg:'#e0e7ff', main:'🧑‍💼', tools:['📏','🪑','🛋️','✋']},
  intro:'가구점에 책상을 주문할 때 "5뼘짜리 주세요" 하면 어떻게 될까요? 사람마다 손 크기가 달라서 길이가 달라져요. 그래서 모두가 똑같이 쓰는 단위가 필요해요.',
  done:'단위가 왜 필요한지 알았어요! 이제 2부에서 cm, kg, mL를 배워요.',
  qs:[
  { q:'같은 책상을 아빠 뼘과 월이 뼘으로 쟀어요. 누구 뼘으로 잰 수가 더 많을까요?', v:{k:'units', objs:[{shape:'table', n:4, u:130, x:170, y:120, unit:'span', lab:'아빠'},{shape:'table', n:5, u:104, x:170, y:290, unit:'span', lab:'월이', small:1}]}, o:['아빠','월이'], a:1,
    h:'두 줄의 손 모양 수를 각각 세어 봐요.', e:'월이 손이 작아서 더 많이 재야 해요. 같은 책상인데 수가 달라졌어요!' },
  { q:'같은 물을 큰 컵으로 2컵, 작은 컵으로 4컵 담았어요. 어느 컵이 더 클까요?', v:{k:'cups', groups:[{lab:'가 컵', n:2, big:1, from:'🍶'},{lab:'나 컵', n:4, from:'🍶'}]}, o:['2컵이 나온 가 컵','4컵이 나온 나 컵'], a:0,
    h:'컵이 클수록 적은 수로도 다 담을 수 있어요.', e:'컵 크기가 다르면 같은 물이라도 컵 수가 달라져요.' },
  { q:'"5뼘짜리 책상 주세요" 하고 주문하면 어떻게 될까요?', v:{k:'card', emo:'🛒', t:'"5뼘짜리 책상 주세요!"', blank:false}, o:['사람마다 손이 달라서 크기가 달라져요','언제나 똑같은 책상이 와요'], a:0,
    h:'아빠 뼘과 월이 뼘으로 잰 수가 달랐던 것을 생각해요.', e:'그래서 가게에서는 누구나 똑같이 쓰는 cm로 주문해요.' },
  { q:'누구나 똑같은 길이로 재려면 무엇을 쓸까요?', v:{k:'card', emo:'📏', t:'길이를 똑같이 재요', blank:false}, o:['자 (cm, m)','내 손 뼘','내 발걸음'], a:0,
    h:'사람마다 달라지지 않는 도구를 찾아요.', e:'자는 누가 써도 1cm가 똑같아요.' },
  { q:'누구나 똑같은 무게로 재려면 무엇을 쓸까요?', v:{k:'card', emo:'⚖️', t:'무게를 똑같이 재요', blank:false}, o:['손으로 들어 보기','저울 (g, kg)','바둑돌'], a:1,
    h:'눈금이 있어서 누가 재도 같은 도구를 찾아요.', e:'저울은 누가 재도 같은 무게가 나와요.' },
  { q:'누구나 똑같은 양으로 재려면 무엇을 쓸까요?', v:{k:'card', emo:'🥛', t:'물의 양을 똑같이 재요', blank:false}, o:['아무 컵','계량컵 (mL, L)','손바닥'], a:1,
    h:'눈금이 그려진 컵을 찾아요.', e:'계량컵에는 눈금이 있어서 늘 같은 양을 잴 수 있어요.' }
]},
// ---------------- 2부: 단위로 재요 ----------------
{ id:'cm', tier:1, icon:'📏', name:'자로 cm 재기', job:'✂️ 재단사', what:'리본과 실의 길이', sc:{bg:'#fce7f3', main:'🧑‍🎨', tools:['✂️','🧵','🎀','📏']},
  intro:'재단사는 옷을 만드는 사람이에요. 자로 천과 리본의 길이를 cm로 재요. 물건 끝을 자의 0에 맞추고, 다른 끝의 눈금을 읽어요.',
  done:'자로 cm를 잴 수 있어요! 재단사처럼 0에 맞추고 읽어요.',
  qs:[
  { q:'리본의 길이는 몇 cm일까요?', v:{k:'ruler', max:15, s:0, L:8, obj:'ribbon'}, o:['7cm','8cm','9cm'], a:1,
    h:'리본 끝이 0에 맞춰져 있어요. 오른쪽 끝에 있는 숫자를 읽어요.', e:'재단사는 리본을 cm로 재서 옷에 딱 맞게 달아요.' },
  { q:'연필의 길이는 몇 cm일까요?', v:{k:'ruler', max:15, s:0, L:12, obj:'pencil'}, o:['10cm','12cm','13cm'], a:1,
    h:'연필 뾰족한 끝이 가리키는 숫자를 읽어요.', e:'재단사는 연필로 천에 자를 곳을 표시해요.' },
  { q:'지우개의 길이는 몇 cm일까요?', v:{k:'ruler', max:15, s:0, L:4, obj:'eraser'}, o:['3cm','4cm','5cm'], a:1,
    h:'지우개 오른쪽 끝 아래 숫자를 읽어요.', e:'작은 물건도 자로 정확하게 잴 수 있어요.' },
  { q:'실의 길이는 몇 cm일까요?', v:{k:'ruler', max:15, s:0, L:10, obj:'thread'}, o:['9cm','10cm','11cm'], a:1,
    h:'실 끝에서 내려온 점선이 가리키는 숫자를 읽어요.', e:'옷을 꿰맬 때 실을 알맞은 길이로 잘라요.' },
  { q:'단추를 꿴 줄의 길이는 몇 cm일까요?', v:{k:'ruler', max:15, s:0, L:6, obj:'button'}, o:['5cm','6cm','7cm'], a:1,
    h:'줄의 오른쪽 끝 점선을 따라 내려가 숫자를 읽어요.', e:'단추 사이 길이를 재서 옷에 고르게 달아요.' }
]},
{ id:'cm2', tier:1, icon:'🪵', name:'중간부터 재기', job:'🧑‍🔧 목수', what:'나무 막대와 못', sc:{bg:'#fef3c7', main:'🧑‍🔧', tools:['🪵','🔨','📏','🪚']},
  intro:'목수의 자는 끝이 닳아 있기도 해요. 그럴 때는 중간 눈금부터 재요. 1cm 칸이 몇 개인지 세면 길이를 알 수 있어요.',
  done:'중간부터 재도 길이를 알 수 있어요! 1cm 칸을 세면 돼요.',
  qs:[
  { q:'나무 막대의 길이는 몇 cm일까요?', v:{k:'ruler', max:15, s:2, L:5, obj:'stick'}, o:['2cm','5cm','7cm'], a:1,
    h:'막대가 2에서 시작해서 7에서 끝나요. 1cm 칸을 세어 봐요.', x:'7 − 2 = ?', e:'목수는 끝 눈금에서 시작 눈금을 빼서 길이를 구해요.' },
  { q:'못의 길이는 몇 cm일까요?', v:{k:'ruler', max:15, s:1, L:3, obj:'nail'}, o:['1cm','3cm','4cm'], a:1,
    h:'못이 1에서 시작해요. 4까지 1cm 칸이 몇 개인지 세어요.', x:'4 − 1 = ?', e:'못 길이가 알맞아야 나무를 튼튼하게 붙일 수 있어요.' },
  { q:'나무 조각의 길이는 몇 cm일까요?', v:{k:'ruler', max:15, s:3, L:8, obj:'stick'}, o:['3cm','8cm','11cm'], a:1,
    h:'3에서 시작해서 11에서 끝나요. 칸을 세어 봐요.', x:'11 − 3 = ?', e:'짧은 나무 조각도 길이를 재서 버리지 않고 써요.' },
  { q:'의자 다리 모형의 길이는 몇 cm일까요?', v:{k:'ruler', max:15, s:5, L:9, obj:'stick', col:'#a16207'}, o:['5cm','9cm','14cm'], a:1,
    h:'5에서 시작해서 14에서 끝나요.', x:'14 − 5 = ?', e:'의자 다리 4개의 길이가 똑같아야 의자가 흔들리지 않아요.' },
  { q:'연필의 길이는 몇 cm일까요?', v:{k:'ruler', max:15, s:4, L:6, obj:'pencil'}, o:['4cm','6cm','10cm'], a:1,
    h:'연필이 4에서 시작해요. 10까지 칸을 세어 봐요.', x:'10 − 4 = ?', e:'시작이 0이 아니어도 칸을 세면 길이를 알 수 있어요.' }
]},
{ id:'unit', tier:1, icon:'🏗️', name:'cm와 m 고르기', job:'👷 건축가', what:'집과 방의 크기', sc:{bg:'#e0f2fe', main:'👷', tools:['🏠','🚪','📐','🧱']},
  intro:'집을 짓는 사람은 긴 것은 m(미터)로, 짧은 것은 cm(센티미터)로 재요. 1m는 100cm예요.',
  done:'cm와 m를 골라 쓸 수 있어요! 긴 것은 m, 짧은 것은 cm예요.',
  qs:[
  { q:'1m는 몇 cm일까요?', v:{k:'meter'}, o:['10cm','100cm','1000cm'], a:1,
    h:'1m 막대에 10cm 칸이 10개 있어요. 10씩 세어 봐요.', x:'10cm가 10개 = ?', e:'1m는 100cm예요. 건축가는 긴 길이를 m로 말해요.' },
  { q:'연필 길이에 알맞은 단위는 무엇일까요?', v:{k:'card', emo:'✏️', t:'연필의 길이는 약 15'}, o:['cm','m'], a:0,
    h:'연필은 짧아요. 짧은 것은 cm로 재요.', e:'손에 쥐는 작은 물건은 cm로 재요.' },
  { q:'교실 긴 쪽의 길이에 알맞은 단위는 무엇일까요?', v:{k:'card', emo:'🏫', t:'교실의 길이는 약 9'}, o:['cm','m'], a:1,
    h:'교실은 아주 길어요. 긴 것은 m로 재요.', e:'건축가는 방의 크기를 m로 재서 설계도를 그려요.' },
  { q:'문 높이에 알맞은 단위는 무엇일까요?', v:{k:'card', emo:'🚪', t:'문의 높이는 약 2'}, o:['cm','m'], a:1,
    h:'문은 사람보다 커요. 2cm라면 손가락보다 짧아요!', e:'문 높이는 약 2m예요. 200cm라고도 말해요.' },
  { q:'휴대폰 길이에 알맞은 단위는 무엇일까요?', v:{k:'card', emo:'📱', t:'휴대폰의 길이는 약 15'}, o:['cm','m'], a:0,
    h:'휴대폰은 손에 쥘 만큼 짧아요.', e:'15m라면 버스보다 긴 휴대폰이 돼요!' },
  { q:'1m보다 긴 것은 무엇일까요?', v:{k:'card', emo:'📏', t:'1m = 100cm', blank:false}, o:['🚌 버스','🧽 지우개','🥄 숟가락'], a:0,
    h:'1m는 어른 한 걸음보다 조금 길어요. 1m보다 긴 것을 찾아요.', e:'버스는 길이가 약 11m예요.' }
]},
{ id:'body', tier:1, icon:'🩺', name:'키와 몸무게', job:'🧑‍⚕️ 보건 선생님', what:'키와 몸무게', sc:{bg:'#dcfce7', main:'🧑‍⚕️', tools:['🩺','📏','⚖️','💊']},
  intro:'보건 선생님과 간호사는 키와 몸무게를 재서 우리가 건강하게 자라는지 살펴봐요. 키는 cm, 몸무게는 kg으로 재요.',
  done:'키와 몸무게를 읽을 수 있어요! 큰 숫자를 찾고 작은 눈금을 세어요.',
  qs:[
  { q:'월이의 키는 몇 cm일까요?', v:{k:'vscale', min:120, max:145, marks:[{val:132, ch:'wol'}]}, o:['122cm','132cm','142cm'], a:1,
    h:'빨간 선 아래쪽 큰 숫자 130을 찾고, 작은 눈금을 더 세어 봐요.', x:'130 + 2 = ?', e:'보건 선생님은 키를 재서 건강 기록에 적어요.' },
  { q:'대롱이의 키는 몇 cm일까요?', v:{k:'vscale', min:110, max:135, marks:[{val:125, ch:'hami'}]}, o:['115cm','120cm','125cm'], a:2,
    h:'120과 130 사이 가운데 긴 눈금이 125예요.', x:'120 + 5 = ?', e:'키가 자라면 책상과 의자 높이도 맞춰 바꿔요.' },
  { q:'아리의 몸무게는 몇 kg일까요?', v:{k:'dial', max:60, lab:10, tick:1, val:34, unit:'kg', ch:'ari', body:'#dcfce7'}, o:['24kg','34kg','36kg'], a:1,
    h:'바늘이 30을 조금 지났어요. 30에서 작은 눈금을 세어요.', x:'30 + 4 = ?', e:'몸무게를 재면 건강하게 자라는지 알 수 있어요.' },
  { q:'월이의 몸무게는 몇 kg일까요?', v:{k:'dial', max:60, lab:10, tick:1, val:28, unit:'kg', ch:'wol', body:'#dcfce7'}, o:['22kg','28kg','32kg'], a:1,
    h:'바늘이 30보다 조금 덜 갔어요. 20에서 작은 눈금을 세어 봐요.', x:'20 + 8 = ?', e:'보건실 체중계는 kg으로 몸무게를 알려 줘요.' },
  { q:'지난봄 월이 키는 128cm였어요. 지금은 132cm예요. 몇 cm 컸을까요?', v:{k:'vscale', min:120, max:140, cnt:[128,132], marks:[{val:132, ch:'wol'},{val:128, lab:'지난봄'}]}, o:['2cm','4cm','6cm'], a:1,
    h:'파란 점선과 빨간 선 사이의 작은 눈금 칸을 세어 봐요.', x:'132 − 128 = ?', e:'키를 재서 비교하면 얼마나 자랐는지 알 수 있어요.' }
]},
{ id:'gram', tier:1, icon:'🍞', name:'g 저울 읽기', job:'🧑‍🍳 제빵사', what:'밀가루와 설탕의 무게', sc:{bg:'#fef3c7', main:'🧑‍🍳', tools:['🍞','🥐','🧈','⚖️']},
  intro:'제빵사는 밀가루와 설탕을 g(그램)으로 재요. 조금만 달라져도 빵 맛이 달라지기 때문에 저울을 꼭 써요.',
  done:'g 저울을 읽을 수 있어요! 제빵사처럼 재료를 정확하게 재요.',
  qs:[
