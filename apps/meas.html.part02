    h:'왼쪽부터 손 모양을 하나씩 짚으며 세어 봐요.', e:'판자 길이를 알면 무엇을 만들 수 있을지 정할 수 있어요.' },
  { q:'의자의 높이는 몇 뼘일까요?', v:{k:'units', objs:[{shape:'chair', dir:'v', n:3, u:90, x:380, y:360, w:150, unit:'span', lab:'의자'}]}, o:['2뼘','3뼘','4뼘'], a:1,
    h:'바닥부터 위로 손 모양을 세어 봐요.', e:'의자 높이가 알맞아야 편하게 앉을 수 있어요.' },
  { q:'책상은 선반보다 몇 뼘 더 길까요?', v:{k:'units', objs:[{shape:'table', n:5, u:100, x:180, y:110, unit:'span', lab:'책상'},{shape:'plank', n:3, u:100, x:180, y:310, unit:'span', lab:'선반'}]}, o:['1뼘','2뼘','3뼘'], a:1,
    h:'책상은 몇 뼘, 선반은 몇 뼘인지 따로 세고 비교해요.', x:'5뼘 − 3뼘 = ?', e:'목수는 두 나무의 길이를 비교해서 얼마나 더 필요한지 알아내요.' },
  { q:'책장의 너비는 4뼘하고 조금 더 남아요. 약 몇 뼘이라고 할까요?', v:{k:'units', objs:[{shape:'plank', n:4.3, u:130, x:150, y:230, unit:'span', lab:'책장', col:'#c08443'}]}, o:['약 2뼘','약 4뼘','약 6뼘'], a:1,
    h:'손 모양이 4개 있고 아주 조금 남았어요.', e:'딱 맞지 않을 때는 "약 몇 뼘"이라고 어림해요. 목수도 처음에는 어림해서 재요.' }
]},
{ id:'step', tier:0, icon:'👣', name:'걸음으로 재기', job:'🧑‍🌾 농부', what:'밭의 길이', sc:{bg:'#dcfce7', main:'🧑‍🌾', tools:['🌱','🥬','🚜','🌻']},
  intro:'농부는 밭에 씨앗을 심기 전에 밭의 길이를 걸음으로 재요. 한 걸음, 두 걸음 세며 걸어요.',
  done:'걸음으로 길이를 잴 수 있어요! 농부처럼 걸으며 세어 봐요.',
  qs:[
  { q:'배추밭의 길이는 몇 걸음일까요?', v:{k:'units', objs:[{shape:'field', n:6, u:105, x:115, y:150, unit:'step', lab:'배추밭', deco:'🥬'}]}, o:['5걸음','6걸음','7걸음'], a:1,
    h:'발자국 하나가 한 걸음이에요. 하나씩 세어 봐요.', e:'밭 길이를 알면 씨앗을 몇 줄 심을지 정할 수 있어요.' },
  { q:'꽃밭의 길이는 몇 걸음일까요?', v:{k:'units', objs:[{shape:'field', n:4, u:110, x:210, y:150, unit:'step', lab:'꽃밭', deco:'🌷', col:'#fbcfe8'}]}, o:['3걸음','4걸음','8걸음'], a:1,
    h:'발자국을 왼쪽부터 손가락으로 짚으며 세어 봐요.', e:'정원사도 걸음으로 꽃밭 크기를 어림해요.' },
  { q:'두 밭 중 어느 밭이 더 길까요?', v:{k:'units', objs:[{shape:'field', n:7, u:95, x:110, y:60, unit:'step', lab:'가 밭', th:76},{shape:'field', n:5, u:95, x:110, y:250, unit:'step', lab:'나 밭', th:76, col:'#fde68a'}]}, o:['가 밭','나 밭'], a:0,
    h:'두 밭의 걸음 수를 각각 세어 비교해요. 걸음 수가 많으면 더 길어요.', e:'같은 사람이 걸었으니까 걸음 수가 많은 밭이 더 길어요.' },
  { q:'고구마밭은 몇 걸음일까요?', v:{k:'units', objs:[{shape:'field', n:8, u:85, x:90, y:150, unit:'step', lab:'고구마밭', deco:'🍠', col:'#d9f99d'}]}, o:['6걸음','7걸음','8걸음'], a:2,
    h:'발자국이 많아요. 다섯까지 센 다음 이어서 세어 봐요.', e:'밭이 길면 걸음 수도 많아져요.' },
  { q:'울타리는 5걸음하고 조금 더 남아요. 약 몇 걸음일까요?', v:{k:'units', objs:[{shape:'fence', n:5.3, u:120, x:100, y:150, unit:'step', lab:'울타리'}]}, o:['약 3걸음','약 5걸음','약 7걸음'], a:1,
    h:'발자국 5개에 아주 조금 남았어요.', e:'딱 맞지 않을 때는 "약 몇 걸음"이라고 말해요.' }
]},
{ id:'block', tier:0, icon:'🧱', name:'블록·클립으로 재기', job:'🧑‍🎨 도예가', what:'그릇과 꽃병의 크기', sc:{bg:'#ffedd5', main:'🧑‍🎨', tools:['🏺','🍶','🥣','🔥']},
  intro:'도예가는 흙으로 그릇과 꽃병을 만들어요. 여러 개를 비슷한 크기로 만들려고 높이와 길이를 재요. 블록이나 클립을 이어서 재 볼까요?',
  done:'블록과 클립으로 잴 수 있어요! 도예가처럼 크기를 맞춰 만들어 봐요.',
  qs:[
  { q:'꽃병의 높이는 블록 몇 개일까요?', v:{k:'units', objs:[{shape:'vase', dir:'v', n:5, u:60, x:360, y:355, w:150, unit:'block', lab:'꽃병', col:'#93c5fd'}]}, o:['4개','5개','6개'], a:1,
    h:'아래부터 블록을 하나씩 세어 봐요.', e:'도예가는 꽃병 높이를 재서 같은 크기로 여러 개를 만들어요.' },
  { q:'컵의 높이는 블록 몇 개일까요?', v:{k:'units', objs:[{shape:'cup', dir:'v', n:3, u:70, x:360, y:355, w:170, unit:'block', lab:'컵', col:'#fca5a5'}]}, o:['2개','3개','4개'], a:1,
    h:'블록이 컵 꼭대기까지 몇 개 쌓였는지 세어요.', e:'컵 높이가 같아야 세트로 팔 수 있어요.' },
  { q:'붓의 길이는 클립 몇 개일까요?', v:{k:'units', objs:[{shape:'brush', n:4, u:110, x:210, y:150, unit:'clip', lab:'붓'}]}, o:['3개','4개','5개'], a:1,
    h:'붓 아래에 있는 클립을 하나씩 세어 봐요.', e:'도예가는 붓으로 그릇에 그림을 그려요.' },
  { q:'항아리는 꽃병보다 블록 몇 개 더 높을까요?', v:{k:'units', objs:[{shape:'vase', dir:'v', n:4, u:52, x:200, y:350, w:130, unit:'block', lab:'꽃병', col:'#93c5fd'},{shape:'jar', dir:'v', n:6, u:52, x:560, y:350, w:180, unit:'block', lab:'항아리', col:'#d6a76c'}]}, o:['1개','2개','3개'], a:1,
    h:'꽃병 블록과 항아리 블록을 각각 세고 몇 개 차이인지 봐요.', x:'6개 − 4개 = ?', e:'높이를 비교하면 어느 쪽을 더 크게 만들었는지 알 수 있어요.' },
  { q:'접시의 길이는 클립 몇 개일까요?', v:{k:'units', objs:[{shape:'plate', n:6, u:95, x:145, y:150, unit:'clip', lab:'접시'}]}, o:['5개','6개','7개'], a:1,
    h:'클립을 왼쪽부터 세어 봐요.', e:'접시 크기를 재면 그릇장에 들어갈지 알 수 있어요.' }
]},
{ id:'cup', tier:0, icon:'🥛', name:'컵으로 재기', job:'🧑‍🍳 요리사', what:'쌀과 물의 양', sc:{bg:'#e0f2fe', main:'🧑‍🍳', tools:['🍚','🍲','🥛','🥄']},
  intro:'요리사는 밥을 지을 때 쌀과 물을 컵으로 재요. 컵 수가 알맞아야 밥이 맛있게 돼요.',
  done:'컵으로 양을 잴 수 있어요! 요리사처럼 컵 수를 세어 봐요.',
  qs:[
  { q:'냄비에 물을 몇 컵 부었을까요?', v:{k:'cups', groups:[{lab:'물', n:3, target:'🍲'}]}, o:['2컵','3컵','4컵'], a:1,
    h:'컵을 하나씩 세어 봐요.', e:'물을 컵으로 재면 매번 같은 맛을 낼 수 있어요.' },
  { q:'밥솥에 쌀을 몇 컵 넣었을까요?', v:{k:'cups', groups:[{lab:'쌀', n:2, rice:1, target:'🍚'}]}, o:['1컵','2컵','3컵'], a:1,
    h:'쌀이 담긴 컵을 세어요.', e:'먹을 사람 수에 맞게 쌀 컵 수를 정해요.' },
  { q:'물은 쌀보다 1컵 더 넣어요. 물은 몇 컵 넣을까요?', v:{k:'cups', groups:[{lab:'쌀', n:2, rice:1},{lab:'물', n:2, ghost:1, target:'🍚'}]}, o:['2컵','3컵','4컵'], a:1,
    h:'쌀 2컵에 1컵을 더해요.', x:'2컵 + 1컵 = ?', e:'쌀과 물의 양을 맞추면 밥이 질지도 되지도 않아요.' },
  { q:'물이 더 많이 들어간 냄비는 어느 것일까요?', v:{k:'cups', groups:[{lab:'가', n:4, target:'🍲'},{lab:'나', n:6, target:'🍲'}]}, o:['가 냄비','나 냄비'], a:1,
    h:'두 냄비에 부은 컵 수를 세어 비교해요.', e:'같은 컵으로 부었으니 컵 수가 많은 쪽에 물이 더 많아요.' },
  { q:'큰 냄비를 채우려면 5컵이 필요해요. 3컵 부었어요. 몇 컵 더 부어야 할까요?', v:{k:'cups', groups:[{lab:'큰 냄비', n:3, ghost:2, target:'🍲'}]}, o:['1컵','2컵','3컵'], a:1,
    h:'점선 컵이 더 부어야 할 컵이에요. 점선 컵을 세어 봐요.', x:'5컵 − 3컵 = ?', e:'얼마나 더 필요한지 알면 넘치지 않게 부을 수 있어요.' }
]},
{ id:'vol', tier:0, icon:'🥤', name:'들이 비교하기', job:'🧑‍🍳 카페 바리스타', what:'컵에 담기는 양', sc:{bg:'#fef9c3', main:'🧑‍🍳', tools:['☕','🥤','🧋','🥛']},
  intro:'카페 바리스타는 컵 크기에 맞게 음료를 담아요. 어느 컵에 물이 더 많이 들어가는지 비교해 봐요.',
  done:'들이를 비교할 수 있어요! 바리스타처럼 컵 크기를 생각해요.',
  qs:[
