<!DOCTYPE html>
<html lang="ko">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<head><script>/* 1.2.0 앱을 내리면(최소화) 소리를 멈춰요: 읽어 주기·녹음 목소리·효과음·반복 음악. 돌아오면 반복 음악만 다시 나와요 */(function(){if(window.__hubHide)return;window.__hubHide=1;var A=[];try{['AudioContext','webkitAudioContext'].forEach(function(n){var C=window[n];if(!C||C.__hubW)return;var W=function(a){var c=a===undefined?new C():new C(a);A.push(c);return c};W.prototype=C.prototype;W.__hubW=1;try{Object.setPrototypeOf(W,C)}catch(e){}window[n]=W})}catch(e){}var L=[];document.addEventListener('visibilitychange',function(){if(document.hidden){try{speechSynthesis.cancel()}catch(e){}try{if(typeof window.stopVoice==='function')window.stopVoice()}catch(e){}A.forEach(function(c){try{if(c.state==='running'){c.suspend();c.__hubS=1}}catch(e){}});Array.prototype.forEach.call(document.querySelectorAll('audio,video'),function(m){if(m.srcObject||m.paused)return;try{m.pause();if(m.loop)L.push(m)}catch(e){}})}else{A.forEach(function(c){try{if(c.__hubS){c.__hubS=0;c.resume()}}catch(e){}});L.splice(0).forEach(function(m){try{m.play()}catch(e){}})}})})();</script><script>/* 1.1.3 크롬 83 보충: flex 간격(gap)을 모르는 엔진(칠판)에서만 fix83.html을 읽어 간격을 메워요. 되돌릴 때는 fix83.html만 바꾸면 돼요 */(function(){function need(){var d=document.createElement('div');d.style.cssText='display:flex;flex-direction:column;row-gap:1px;position:absolute;visibility:hidden';d.appendChild(document.createElement('div'));d.appendChild(document.createElement('div'));document.body.appendChild(d);var ok=d.scrollHeight===1;d.parentNode.removeChild(d);return !ok}function go(){try{if(!need())return;fetch((/\/apps\//.test(location.pathname)?'../':'')+'fix83.html').then(function(r){return r.ok?r.text():''}).then(function(t){var m=/<script type="text\/plain" id="gap83">([\s\S]*?)<\/script>/.exec(t);if(m&&m[1].trim())new Function(m[1])()}).catch(function(){})}catch(e){}}if(document.readyState==='loading')addEventListener('DOMContentLoaded',go);else go()})();</script>
<script>/* 칠판 끌기 고침 (2026-11-24): 누른 자리가 다시 그려져 사라져도 끌기가 끊기지 않게 이어 줘요 */
(function(){if(window.__dragFix)return;window.__dragFix=1;var C=null;
function fw(e){var t=e.currentTarget;if(t.isConnected||!C||C.n!==t)return;var h=null;for(var i=0;i<C.a.length;i++)if(C.a[i].isConnected){h=C.a[i];break}h=h||document.body;try{h.dispatchEvent(new PointerEvent(e.type,e))}catch(x){}if(e.type!=='pointermove')off()}
function off(){if(!C)return;['pointermove','pointerup','pointercancel'].forEach(function(k){C.n.removeEventListener(k,fw)});C=null}
document.addEventListener('pointerdown',function(e){if(e.pointerType==='mouse')return;off();var n=e.target;if(!n||!n.addEventListener)return;var a=[],p=n.parentNode;while(p&&p.nodeType===1){a.push(p);p=p.parentNode}C={n:n,a:a};['pointermove','pointerup','pointercancel'].forEach(function(k){n.addEventListener(k,fw)})},true);
document.addEventListener('pointerup',function(e){if(C&&C.n.isConnected)off()},true);
})();</script>

<script>
function JS(w, a = '을', b = '를') { const s = String(w).replace(/<[^>]*>/g, '').replace(/[\s'"」)\]】.!?]+$/, ''); const c = s.charCodeAt(s.length - 1); let f; if (c >= 0xAC00 && c <= 0xD7A3) f = (c - 0xAC00) % 28 > 0; else if (/[0-9]/.test(s.slice(-1))) f = '013678'.includes(s.slice(-1)); else f = /[lmnr]$/i.test(s); return f ? a : b; }
// 초승달 전과 소리 맞춤: 시작 화면에서 정한 소리 크기를 이 앱에도 써요.
// 녹음 크기가 앱마다 달라서, 시작 음악과 같은 크기로 들리게 맞춰요 (NORM).
(function () {
  const NORM = 1.36;
  const vol = () => { try { const v = localStorage.getItem('hub-vol'); return v == null ? 0.7 : Math.max(0, Math.min(1, +v)); } catch (e) { return 0.7; } };
  try {
    const P = (window.BaseAudioContext || window.AudioContext || window.webkitAudioContext).prototype;
    const d = Object.getOwnPropertyDescriptor(P, 'destination');
    if (d && d.get) {
      const M = new WeakMap();
      Object.defineProperty(P, 'destination', { configurable: true, get() {
        let g = M.get(this);
        if (!g) {
          const real = d.get.call(this); g = this.createGain(); const lim = this.createDynamicsCompressor();
          lim.threshold.value = -2; lim.knee.value = 0; lim.ratio.value = 20; lim.attack.value = 0.002; lim.release.value = 0.12;
          g.gain.value = vol() * NORM; g.connect(lim); lim.connect(real); M.set(this, g);
        }
        return g;
      } });
    }
  } catch (e) {}
  try { const sp = speechSynthesis.speak.bind(speechSynthesis); speechSynthesis.speak = u => { try { u.volume = Math.min(1, (u.volume == null ? 1 : u.volume) * vol() / 0.7); } catch (e) {} return sp(u); }; } catch (e) {}
  try { const pl = HTMLMediaElement.prototype.play; HTMLMediaElement.prototype.play = function () { try { if (!this._hubv) { this._hubv = 1; this.volume = Math.min(1, this.volume * vol() / 0.7 * NORM); } } catch (e) {} return pl.apply(this, arguments); }; } catch (e) {}
})();
</script>
<title>빅뱅의측정</title>
<script>/* 1.1.3 글꼴: 화면이 다 뜬 뒤 fonts.html에서 주아체·싱글데이를 불러와요. 되돌릴 때는 fonts.html만 바꾸면 돼요 */(function(){var T=1;function go(){try{fetch((/\/apps\//.test(location.pathname)?'../':'')+'fonts.html').then(function(r){return r.ok?r.text():''}).then(function(t){var re=/<style id="(body|title)"[^>]*>([\s\S]*?)<\/style>/g,m,c='';while((m=re.exec(t)))if(m[1]==='body'||T)c+=m[2];if(!c)return;var s=document.createElement('style');s.id='hgfont';s.textContent=c;document.head.appendChild(s)}).catch(function(){})}catch(e){}}function later(){setTimeout(go,700)}if(document.readyState==='complete')later();else addEventListener('load',later)})();</script>
<style>
  :root { --font: 'Jua', 'Malgun Gothic', sans-serif; --emo: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji', sans-serif; }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; background: #e0f2fe; font-family: var(--font); overflow: hidden; -webkit-user-select: none; user-select: none; }
  #wrap { position: fixed; left: 50%; top: 0; transform: translateX(-50%); }
  #stage { position: absolute; left: 0; top: 0; width: 1280px; height: 720px; transform-origin: 0 0; overflow: hidden; background: #f0f9ff; touch-action: manipulation; }
  .scr { position: absolute; inset: 0; }
  .hidden { display: none !important; }
  button { font-family: var(--font); cursor: pointer; border: none; }
  svg { font-family: var(--font); }
  .btn2 { background: #fff; color: #475569; font-size: 22px; padding: 8px 16px; border-radius: 16px; box-shadow: 0 4px 0 #cbd5e1; border: 2px solid #e2e8f0; }
  .bigbtn { background: #0ea5e9; color: #fff; font-size: 26px; padding: 12px 28px; border-radius: 22px; box-shadow: 0 6px 0 #0369a1; }
  .panel { position: absolute; background: #fff; border-radius: 22px; border: 4px solid #bae6fd; box-shadow: 0 5px 0 #7dd3fc; overflow: hidden; }
  .tier { font-size: 22px; padding: 8px 20px; border-radius: 18px; border: 4px solid #cbd5e1; background: #fff; color: #64748b; }
  .tier.on { color: #fff; border-color: transparent; box-shadow: 0 4px 0 rgba(0,0,0,.2); }
  .card { position: absolute; width: 398px; height: 164px; background: #fff; border-radius: 20px; border: 4px solid #bae6fd; box-shadow: 0 5px 0 #7dd3fc; overflow: hidden; cursor: pointer; text-align: left; padding: 0; display: flex; }
  .card .th { width: 164px; height: 100%; flex: none; }
  .card .th svg { width: 100%; height: 100%; display: block; }
  .card .tx { flex: 1; padding: 12px 12px 8px; display: flex; flex-direction: column; gap: 6px; }
  .card .nm { font-size: 24px; color: #0c4a6e; line-height: 1.15; word-break: keep-all; }
  .card .jb { font-size: 18px; color: #475569; }
  .card .st { margin-top: auto; color: #f59e0b; font-size: 22px; }
  .card.done { border-color: #86efac; box-shadow: 0 5px 0 #4ade80; }
  .opt { display: block; width: 100%; margin-bottom: 12px; background: #fff; border: 4px solid #bae6fd; box-shadow: 0 5px 0 #7dd3fc; border-radius: 20px; font-size: 28px; color: #0c4a6e; padding: 14px 10px; line-height: 1.2; word-break: keep-all; }
  .opt.sm { font-size: 22px; padding: 12px 8px; }
  .opt.no { opacity: .35; pointer-events: none; }
  .opt.ok { background: #dcfce7; border-color: #22c55e; box-shadow: 0 5px 0 #16a34a; color: #166534; }
  .glowb { animation: gb .6s infinite alternate; }
  @keyframes gb { from { box-shadow: 0 0 0 4px #facc15; } to { box-shadow: 0 0 0 12px #fde047; } }
  .shake { animation: sh .35s; }
  @keyframes sh { 25% { transform: translateX(-8px) } 75% { transform: translateX(8px) } }
  .key { width: 104px; height: 66px; font-size: 32px; background: #fff; border: 3px solid #bae6fd; box-shadow: 0 4px 0 #7dd3fc; border-radius: 16px; color: #0c4a6e; }
  .key:active { transform: translateY(3px); box-shadow: 0 1px 0 #7dd3fc; }
  .blank { min-width: 120px; height: 70px; border: 4px solid #94a3b8; border-radius: 16px; background: #f8fafc; font-size: 38px; color: #0c4a6e; display: inline-flex; align-items: center; justify-content: center; padding: 0 10px; }
  .blank.on { border-color: #0ea5e9; background: #e0f2fe; }
  .blank .ph { color: #cbd5e1; }
  .glow { animation: gl .6s infinite alternate; }
  @keyframes gl { from { stroke: #facc15 } to { stroke: #f97316 } }
  #staff { display: inline-block; background: rgba(255,255,255,.9); color: #2a5a8c; font-size: 19px; padding: 5px 20px; border-radius: 99px; box-shadow: 0 3px 8px rgba(10,40,90,.18); }
  #staff b { font-weight: normal; color: #e8534a; }
  #rot { position: fixed; inset: 0; z-index: 9999; background: rgba(240,249,255,.97); display: none; flex-direction: column; align-items: center; justify-content: center; text-align: center; font-size: 26px; color: #0c4a6e; gap: 14px; padding: 20px; }
  @media (orientation: portrait) and (max-width: 820px) { #rot.on { display: flex; } }
</style>
</head>
<body>
<div id="rot" class="on"><div style="font-size:80px">📱↻</div><div>휴대폰을 <b>가로로</b> 돌려 주세요.</div><button class="btn2" onclick="this.parentElement.classList.remove('on')">그냥 세로로 볼게요</button></div>
<div id="wrap"><div id="stage">

  <!-- 처음 화면 -->
  <div id="home" class="scr" style="background:linear-gradient(#bae6fd,#f0f9ff)">
    <div style="position:absolute;left:24px;top:10px;display:flex;align-items:flex-end;gap:6px"><img data-char="wol" style="height:70px"><img data-char="hami" style="height:78px"><img data-char="ari" style="height:70px"></div>
    <div style="position:absolute;left:230px;top:10px;font-size:44px;color:#0c4a6e;text-shadow:0 3px 0 #fff">📏 빅뱅의측정</div>
    <div style="position:absolute;left:234px;top:66px;font-size:19px;color:#0369a1">길이·무게·들이·온도를 재요. 재는 일은 여러 직업에서 꼭 필요해요!</div>
    <div style="position:absolute;right:20px;top:16px;display:flex;gap:6px;align-items:center"><select id="voice-sel" onchange="pickVoice(this.value)" style="font-family:var(--font);font-size:15px;max-width:170px;border-radius:12px;border:2px solid #cbd5e1;padding:5px"></select><button class="btn2" onclick="toggleSound()" id="snd-home" style="font-size:18px">🔊 소리 켜짐</button></div>
    <div id="tiers" style="position:absolute;left:24px;top:98px;display:flex;gap:10px"></div>
    <div id="cards"></div>
    <div style="position:absolute;left:150px;bottom:8px;font-size:12px;color:#64748b"><span id="staff">✨ 크리에이터 <b style="color:#0891d0">강천석</b></span> <span id="rec-credit"></span> <button class="btn2" onclick="resetAll()" style="font-size:14px;padding:4px 10px;margin-left:8px">처음부터 다시</button> <span id="tot" style="font-size:17px;color:#0c4a6e;margin-left:8px"></span></div>
  </div>

  <!-- 직업 장면 (시작 전) -->
  <div id="intro" class="scr hidden" style="background:linear-gradient(#e0f2fe,#f0f9ff)">
    <button class="btn2" onclick="goHome()" style="position:absolute;left:20px;top:18px">🏠</button>
    <div class="panel" style="left:40px;top:90px;width:620px;height:465px;border-radius:30px"><svg id="in-svg" viewBox="0 0 400 300" style="width:100%;height:100%;display:block"></svg></div>
    <div style="position:absolute;left:690px;top:90px;width:560px">
      <div id="in-tier" style="display:inline-block;color:#fff;font-size:20px;padding:4px 16px;border-radius:14px"></div>
      <div id="in-title" style="font-size:40px;color:#0c4a6e;margin-top:10px"></div>
      <div id="in-job" style="font-size:30px;color:#0369a1;margin-top:8px"></div>
      <div id="in-text" style="font-size:26px;color:#334155;line-height:1.5;margin-top:16px;word-break:keep-all"></div>
      <div id="in-what" style="font-size:22px;color:#64748b;margin-top:12px"></div>
    </div>
    <div style="position:absolute;left:690px;top:600px;display:flex;gap:14px;align-items:center"><button class="bigbtn" onclick="startQs()" style="font-size:30px">시작하기 ▶</button><button class="btn2" onclick="playLines([STAGES[CUR].intro])">🗣️ 다시 듣기</button></div>
    <img id="in-char" data-char="hami" style="position:absolute;left:40px;bottom:10px;height:120px">
  </div>

  <!-- 문제 화면 -->
  <div id="play" class="scr hidden" style="background:linear-gradient(#f0f9ff,#fff)">
    <div style="position:absolute;left:0;right:0;top:0;height:88px;background:rgba(255,255,255,.96);border-bottom:4px solid #7dd3fc;display:flex;align-items:center;gap:12px;padding:0 14px;z-index:5">
      <button class="btn2" onclick="goHome()">🏠</button>
      <div style="display:flex;flex-direction:column;min-width:240px">
        <div id="p-title" style="font-size:24px;color:#0c4a6e;white-space:nowrap"></div>
        <div id="p-num" style="font-size:18px;color:#0369a1"></div>
      </div>
      <img id="hp-img" style="height:80px;align-self:flex-end">
      <div id="hp-bub" style="flex:1;background:#f0f9ff;border:3px solid #7dd3fc;border-radius:20px;padding:6px 16px;font-size:21px;color:#334155;line-height:1.28;min-height:56px;max-height:80px;overflow:hidden;display:flex;align-items:center"></div>
      <button class="btn2" onclick="hintMore()">💡</button>
      <button class="btn2" onclick="sayAgain()">🗣️</button>
      <button class="btn2" onclick="toggleSound()" id="snd-play">🔊</button>
    </div>
    <div class="panel" style="left:14px;top:98px;width:864px;height:480px">
      <div id="qtext" style="height:72px;padding:8px 18px;font-size:27px;color:#0c4a6e;line-height:1.3;display:flex;align-items:center;word-break:keep-all;background:#f0f9ff;border-bottom:3px solid #e0f2fe"></div>
      <svg id="vis" viewBox="0 0 860 400" style="width:856px;height:398px;display:block"></svg>
    </div>
    <div class="panel" id="fbp" style="left:14px;top:588px;width:864px;height:104px;padding:10px 16px;display:flex;align-items:center;gap:12px">
      <div id="fb" style="flex:1;font-size:20px;color:#334155;line-height:1.38;word-break:keep-all"></div>
      <button id="nextb" class="bigbtn hidden" onclick="nextQ()">다음 ▶</button>
    </div>
    <div class="panel" style="left:892px;top:98px;width:374px;height:612px;padding:12px 14px">
      <div id="jobc" style="display:flex;align-items:center;gap:10px;padding:6px 8px 12px;border-bottom:3px dashed #bae6fd;margin-bottom:14px"></div>
      <div id="ans"></div>
    </div>
  </div>

  <!-- 단계 완료 -->
  <div id="clear" class="scr hidden" style="background:rgba(10,40,70,.5);z-index:20">
    <div style="position:absolute;left:190px;top:50px;width:900px;height:620px;background:#fff;border-radius:36px;border:6px solid #fde047;padding:22px 30px;text-align:center">
      <div style="display:flex;justify-content:center;align-items:flex-end;gap:8px"><img data-char="wol" style="height:90px"><img data-char="hami" style="height:100px"><img data-char="ari" style="height:90px"></div>
      <div id="cl-stars" style="font-size:54px;color:#f59e0b;text-shadow:0 3px 0 #b45309"></div>
      <div id="cl-title" style="font-size:36px;color:#0c4a6e"></div>
      <div id="cl-text" style="margin:16px auto;width:760px;font-size:25px;color:#334155;line-height:1.5;word-break:keep-all"></div>
      <div style="display:flex;justify-content:center;gap:14px;margin-top:14px"><button class="bigbtn" id="cl-next" onclick="nextStage()">다음 단계 ▶</button><button class="btn2" onclick="openStage(CUR)">🔁 다시 하기</button><button class="btn2" onclick="goHome()">🏠 처음으로</button></div>
    </div>
  </div>
</div></div>

<script>window.SYNC_APP='meas';window.SYNC_KEYS=['meas-stars'];</script>
<script>
// ===================== 학생 진도 저장 (이 기기에만) =====================
// 고른 학생 이름별로 진도를 이 기기에만 저장해요. 밖으로 보내지 않아요.
(function () {
  const APP = window.SYNC_APP, KEYS = window.SYNC_KEYS || [];
  const LS = window.localStorage, SS = window.sessionStorage;
  const rawSet = Storage.prototype.setItem, rawGet = Storage.prototype.getItem, rawDel = Storage.prototype.removeItem;
  const g = k => { try { return rawGet.call(LS, k); } catch (e) { return null; } };
  const s = (k, v) => { try { rawSet.call(LS, k, v); } catch (e) {} };
  const d = k => { try { rawDel.call(LS, k); } catch (e) {} };
  const ss = { get: k => { try { return SS.getItem(k); } catch (e) { return null; } }, set: (k, v) => { try { SS.setItem(k, v); } catch (e) {} }, del: k => { try { SS.removeItem(k); } catch (e) {} } };
  // 이 기기에서 마지막으로 고른 이름을 기억해요 (파일을 다시 열어도 그 이름으로 시작해요)
  const who = () => ss.get('sync-student') || (() => { const v = g('sync-last-student'); if (v) ss.set('sync-student', v); return v; })();
  const cacheKey = st => `sync-cache:${APP}:${st}`;
  const snapshot = () => { const o = {}; KEYS.forEach(k => { const v = g(k); if (v != null) o[k] = v; }); return o; };
  const apply = o => { KEYS.forEach(k => { if (o && o[k] != null) s(k, o[k]); else d(k); }); };

  // 앱이 진도를 저장할 때마다 학생 기록에도 저장
  let timer = null, state = '';
  Storage.prototype.setItem = function (k, v) {
    rawSet.call(this, k, v);
    if (this === LS && KEYS.includes(k) && who()) { s(cacheKey(who()), JSON.stringify(snapshot())); }
  };

  // ---------- 화면 ----------
  const css = `#sy-chip{position:fixed;left:8px;bottom:8px;z-index:20000;background:#fff;border:2px solid #cbd5e1;border-radius:99px;padding:4px 12px;font:15px 'Jua','Malgun Gothic',sans-serif;color:#334155;cursor:pointer;box-shadow:0 2px 6px #0002}
  #sy-ov{position:fixed;inset:0;z-index:20001;background:rgba(15,23,42,.55);display:flex;align-items:center;justify-content:center;font-family:'Jua','Malgun Gothic',sans-serif}
  #sy-box{background:#fff;border-radius:26px;border:5px solid #fde047;padding:18px 22px;width:min(92vw,760px);max-height:90vh;overflow:auto;text-align:center}
  #sy-box h2{margin:4px 0 10px;font-weight:normal;font-size:30px;color:#1e3a8a}
  .sy-names{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px;margin:10px 0}
  .sy-names button,.sy-btn{font:22px 'Jua','Malgun Gothic',sans-serif;background:#f0f9ff;border:3px solid #7dd3fc;border-radius:16px;padding:10px 12px;cursor:pointer;color:#0c4a6e;white-space:nowrap}
  .sy-names button:hover{background:#e0f2fe}
  .sy-in{font:18px sans-serif;padding:8px;border-radius:10px;border:2px solid #cbd5e1;width:100%;box-sizing:border-box;margin:4px 0}
  .sy-small{font-size:15px;color:#64748b}
  .sy-red{background:#fef2f2!important;border-color:#fca5a5!important;color:#991b1b!important}`;
  const st0 = document.createElement('style'); st0.textContent = css; document.head.appendChild(st0);
  function setState(x) { state = x; chip(); }
  function chip() {
    let c = document.getElementById('sy-chip'); if (!c) { c = document.createElement('div'); c.id = 'sy-chip'; c.onclick = () => picker(); document.body.appendChild(c); }
    const icon = '📱';
    c.textContent = `👤 ${who() || '이름 고르기'} ${icon}`;
    c.title = '이 기기에만 저장해요';
  }
  function overlay(html) { let o = document.getElementById('sy-ov'); if (!o) { o = document.createElement('div'); o.id = 'sy-ov'; document.body.appendChild(o); } o.innerHTML = `<div id="sy-box">${html}</div>`; return o; }
  function close() { const o = document.getElementById('sy-ov'); if (o) o.remove(); }

  async function picker() {
    let names = []; try { names = JSON.parse(g('sync-students') || '[]'); } catch (e) {}
    overlay(`<h2>👋 누구예요?</h2><div class="sy-small" id="sy-msg">이름을 골라요</div><div class="sy-names" id="sy-names"></div>
      <div style="display:flex;gap:8px;margin-top:6px"><input class="sy-in" id="sy-new" placeholder="이름이 없으면 여기에 써요"><button class="sy-btn" id="sy-add">확인</button></div>`);
    const draw = () => { document.getElementById('sy-names').innerHTML = names.map(n => `<button>${String(n).replace(/</g, '')}</button>`).join(''); document.querySelectorAll('#sy-names button').forEach(b => b.onclick = () => choose(b.textContent)); };
    draw();
    document.getElementById('sy-add').onclick = () => { const v = document.getElementById('sy-new').value.trim(); if (v) choose(v); };
  }
  async function choose(name) {
    overlay(`<h2>⏳ ${name} 진도를 불러오는 중…</h2>`);
    let data = null;
    if (data == null) { try { data = JSON.parse(g(cacheKey(name)) || 'null'); } catch (e) {} }
    apply(data || {}); s(cacheKey(name), JSON.stringify(data || {}));
    ss.set('sync-student', name); ss.set('sync-ready:' + APP, '1');
    s('sync-last-student', name);
    try { const L = JSON.parse(g('sync-students') || '[]'); if (!L.includes(name)) { L.push(name); s('sync-students', JSON.stringify(L)); } } catch (e) {}
    location.reload();
  }

  // ---------- 시작 ----------
  function start() {
    chip();
    if (!who()) picker();
    else if (!ss.get('sync-ready:' + APP)) choose(who());   // 다른 앱에서 이미 고른 학생이면 바로 불러와요
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else setTimeout(start, 0);
  window.SYNC = { picker, push: () => {}, who };
})();

</script>
<script>
const CHARS = {
  wol:  { name:'월이', color:'#0369a1', img:'data:image/webp;base64,' },
  ari:  { name:'아리', color:'#9333ea', img:'data:image/webp;base64,' },
  hami: { name:'대롱이', color:'#db2777', img:'data:image/webp;base64,' }
};
document.querySelectorAll('img[data-char]').forEach(el => el.src = CHARS[el.dataset.char].img);
const $ = id => document.getElementById(id);
const stage = $('stage');
let SC = 1;
function fit() {
  const vv = window.visualViewport, W = vv ? vv.width : innerWidth, H = vv ? vv.height : innerHeight;
  const NAVH = 42;   // 아래쪽 ◀ 이전 · 🏠 홈 단추 자리는 비워 둬요
  SC = Math.min(W / 1280, (H - NAVH) / 720);
  stage.style.transform = `scale(${SC})`;
  $('wrap').style.width = 1280 * SC + 'px'; $('wrap').style.height = 720 * SC + 'px';
  $('wrap').style.top = (H > W ? 0 : Math.max(0, (H - NAVH - 720 * SC) / 2)) + 'px';
}
addEventListener('resize', fit); addEventListener('orientationchange', () => setTimeout(fit, 300)); if (window.visualViewport) visualViewport.addEventListener('resize', fit); fit();
const pick = a => a[Math.floor(Math.random() * a.length)];

// ===================== 소리 =====================
let soundOn = true, AC = null;
function ac() { try { if (!AC) AC = new (window.AudioContext || window.webkitAudioContext)(); if (AC.state === 'suspended') AC.resume(); } catch (e) {} return AC; }
function tone(f, t, dur, type = 'sine', vol = .2, f2) {
  const a = ac(); if (!a) return;
  const o = a.createOscillator(), g = a.createGain();
  o.type = type; o.frequency.setValueAtTime(f, t); if (f2) o.frequency.exponentialRampToValueAtTime(f2, t + dur);
  g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(vol, t + .01); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
  o.connect(g).connect(a.destination); o.start(t); o.stop(t + dur + .02);
}
function toggleSound() { soundOn = !soundOn; $('snd-home').innerText = soundOn ? '🔊 소리 켜짐' : '🔇 소리 꺼짐'; $('snd-play').innerText = soundOn ? '🔊' : '🔇'; if (!soundOn) stopVoice(); }
const VOICE_KEY = 'meas-voice';
// ===================== 음성 (최소 대사 방식) =====================
// 화면 말풍선은 문장 그대로, 소리는 짧은 대사 조각만 읽어요.
// VOICE_SPRITES 의 clips 에 [시작초, 끝초]가 있으면 녹음을 틀고, 없으면 기기 목소리로 읽어요.
// 공통 녹음(모든 앱이 같이 씀) + 앱 녹음, 여러 개를 함께 쓸 수 있어요.
const VOICE_SPRITES = [{"name": "클로바더빙 녹음", "clips": {"다시 생각해 봐요": [0, 1.27], "색깔과 그림을 잘 봐요": [1.39, 3.3], "반짝이는 곳을 봐요": [3.42, 4.85], "흐린 숫자를 따라 눌러 봐요": [4.97, 6.8], "빈칸에 숫자를 써요": [6.92, 8.45], "맞아요": [8.57, 9.24], "참 잘했어요": [9.36, 10.45], "옷가게 직원은 손님에게 맞는 옷을 골라 줘요. 바지나 목도리의 길이를 비교해서 더 긴 것과 짧은 것을 찾아요.": [10.57, 18.2], "가장 긴 바지는 어느 것일까요?": [18.32, 20.33], "바지 아래쪽 끝이 똑같이 맞춰져 있어요. 위쪽 끝이 가장 높은 바지를 찾아요.": [20.45, 26.25], "긴 바지는 키가 큰 손님에게 맞아요. 옷가게에서는 길이를 비교해서 옷을 골라 줘요.": [26.37, 32.37], "가장 짧은 목도리는 어느 것일까요?": [32.49, 34.81], "왼쪽 끝이 맞춰져 있어요. 오른쪽 끝이 가장 덜 나온 목도리를 찾아요.": [34.93, 40.16], "짧은 목도리는 어린이에게 알맞아요.": [40.28, 42.68], "키가 가장 큰 친구는 누구일까요?": [42.8, 45.02], "세 친구 모두 같은 바닥에 서 있어요. 머리 꼭대기가 가장 높은 친구를 찾아요.": [45.14, 50.73], "옷가게에서는 키를 보고 옷 크기를 골라요. 키가 크면 더 큰 옷이 필요해요.": [50.85, 56.12], "어느 끈이 더 길까요?": [56.24, 57.71], "끝이 맞춰져 있지 않아요. 왼쪽 끝을 똑같이 맞추고 비교해야 해요.": [57.83, 62.59], "길이를 비교할 때는 한쪽 끝을 똑같이 맞춰요. 옷가게에서도 옷을 겹쳐서 끝을 맞춰 봐요.": [62.71, 69.14], "손님 팔 길이와 똑같은 소매는 어느 것일까요?": [69.26, 72.24], "회색 팔과 오른쪽 끝이 똑같이 끝나는 소매를 찾아요.": [72.36, 75.96], "소매가 팔 길이와 같아야 옷이 편해요. 옷을 고칠 때도 팔 길이와 비교해요.": [76.08, 81.54], "목수는 나무로 책상과 의자를 만들어요. 자가 없을 때는 손을 쫙 펴서 한 뼘, 두 뼘 하고 길이를 재요.": [81.66, 89.14], "책상의 긴 쪽은 몇 뼘일까요?": [89.26, 91.31], "손 모양 하나가 한 뼘이에요. 손 모양을 하나씩 세어 봐요.": [91.43, 95.65], "목수는 뼘으로 대강 길이를 재고, 어떤 책상을 만들지 생각해요.": [95.77, 100.06], "나무 판자는 몇 뼘일까요?": [100.18, 102.05], "왼쪽부터 손 모양을 하나씩 짚으며 세어 봐요.": [102.17, 105.11], "판자 길이를 알면 무엇을 만들 수 있을지 정할 수 있어요.": [105.23, 108.81], "의자의 높이는 몇 뼘일까요?": [108.93, 110.8], "바닥부터 위로 손 모양을 세어 봐요.": [110.92, 113.23], "의자 높이가 알맞아야 편하게 앉을 수 있어요.": [113.35, 116.32], "책상은 선반보다 몇 뼘 더 길까요?": [116.44, 118.85], "책상은 몇 뼘, 선반은 몇 뼘인지 따로 세고 비교해요.": [118.97, 122.62], "목수는 두 나무의 길이를 비교해서 얼마나 더 필요한지 알아내요.": [122.74, 126.8], "책장의 너비는 4뼘하고 조금 더 남아요. 약 몇 뼘이라고 할까요?": [126.92, 131.75], "손 모양이 4개 있고 아주 조금 남았어요.": [131.87, 134.81], "딱 맞지 않을 때는 \"약 몇 뼘\"이라고 어림해요. 목수도 처음에는 어림해서 재요.": [134.93, 140.86], "농부는 밭에 씨앗을 심기 전에 밭의 길이를 걸음으로 재요. 한 걸음, 두 걸음 세며 걸어요.": [140.98, 147.62], "배추밭의 길이는 몇 걸음일까요?": [147.74, 149.95], "발자국 하나가 한 걸음이에요. 하나씩 세어 봐요.": [150.07, 153.9], "밭 길이를 알면 씨앗을 몇 줄 심을지 정할 수 있어요.": [154.02, 157.36], "꽃밭의 길이는 몇 걸음일까요?": [157.48, 159.55], "발자국을 왼쪽부터 손가락으로 짚으며 세어 봐요.": [159.67, 162.94], "정원사도 걸음으로 꽃밭 크기를 어림해요.": [163.06, 165.8], "두 밭 중 어느 밭이 더 길까요?": [165.92, 167.89], "두 밭의 걸음 수를 각각 세어 비교해요. 걸음 수가 많으면 더 길어요.": [168.01, 172.99], "같은 사람이 걸었으니까 걸음 수가 많은 밭이 더 길어요.": [173.11, 176.96], "고구마밭은 몇 걸음일까요?": [177.08, 178.9], "발자국이 많아요. 다섯까지 센 다음 이어서 세어 봐요.": [179.02, 183.17], "밭이 길면 걸음 수도 많아져요.": [183.29, 185.57], "울타리는 5걸음하고 조금 더 남아요. 약 몇 걸음일까요?": [185.69, 190.21], "발자국 5개에 아주 조금 남았어요.": [190.33, 192.91], "딱 맞지 않을 때는 \"약 몇 걸음\"이라고 말해요.": [193.03, 196.03], "도예가는 흙으로 그릇과 꽃병을 만들어요. 여러 개를 비슷한 크기로 만들려고 높이와 길이를 재요. 블록이나 클립을 이어서 재 볼까요?": [196.15, 205.39], "꽃병의 높이는 블록 몇 개일까요?": [205.51, 207.82], "아래부터 블록을 하나씩 세어 봐요.": [207.94, 210.2], "도예가는 꽃병 높이를 재서 같은 크기로 여러 개를 만들어요.": [210.32, 214.09], "컵의 높이는 블록 몇 개일까요?": [214.21, 216.38], "블록이 컵 꼭대기까지 몇 개 쌓였는지 세어요.": [216.5, 219.47], "컵 높이가 같아야 세트로 팔 수 있어요.": [219.59, 222.16], "붓의 길이는 클립 몇 개일까요?": [222.28, 224.22], "붓 아래에 있는 클립을 하나씩 세어 봐요.": [224.34, 226.83], "도예가는 붓으로 그릇에 그림을 그려요.": [226.95, 229.68], "항아리는 꽃병보다 블록 몇 개 더 높을까요?": [229.8, 232.72], "꽃병 블록과 항아리 블록을 각각 세고 몇 개 차이인지 봐요.": [232.84, 236.73], "높이를 비교하면 어느 쪽을 더 크게 만들었는지 알 수 있어요.": [236.85, 240.51], "접시의 길이는 클립 몇 개일까요?": [240.63, 242.72], "클립을 왼쪽부터 세어 봐요.": [242.84, 244.74], "접시 크기를 재면 그릇장에 들어갈지 알 수 있어요.": [244.86, 248.08], "요리사는 밥을 지을 때 쌀과 물을 컵으로 재요. 컵 수가 알맞아야 밥이 맛있게 돼요.": [248.2, 254.17], "냄비에 물을 몇 컵 부었을까요?": [254.29, 256.34], "컵을 하나씩 세어 봐요.": [256.46, 258.08], "물을 컵으로 재면 매번 같은 맛을 낼 수 있어요.": [258.2, 261.38], "밥솥에 쌀을 몇 컵 넣었을까요?": [261.5, 263.8], "쌀이 담긴 컵을 세어요.": [263.92, 265.55], "먹을 사람 수에 맞게 쌀 컵 수를 정해요.": [265.67, 268.49], "물은 쌀보다 1컵 더 넣어요. 물은 몇 컵 넣을까요?": [268.61, 272.71], "쌀 2컵에 1컵을 더해요.": [272.83, 274.77], "쌀과 물의 양을 맞추면 밥이 질지도 되지도 않아요.": [274.89, 278.26], "물이 더 많이 들어간 냄비는 어느 것일까요?": [278.38, 281.04], "두 냄비에 부은 컵 수를 세어 비교해요.": [281.16, 283.58], "같은 컵으로 부었으니 컵 수가 많은 쪽에 물이 더 많아요.": [283.7, 287.35], "큰 냄비를 채우려면 5컵이 필요해요. 3컵 부었어요. 몇 컵 더 부어야 할까요?": [287.47, 294.21], "점선 컵이 더 부어야 할 컵이에요. 점선 컵을 세어 봐요.": [294.33, 298.65], "얼마나 더 필요한지 알면 넘치지 않게 부을 수 있어요.": [298.77, 302.19], "카페 바리스타는 컵 크기에 맞게 음료를 담아요. 어느 컵에 물이 더 많이 들어가는지 비교해 봐요.": [302.31, 308.93], "물이 더 많이 담긴 컵은 어느 것일까요?": [309.05, 311.55], "두 컵의 크기가 똑같아요. 물의 높이를 비교해요.": [311.67, 315.63], "크기가 같은 컵이면 물이 높이 찬 쪽이 더 많아요.": [315.75, 319.02], "물이 가장 적게 담긴 컵은 어느 것일까요?": [319.14, 321.85], "물의 높이가 가장 낮은 컵을 찾아요.": [321.97, 324.44], "손님이 조금만 달라고 하면 적게 담아요.": [324.56, 327.34], "두 병의 물을 똑같은 컵에 따랐어요. 어느 병에 물이 더 많았을까요?": [327.46, 332.43], "병에서 나온 컵 수를 세어 비교해요.": [332.55, 334.86], "같은 컵으로 재면 어느 그릇에 더 많이 들어가는지 알 수 있어요.": [334.98, 338.77], "두 컵의 물 높이가 같아요. 물이 더 많은 컵은 어느 것일까요?": [338.89, 343.5], "물 높이가 같으면 더 넓은 컵에 물이 더 많아요.": [343.62, 346.91], "컵이 넓으면 같은 높이라도 물이 더 많이 들어가요.": [347.03, 350.17], "작은 컵 2개로 큰 컵 1개가 가득 차요. 큰 컵 2개를 채우려면 작은 컵이 몇 개 필요할까요?": [350.29, 357.2], "큰 컵 하나에 작은 컵 2개씩이에요. 2개씩 두 번 세어 봐요.": [357.32, 361.9], "바리스타는 컵 크기를 알고 음료 양을 맞춰요.": [362.02, 364.98], "과일가게 사장님은 저울로 과일 무게를 비교해요. 양팔저울에서는 무거운 쪽이 아래로 내려가요.": [365.1, 371.69], "더 무거운 과일은 무엇일까요?": [371.81, 373.87], "저울이 아래로 내려간 쪽을 봐요.": [373.99, 376.07], "수박이 사과보다 무거워서 저울이 수박 쪽으로 내려갔어요.": [376.19, 379.73], "더 가벼운 과일은 무엇일까요?": [379.85, 381.92], "위로 올라간 쪽이 더 가벼워요.": [382.04, 384.11], "가벼운 쪽은 위로 올라가요.": [384.23, 386.03], "두 쪽의 무게는 어떤가요?": [386.15, 387.96], "저울이 어느 쪽으로도 기울지 않았어요.": [388.08, 390.52], "저울이 평평하면 양쪽 무게가 같아요.": [390.64, 393.33], "가장 무거운 과일은 무엇일까요?": [393.45, 395.67], "사과는 딸기보다 무겁고, 멜론은 사과보다 무거워요.": [395.79, 399.51], "두 번 비교해서 가장 무거운 것을 찾았어요.": [399.63, 402.54], "수박 1통은 멜론 몇 개와 무게가 같을까요?": [402.66, 405.62], "저울이 평평해요. 오른쪽 멜론을 세어 봐요.": [405.74, 409.33], "과일가게에서는 저울로 무게를 맞춰 팔아요.": [409.45, 412.26], "옛날 시장에서는 돌을 저울에 올려 무게를 쟀어요. 바둑돌 몇 개와 무게가 같은지 세어 봐요.": [412.38, 418.77], "사과는 바둑돌 몇 개와 무게가 같을까요?": [418.89, 421.7], "저울이 평평해요. 오른쪽 바둑돌을 하나씩 세어 봐요.": [421.82, 425.91], "사과의 무게는 바둑돌 6개만큼이에요.": [426.03, 428.86], "귤은 바둑돌 몇 개와 무게가 같을까요?": [428.98, 431.57], "바둑돌을 하나씩 짚으며 세어 봐요.": [431.69, 433.94], "귤은 사과보다 가벼워서 바둑돌이 더 적어요.": [434.06, 437.22], "감자는 바둑돌 8개, 양파는 바둑돌 5개와 무게가 같아요. 더 무거운 것은 무엇일까요?": [437.34, 444.35], "바둑돌이 많을수록 더 무거워요.": [444.47, 446.68], "바둑돌 수를 비교하면 어느 것이 더 무거운지 알 수 있어요.": [446.8, 450.35], "감자는 양파보다 바둑돌 몇 개만큼 더 무거울까요?": [450.47, 453.96], "8개와 5개의 차이를 세어 봐요.": [454.08, 456.48], "무게의 차이도 바둑돌로 알 수 있어요.": [456.6, 459.03], "배 쪽으로 저울이 내려갔어요. 배는 바둑돌 5개보다 어떨까요?": [459.15, 463.95], "내려간 쪽이 더 무거워요.": [464.07, 465.84], "저울이 기울면 두 쪽의 무게가 다르다는 뜻이에요.": [465.96, 469.05], "가구점에 책상을 주문할 때 \"5뼘짜리 주세요\" 하면 어떻게 될까요? 사람마다 손 크기가 달라서 길이가 달라져요. 그래서 모두가 똑같이 쓰는 단위가 필요해요.": [469.17, 480.36], "같은 책상을 아빠 뼘과 월이 뼘으로 쟀어요. 누구 뼘으로 잰 수가 더 많을까요?": [480.48, 486.11], "두 줄의 손 모양 수를 각각 세어 봐요.": [486.23, 488.66], "월이 손이 작아서 더 많이 재야 해요. 같은 책상인데 수가 달라졌어요!": [488.78, 493.96], "같은 물을 큰 컵으로 2컵, 작은 컵으로 4컵 담았어요. 어느 컵이 더 클까요?": [494.08, 499.72], "컵이 클수록 적은 수로도 다 담을 수 있어요.": [499.84, 502.58], "컵 크기가 다르면 같은 물이라도 컵 수가 달라져요.": [502.7, 506.2], "\"5뼘짜리 책상 주세요\" 하고 주문하면 어떻게 될까요?": [506.32, 509.98], "아빠 뼘과 월이 뼘으로 잰 수가 달랐던 것을 생각해요.": [510.1, 513.54], "그래서 가게에서는 누구나 똑같이 쓰는 cm로 주문해요.": [513.66, 517.24], "누구나 똑같은 길이로 재려면 무엇을 쓸까요?": [517.36, 520.3], "사람마다 달라지지 않는 도구를 찾아요.": [520.42, 522.97], "자는 누가 써도 1cm가 똑같아요.": [523.09, 525.83], "누구나 똑같은 무게로 재려면 무엇을 쓸까요?": [525.95, 528.94], "눈금이 있어서 누가 재도 같은 도구를 찾아요.": [529.06, 531.87], "저울은 누가 재도 같은 무게가 나와요.": [531.99, 534.38], "누구나 똑같은 양으로 재려면 무엇을 쓸까요?": [534.5, 537.48], "눈금이 그려진 컵을 찾아요.": [537.6, 539.51], "계량컵에는 눈금이 있어서 늘 같은 양을 잴 수 있어요.": [539.63, 542.97], "재단사는 옷을 만드는 사람이에요. 자로 천과 리본의 길이를 cm로 재요. 물건 끝을 자의 0에 맞추고, 다른 끝의 눈금을 읽어요.": [543.09, 552.68], "리본의 길이는 몇 cm일까요?": [552.8, 554.76], "리본 끝이 0에 맞춰져 있어요. 오른쪽 끝에 있는 숫자를 읽어요.": [554.88, 559.67], "재단사는 리본을 cm로 재서 옷에 딱 맞게 달아요.": [559.79, 563.23], "연필의 길이는 몇 cm일까요?": [563.35, 565.35], "연필 뾰족한 끝이 가리키는 숫자를 읽어요.": [565.47, 568.39], "재단사는 연필로 천에 자를 곳을 표시해요.": [568.51, 571.44], "지우개의 길이는 몇 cm일까요?": [571.56, 573.66], "지우개 오른쪽 끝 아래 숫자를 읽어요.": [573.78, 576.34], "작은 물건도 자로 정확하게 잴 수 있어요.": [576.46, 579.43], "실의 길이는 몇 cm일까요?": [579.55, 581.39], "실 끝에서 내려온 점선이 가리키는 숫자를 읽어요.": [581.51, 584.69], "옷을 꿰맬 때 실을 알맞은 길이로 잘라요.": [584.81, 587.61], "단추를 꿴 줄의 길이는 몇 cm일까요?": [587.73, 590.23], "줄의 오른쪽 끝 점선을 따라 내려가 숫자를 읽어요.": [590.35, 593.53], "단추 사이 길이를 재서 옷에 고르게 달아요.": [593.65, 596.37], "목수의 자는 끝이 닳아 있기도 해요. 그럴 때는 중간 눈금부터 재요. 1cm 칸이 몇 개인지 세면 길이를 알 수 있어요.": [596.49, 605.5], "나무 막대의 길이는 몇 cm일까요?": [605.62, 607.86], "막대가 2에서 시작해서 7에서 끝나요. 1cm 칸을 세어 봐요.": [607.98, 612.94], "목수는 끝 눈금에서 시작 눈금을 빼서 길이를 구해요.": [613.06, 616.5], "못의 길이는 몇 cm일까요?": [616.62, 618.43], "못이 1에서 시작해요. 4까지 1cm 칸이 몇 개인지 세어요.": [618.55, 623.47], "못 길이가 알맞아야 나무를 튼튼하게 붙일 수 있어요.": [623.59, 626.87], "나무 조각의 길이는 몇 cm일까요?": [626.99, 629.21], "3에서 시작해서 11에서 끝나요. 칸을 세어 봐요.": [629.33, 633.4], "짧은 나무 조각도 길이를 재서 버리지 않고 써요.": [633.52, 636.6], "의자 다리 모형의 길이는 몇 cm일까요?": [636.72, 639.27], "5에서 시작해서 14에서 끝나요.": [639.39, 641.69], "의자 다리 4개의 길이가 똑같아야 의자가 흔들리지 않아요.": [641.81, 645.44], "연필이 4에서 시작해요. 10까지 칸을 세어 봐요.": [645.56, 649.45], "시작이 0이 아니어도 칸을 세면 길이를 알 수 있어요.": [649.57, 652.93], "집을 짓는 사람은 긴 것은 m(미터)로, 짧은 것은 cm(센티미터)로 재요. 1m는 100cm예요.": [653.05, 659.92], "1m는 몇 cm일까요?": [660.04, 661.8], "1m 막대에 10cm 칸이 10개 있어요. 10씩 세어 봐요.": [661.92, 666.64], "1m는 100cm예요. 건축가는 긴 길이를 m로 말해요.": [666.76, 671.6], "연필 길이에 알맞은 단위는 무엇일까요?": [671.72, 674.32], "연필은 짧아요. 짧은 것은 cm로 재요.": [674.44, 678.12], "손에 쥐는 작은 물건은 cm로 재요.": [678.24, 680.79], "교실 긴 쪽의 길이에 알맞은 단위는 무엇일까요?": [680.91, 684.02], "교실은 아주 길어요. 긴 것은 m로 재요.": [684.14, 687.58], "건축가는 방의 크기를 m로 재서 설계도를 그려요.": [687.7, 690.96], "문 높이에 알맞은 단위는 무엇일까요?": [691.08, 693.46], "문은 사람보다 커요. 2cm라면 손가락보다 짧아요!": [693.58, 698.34], "문 높이는 약 2m예요. 200cm라고도 말해요.": [698.46, 702.83], "휴대폰 길이에 알맞은 단위는 무엇일까요?": [702.95, 705.48], "휴대폰은 손에 쥘 만큼 짧아요.": [705.6, 707.98], "15m라면 버스보다 긴 휴대폰이 돼요!": [708.1, 710.97], "1m보다 긴 것은 무엇일까요?": [711.09, 713.28], "1m는 어른 한 걸음쯤이에요. 그보다 긴 것을 찾아요.": [713.4, 717.68], "버스는 길이가 약 11m예요.": [717.8, 720.08], "보건 선생님과 간호사는 키와 몸무게를 재서 우리가 건강하게 자라는지 살펴봐요. 키는 cm, 몸무게는 kg으로 재요.": [720.2, 728.25], "월이의 키는 몇 cm일까요?": [728.37, 730.17], "빨간 선 아래쪽 큰 숫자 130을 찾고, 작은 눈금을 더 세어 봐요.": [730.29, 735.13], "보건 선생님은 키를 재서 건강 기록에 적어요.": [735.25, 738.62], "120과 130 사이 가운데 긴 눈금이 125예요.": [740.67, 744.42], "키가 자라면 책상과 의자 높이도 맞춰 바꿔요.": [744.54, 747.73], "아리의 몸무게는 몇 kg일까요?": [747.85, 749.97], "바늘이 30을 조금 지났어요. 30에서 작은 눈금을 세어요.": [750.09, 754.85], "몸무게를 재면 건강하게 자라는지 알 수 있어요.": [754.97, 757.88], "월이의 몸무게는 몇 kg일까요?": [758.0, 760.15], "바늘이 30보다 조금 덜 갔어요. 20에서 작은 눈금을 세어 봐요.": [760.27, 765.27], "보건실 체중계는 kg으로 몸무게를 알려 줘요.": [765.39, 768.53], "지난봄 월이 키는 128cm였어요. 지금은 132cm예요. 몇 cm 컸을까요?": [768.65, 776.26], "파란 점선과 빨간 선 사이의 작은 눈금 칸을 세어 봐요.": [776.38, 780.12], "키를 재서 비교하면 얼마나 자랐는지 알 수 있어요.": [780.24, 783.4], "제빵사는 밀가루와 설탕을 g(그램)으로 재요. 조금만 달라져도 빵 맛이 달라지기 때문에 저울을 꼭 써요.": [783.52, 790.59], "밀가루의 무게는 몇 g일까요?": [790.71, 792.74], "바늘이 가리키는 큰 숫자를 읽어요.": [792.86, 795.12], "빵 반죽에는 밀가루를 정확하게 넣어야 해요.": [795.24, 798.13], "설탕의 무게는 몇 g일까요?": [798.25, 800.21], "바늘이 100과 200 사이 가운데에 있어요. 가운데는 150이에요.": [800.33, 805.23], "설탕을 너무 많이 넣으면 빵이 너무 달아져요.": [805.35, 808.4], "버터의 무게는 몇 g일까요?": [808.52, 810.44], "400과 500 사이 가운데 눈금이에요.": [810.56, 813.04], "버터를 재서 넣으면 쿠키가 늘 똑같이 고소해요.": [813.16, 816.52], "밀가루 500g이 필요한데 저울은 400g이에요. 어떻게 할까요?": [816.64, 821.59], "400은 500보다 작아요. 모자라요.": [821.71, 824.98], "모자라면 더 넣고, 많으면 덜어 내요.": [825.1, 828.01], "초콜릿의 무게는 몇 g일까요?": [828.13, 830.19], "바늘 끝에 있는 큰 숫자를 읽어요.": [830.31, 832.52], "제빵사는 초콜릿 무게를 재서 케이크를 만들어요.": [832.64, 835.78], "택배 기사님은 상자의 무게를 kg(킬로그램)으로 재요. 무거운 상자는 배달비가 더 들고, 조심해서 옮겨요.": [835.9, 842.98], "상자의 무게는 몇 kg일까요?": [843.1, 845.23], "바늘이 가리키는 숫자를 읽어요.": [845.35, 847.39], "택배 기사님은 상자 무게를 보고 배달비를 정해요.": [847.51, 851.19], "수박의 무게는 몇 kg일까요?": [851.31, 853.37], "바늘 끝 숫자를 읽어요.": [853.49, 855.11], "시장 상인도 수박을 kg으로 재서 팔아요.": [855.23, 858.04], "쌀 포대의 무게는 몇 kg일까요?": [858.16, 860.38], "바늘이 10을 지났어요. 10에서 작은 눈금을 세어 봐요.": [860.5, 864.74], "무거운 쌀 포대는 둘이 함께 들어요.": [864.86, 867.35], "5kg보다 무거운 상자는 배달비가 더 들어요. 이 상자는 어떨까요?": [867.47, 872.66], "바늘이 5보다 더 많이 돌아갔어요.": [872.78, 875.07], "7kg은 5kg보다 무거워서 배달비가 더 들어요.": [875.19, 878.79], "사과 1개의 무게에 알맞은 단위는 무엇일까요?": [878.91, 881.92], "사과는 가벼워요. 가벼운 것은 g으로 재요.": [882.04, 885.77], "1kg은 1000g이에요. 사과 300kg이면 사과 상자 수십 개만큼 무거워요!": [885.89, 891.36], "수박 1통의 무게에 알맞은 단위는 무엇일까요?": [891.48, 894.46], "수박은 무거워요. 무거운 것은 kg으로 재요.": [894.58, 898.39], "6g이면 사탕 몇 개 무게예요. 수박은 6kg쯤이에요.": [898.51, 903.22], "바리스타는 우유와 물을 mL(밀리리터)로 재요. 늘 같은 양을 넣어야 언제 마셔도 맛이 똑같아요.": [903.34, 909.82], "우유는 몇 mL일까요?": [909.94, 911.54], "우유 윗면과 같은 높이의 숫자를 읽어요.": [911.66, 914.29], "라떼에는 우유를 정확하게 재서 넣어요.": [914.41, 916.92], "물은 몇 mL일까요?": [917.04, 918.44], "300과 400 사이 가운데 눈금이에요.": [918.56, 921.19], "아메리카노는 물의 양으로 맛이 진하거나 연해져요.": [921.31, 924.51], "커피는 몇 mL일까요?": [924.63, 926.24], "100과 200 사이 가운데 눈금이에요.": [926.36, 928.71], "커피를 정해진 양만큼 담아요.": [928.83, 931.01], "라떼에 우유 300mL가 필요해요. 지금 200mL예요. 어떻게 할까요?": [931.13, 936.98], "우유가 빨간 점선까지 오지 않았어요.": [937.1, 939.75], "모자라면 빨간 선까지 더 부어요.": [939.87, 942.33], "더 많이 담긴 컵은 어느 것일까요?": [942.45, 944.7], "두 컵의 눈금 숫자를 읽고 비교해요.": [944.82, 947.37], "mL 숫자가 클수록 양이 많아요.": [947.49, 949.84], "수족관 사육사는 어항의 물을 L(리터)로 재요. 많은 양은 L로, 적은 양은 mL로 재요. 1L는 1000mL예요.": [949.96, 958.52], "어항의 물은 몇 L일까요?": [958.64, 960.23], "물 윗면과 같은 높이의 숫자를 읽어요.": [960.35, 962.84], "사육사는 물고기 수에 맞게 물의 양을 맞춰요.": [962.96, 965.91], "물통의 물은 몇 L일까요?": [966.03, 967.78], "물 윗면 옆 숫자를 읽어요.": [967.9, 969.81], "큰 물통의 물은 L로 재요.": [969.93, 971.93], "1L는 몇 mL일까요?": [972.05, 973.75], "1L는 아주 많은 양이에요. 1 뒤에 0이 3개 붙어요.": [973.87, 978.11], "1L는 1000mL예요. 큰 우유갑 하나가 1L예요.": [978.23, 982.49], "우유 한 컵의 양에 알맞은 단위는 무엇일까요?": [982.61, 985.41], "한 컵은 적은 양이에요. 적은 양은 mL로 재요.": [985.53, 989.37], "200L라면 욕조를 가득 채울 만큼이에요!": [989.49, 992.44], "욕조에 받은 물의 양에 알맞은 단위는 무엇일까요?": [992.56, 995.61], "욕조는 아주 커요. 많은 양은 L로 재요.": [995.73, 999.14], "욕조처럼 큰 그릇의 물은 L로 재요.": [999.26, 1001.86], "간호사는 체온계로 몸의 온도를 재서 열이 나는지 알아봐요. 요리사는 오븐 온도를, 도예가는 가마 온도를 맞춰요. 온도는 ℃(도)로 읽어요.": [1001.98, 1011.83], "오늘 기온은 몇 도일까요?": [1011.95, 1013.62], "빨간 기둥 끝이 20과 30 사이 가운데에 있어요.": [1013.74, 1017.14], "기온을 알면 어떤 옷을 입을지 정할 수 있어요.": [1017.26, 1020.08], "체온이 36.5도예요. 37.5도부터 열이에요. 열이 있나요?": [1020.2, 1026.1], "36.5는 37.5보다 낮아요.": [1026.22, 1029.02], "36.5도쯤이 건강한 사람의 체온이에요.": [1029.14, 1032.18], "체온이 38.2도예요. 열이 있나요?": [1032.3, 1035.63], "38.2는 37.5보다 높아요.": [1035.75, 1038.57], "열이 나면 보건 선생님께 알리고 쉬어야 해요.": [1038.69, 1041.75], "추운 날 기온은 몇 도일까요?": [1041.87, 1043.79], "빨간 기둥이 아주 짧아요. 0과 10 사이 가운데예요.": [1043.91, 1047.99], "추운 날에는 두꺼운 옷을 입어요.": [1048.11, 1050.3], "물이 펄펄 끓을 때 온도는 몇 도쯤일까요?": [1050.42, 1053.2], "아주 뜨거운 온도를 골라요.": [1053.32, 1055.2], "물은 약 100도에서 끓어요. 0도에서는 얼음이 돼요.": [1055.32, 1059.39], "재단사는 천 두 장을 이어 붙여 옷을 만들어요. 이어 붙인 길이는 두 길이를 더해서 구해요.": [1059.51, 1065.62], "40cm 천과 30cm 천을 이어 붙였어요. 모두 몇 cm일까요?": [1065.74, 1071.24], "두 길이를 더해요.": [1071.36, 1072.63], "재단사는 천 길이를 더해서 옷 길이를 정해요.": [1072.75, 1075.86], "25cm 끈 2개를 이어서 허리끈을 만들어요. 모두 몇 cm일까요?": [1075.98, 1081.14], "25와 25를 더해요. 20+20=40, 5+5=10이에요.": [1081.26, 1087.18], "허리끈 길이가 맞아야 치마가 흘러내리지 않아요.": [1087.3, 1090.24], "커튼 천 60cm에 45cm를 이어 붙였어요. 모두 몇 cm일까요?": [1090.36, 1096.17], "60과 45를 더해요. 60+40=100, 거기에 5를 더해요.": [1096.29, 1101.86], "긴 커튼은 천을 이어 붙여서 만들어요.": [1101.98, 1104.5], "10cm 리본 3개를 이었어요. 모두 몇 cm일까요?": [1104.62, 1108.84], "10씩 세어 봐요. 10, 20, 30.": [1108.96, 1112.48], "리본을 이어서 선물 포장을 해요.": [1112.6, 1114.69], "바지 길이 80cm에 10cm를 더 늘렸어요. 바지는 몇 cm가 될까요?": [1114.81, 1120.44], "80에 10을 더해요.": [1120.56, 1122.02], "키가 크면 옷 길이를 늘려서 고쳐 입어요.": [1122.14, 1124.68], "목수는 긴 나무에서 필요한 만큼 잘라 써요. 남은 나무의 길이는 빼기로 구해요.": [1124.8, 1130.56], "100cm 나무에서 30cm를 잘랐어요. 남은 나무는 몇 cm일까요?": [1130.68, 1136.33], "전체 100cm에서 자른 30cm를 빼요.": [1136.45, 1139.76], "남은 나무로 다른 물건을 만들 수 있어요.": [1139.88, 1142.39], "90cm 나무에서 40cm를 잘랐어요. 남은 나무는 몇 cm일까요?": [1142.51, 1148.31], "90에서 40을 빼요. 9−4를 생각해 봐요.": [1148.43, 1152.22], "목수는 나무를 아껴 쓰려고 남은 길이를 계산해요.": [1152.34, 1155.54], "80cm 판자에서 25cm를 잘랐어요. 남은 판자는 몇 cm일까요?": [1155.66, 1161.58], "80에서 20을 빼고, 5를 더 빼요.": [1161.7, 1164.44], "선반 하나를 만들고 남은 판자로 작은 상자를 만들어요.": [1164.56, 1168.13], "120cm 나무에서 50cm를 잘랐어요. 남은 나무는 몇 cm일까요?": [1168.25, 1174.12], "120에서 50을 빼요. 100에서 50을 빼면 50, 거기에 20을 더해요.": [1174.24, 1179.89], "긴 나무는 잘라서 여러 곳에 나누어 써요.": [1180.01, 1182.63], "책상 다리를 70cm로 만들려고 해요. 85cm 나무에서 몇 cm를 잘라 내야 할까요?": [1182.75, 1189.56], "85에서 70을 빼면 잘라 낼 길이가 나와요.": [1189.68, 1192.87], "필요한 길이만 남기고 나머지를 잘라 내요.": [1192.99, 1195.95], "커튼 가게에서는 창문 길이를 m와 cm로 재요. 1m는 100cm예요. 1m 20cm는 100cm와 20cm를 합한 120cm예요.": [1196.07, 1208.1], "1m 20cm는 몇 cm일까요?": [1208.22, 1210.87], "1m는 100cm예요. 100에 20을 더해요.": [1210.99, 1214.93], "커튼 가게에서는 cm로 바꿔서 천을 잘라요.": [1215.05, 1218.39], "2m는 몇 cm일까요?": [1218.51, 1220.22], "1m가 100cm니까 100을 두 번 더해요.": [1220.34, 1223.7], "긴 커튼은 2m가 넘기도 해요.": [1223.82, 1226.04], "150cm는 몇 m 몇 cm일까요?": [1226.16, 1228.89], "100cm가 1m예요. 150cm는 100cm와 50cm예요.": [1229.01, 1235.29], "150cm를 1m 50cm라고도 말해요.": [1235.41, 1238.93], "1m 5cm는 몇 cm일까요?": [1239.05, 1241.49], "100에 5를 더해요. 150이 아니에요!": [1241.61, 1244.68], "5cm는 아주 짧아요. 1m 5cm는 105cm예요.": [1244.8, 1250.03], "창문 길이는 1m 40cm예요. 커튼은 창문보다 20cm 더 길게 만들어요. 커튼은 몇 cm일까요?": [1250.15, 1258.67], "1m 40cm는 140cm예요. 거기에 20cm를 더해요.": [1258.79, 1264.66], "커튼을 창문보다 조금 길게 하면 빛이 새지 않아요.": [1264.78, 1268.1], "택배 기사님은 상자 무게를 더해서 한 번에 옮길 수 있는지 계산해요. 제빵사는 그릇 무게를 빼고 재료 무게만 구해요.": [1268.22, 1276.45], "1kg 상자에 3kg 책을 넣었어요. 모두 몇 kg일까요?": [1276.57, 1281.41], "1과 3을 더해요.": [1281.53, 1282.94], "택배 기사님은 전체 무게를 알고 상자를 옮겨요.": [1283.06, 1286.47], "그릇에 밀가루를 담았더니 500g이에요. 그릇만 재면 200g이에요. 밀가루만 몇 g일까요?": [1286.59, 1293.99], "전체 무게에서 그릇 무게를 빼요.": [1294.11, 1296.37], "제빵사는 그릇 무게를 빼서 재료 무게만 알아내요.": [1296.49, 1299.65], "5kg 수박과 2kg 멜론을 한 봉지에 담았어요. 모두 몇 kg일까요?": [1299.77, 1305.25], "5와 2를 더해요.": [1305.37, 1306.68], "무거운 봉지는 두 개로 나누어 들어요.": [1306.8, 1309.23], "택배 상자는 10kg까지 보낼 수 있어요. 지금 6kg이에요. 몇 kg 더 넣을 수 있을까요?": [1309.35, 1316.89], "10에서 6을 빼요.": [1317.01, 1318.38], "정해진 무게를 넘지 않게 담아야 택배를 보낼 수 있어요.": [1318.5, 1322.04], "설탕 300g과 버터 250g을 그릇에 넣었어요. 모두 몇 g일까요?": [1322.16, 1327.93], "300에 200을 더하고, 50을 더 더해요.": [1328.05, 1331.18], "재료 무게를 더하면 반죽 무게를 알 수 있어요.": [1331.3, 1334.35], "쌀가게와 마트에서는 무게를 kg과 g으로 말해요. 1kg은 1000g이에요.": [1334.47, 1340.32], "1kg은 몇 g일까요?": [1340.44, 1342.29], "1kg은 1 뒤에 0이 3개 붙어요.": [1342.41, 1344.98], "1kg은 1000g이에요. 큰 우유갑 하나쯤의 무게예요.": [1345.1, 1349.56], "2kg은 몇 g일까요?": [1349.68, 1351.49], "1000을 두 번 더해요.": [1351.61, 1353.03], "쌀 2kg은 2000g이에요.": [1353.15, 1355.44], "쌀 1kg 500g은 몇 g일까요?": [1355.56, 1358.33], "1kg은 1000g이에요. 1000에 500을 더해요.": [1358.45, 1362.39], "쌀가게는 g으로 바꿔서 봉지에 나누어 담아요.": [1362.51, 1365.54], "3000g은 몇 kg일까요?": [1365.66, 1367.57], "1000g이 1kg이에요. 1000g이 몇 개인지 세어 봐요.": [1367.69, 1372.14], "3000g은 3kg이에요. kg으로 말하면 더 간단해요.": [1372.26, 1377.13], "쌀 1kg을 500g 봉지에 나누어 담아요. 몇 봉지가 될까요?": [1377.25, 1382.21], "500과 500을 더하면 1000이에요.": [1382.33, 1384.53], "쌀가게는 큰 포대를 작은 봉지에 나누어 팔아요.": [1384.65, 1387.76], "요리사는 국을 끓일 때 물과 육수의 양을 더하고 빼요. 1L는 1000mL예요.": [1387.88, 1393.65], "물 500mL와 우유 300mL를 섞었어요. 모두 몇 mL일까요?": [1393.77, 1398.61], "500과 300을 더해요. 5+3을 생각해요.": [1398.73, 1402.73], "요리사는 재료의 양을 더해서 냄비 크기를 골라요.": [1402.85, 1406.06], "1L 우유에서 200mL를 따랐어요. 남은 우유는 몇 mL일까요?": [1406.18, 1411.05], "1L는 1000mL예요. 1000에서 200을 빼요.": [1411.17, 1414.97], "남은 양을 알면 장을 볼 때 무엇이 필요한지 알 수 있어요.": [1415.09, 1418.93], "육수 1L에 물 500mL를 더 넣었어요. 모두 몇 mL일까요?": [1419.05, 1423.66], "1000에 500을 더해요.": [1423.78, 1425.3], "국물이 짜면 물을 더 넣어 맛을 맞춰요.": [1425.42, 1427.95], "국을 끓이려면 물 900mL가 필요해요. 지금 600mL를 넣었어요. 몇 mL 더 넣어야 할까요?": [1428.07, 1435.34], "900에서 600을 빼요. 빨간 점선까지 몇 칸이 남았는지 세어도 돼요.": [1435.46, 1440.56], "정해진 양을 맞춰야 국 맛이 늘 똑같아요.": [1440.68, 1443.45], "물 2L에서 500mL를 썼어요. 남은 물은 몇 mL일까요?": [1443.57, 1448.32], "2L는 2000mL예요. 2000에서 500을 빼요.": [1448.44, 1452.44], "요리사는 남은 물로 다음 요리를 준비해요.": [1452.56, 1455.27], "똑같은 것을 여러 개 만들 때는 곱하기를 써요. 목수는 의자 다리 4개를, 제빵사는 케이크 여러 개를 만들어요.": [1455.39, 1462.84], "의자 다리 1개는 40cm예요. 다리 4개를 만들려면 나무가 몇 cm 필요할까요?": [1462.96, 1469.22], "40을 4번 더해요. 40, 80, 120, 160.": [1469.34, 1474.54], "목수는 필요한 나무 길이를 미리 계산해서 사요.": [1474.66, 1477.65], "케이크 1개에 밀가루 200g이 들어가요. 케이크 2개를 만들려면 몇 g이 필요할까요?": [1477.77, 1483.62], "200을 2번 더해요.": [1483.74, 1485.16], "제빵사는 만들 개수만큼 재료를 곱해서 준비해요.": [1485.28, 1488.53], "컵 3개에 우유를 200mL씩 담아요. 우유가 모두 몇 mL 필요할까요?": [1488.65, 1493.88], "200을 3번 더해요. 200, 400, 600.": [1494.0, 1498.1], "바리스타는 손님 수만큼 우유를 준비해요.": [1498.22, 1501.02], "2kg 상자가 5개 있어요. 모두 몇 kg일까요?": [1501.14, 1505.36], "2씩 5번 세어 봐요. 2, 4, 6, 8, 10.": [1505.48, 1510.36], "택배 기사님은 상자 수와 무게로 전체 무게를 알아요.": [1510.48, 1514.14], "선물 6개에 리본을 30cm씩 묶어요. 리본이 모두 몇 cm 필요할까요?": [1514.26, 1520.27], "30을 6번 더해요. 30, 60, 90, 120, 150, 180.": [1520.39, 1526.77], "포장하는 사람은 리본이 모자라지 않게 미리 계산해요.": [1526.89, 1530.61], "많은 양을 똑같이 나눌 때는 나누기를 써요. 바리스타는 우유를 여러 컵에, 도예가는 점토를 여러 덩이로 나눠요.": [1530.73, 1538.2], "우유 1L(1000mL)를 200mL 컵에 나누어 담아요. 몇 잔이 될까요?": [1538.32, 1542.78], "200mL씩 몇 번 들어가는지 세어요. 200, 400, 600, 800, 1000.": [1542.9, 1549.5], "바리스타는 우유 한 통으로 몇 잔을 만들 수 있는지 알아요.": [1549.62, 1553.03], "리본 120cm를 30cm씩 잘라요. 몇 개가 될까요?": [1553.15, 1558.23], "30씩 세어 120이 될 때까지 몇 번인지 봐요. 30, 60, 90, 120.": [1558.35, 1564.87], "리본을 똑같이 잘라 선물마다 하나씩 묶어요.": [1564.99, 1568.33], "점토 2kg(2000g)을 500g씩 나누어 그릇을 만들어요. 그릇을 몇 개 만들 수 있을까요?": [1568.45, 1574.35], "500씩 세어 봐요. 500, 1000, 1500, 2000.": [1574.47, 1578.98], "도예가는 점토를 똑같은 무게로 나누어 같은 크기 그릇을 만들어요.": [1579.1, 1583.1], "나무 90cm를 똑같이 3도막으로 잘라요. 한 도막은 몇 cm일까요?": [1583.22, 1588.69], "어떤 수를 3번 더하면 90이 될까요? 30+30+30을 생각해요.": [1588.81, 1594.8], "목수는 나무를 똑같이 나누어 선반 칸을 만들어요.": [1594.92, 1598.19], "쌀 3kg을 3봉지에 똑같이 나누어요. 한 봉지는 몇 kg일까요?": [1598.31, 1603.53], "3을 셋으로 똑같이 나누면 하나에 몇일까요?": [1603.65, 1606.53], "똑같이 나누면 모두 같은 양을 받아요.": [1606.65, 1609.04], "이제 여러 직업 사람이 되어 재고 계산해 봐요. 두 번 계산해야 하는 문제도 있어요. 천천히 하나씩 풀어 봐요.": [1609.16, 1617.04], "🏺 도예가: 점토 1kg으로 컵을 만들어요. 컵 1개에 점토 200g이 들어가요. 컵을 몇 개 만들 수 있을까요?": [1617.16, 1625.99], "1kg은 1000g이에요. 200씩 세어 1000까지 가 봐요.": [1626.11, 1630.5], "도예가는 점토 무게로 몇 개를 만들지 정해요.": [1630.62, 1634.81], "🪑 목수: 의자 다리 45cm 4개와 등받이 50cm 1개를 만들어요. 나무가 모두 몇 cm 필요할까요?": [1634.93, 1642.29], "먼저 다리 4개 길이를 구해요. 45, 90, 135, 180. 그다음 등받이 50을 더해요.": [1642.41, 1651.15], "목수는 필요한 나무를 모두 더해서 한 번에 준비해요.": [1651.27, 1654.66], "🍪 제빵사: 쿠키 1판에 버터 150g이 들어가요. 버터 500g으로 쿠키 2판을 만들면 버터가 몇 g 남을까요?": [1654.78, 1662.56], "2판에 쓰는 버터는 150+150=300g이에요. 500에서 300을 빼요.": [1662.68, 1669.0], "남은 재료를 알면 다음에 무엇을 만들지 정할 수 있어요.": [1669.12, 1672.6], "✂️ 재단사: 치마 길이는 60cm예요. 위와 아래에 접어서 꿰맬 부분이 5cm씩 더 필요해요. 천은 몇 cm 필요할까요?": [1672.72, 1682.17], "5와 60과 5를 모두 더해요.": [1682.29, 1684.43], "재단사는 접는 부분까지 생각해서 천을 넉넉히 잘라요.": [1684.55, 1688.36], "☕ 바리스타: 우유 1L로 라떼를 만들어요. 라떼 1잔에 우유 250mL가 들어가요. 몇 잔을 만들 수 있을까요?": [1688.48, 1696.71], "250씩 세어 봐요. 250, 500, 750, 1000.": [1696.83, 1702.0], "바리스타는 우유가 몇 잔 분량인지 알고 미리 준비해요.": [1702.12, 1705.59], "🚚 택배 기사: 상자 3개의 무게가 2kg, 3kg, 4kg이에요. 모두 몇 kg일까요?": [1705.71, 1712.14], "2와 3을 더하고, 4를 더 더해요.": [1712.26, 1714.89], "택배 기사님은 차에 실은 전체 무게를 알아야 안전해요.": [1715.01, 1718.59], "🩺 보건 선생님: 1학기 키는 128cm, 2학기 키는 133cm예요. 몇 cm 컸을까요?": [1718.71, 1726.29], "133에서 128을 빼요. 두 선 사이 칸을 세어도 돼요.": [1726.41, 1731.1], "다시 생각해 봐요.": [0, 1.27], "색깔과 그림을 잘 봐요.": [1.39, 3.3], "반짝이는 곳을 봐요.": [3.42, 4.85], "흐린 숫자를 따라 눌러 봐요.": [4.97, 6.8], "빈칸에 숫자를 써요.": [6.92, 8.45], "맞아요.": [8.57, 9.24], "참 잘했어요.": [9.36, 10.45], "옷가게 직원은 손님에게 맞는 옷을 골라 줘요. 바지나 목도리의 길이를 비교해서 더 긴 것과 짧은 것을 찾아요": [10.57, 18.2], "가장 긴 바지는 어느 것일까요?.": [18.32, 20.33], "바지 아래쪽 끝이 똑같이 맞춰져 있어요. 위쪽 끝이 가장 높은 바지를 찾아요": [20.45, 26.25], "긴 바지는 키가 큰 손님에게 맞아요. 옷가게에서는 길이를 비교해서 옷을 골라 줘요": [26.37, 32.37], "가장 짧은 목도리는 어느 것일까요?.": [32.49, 34.81], "왼쪽 끝이 맞춰져 있어요. 오른쪽 끝이 가장 덜 나온 목도리를 찾아요": [34.93, 40.16], "짧은 목도리는 어린이에게 알맞아요": [40.28, 42.68], "키가 가장 큰 친구는 누구일까요?.": [42.8, 45.02], "세 친구 모두 같은 바닥에 서 있어요. 머리 꼭대기가 가장 높은 친구를 찾아요": [45.14, 50.73], "옷가게에서는 키를 보고 옷 크기를 골라요. 키가 크면 더 큰 옷이 필요해요": [50.85, 56.12], "어느 끈이 더 길까요?.": [56.24, 57.71], "끝이 맞춰져 있지 않아요. 왼쪽 끝을 똑같이 맞추고 비교해야 해요": [57.83, 62.59], "길이를 비교할 때는 한쪽 끝을 똑같이 맞춰요. 옷가게에서도 옷을 겹쳐서 끝을 맞춰 봐요": [62.71, 69.14], "손님 팔 길이와 똑같은 소매는 어느 것일까요?.": [69.26, 72.24], "회색 팔과 오른쪽 끝이 똑같이 끝나는 소매를 찾아요": [72.36, 75.96], "소매가 팔 길이와 같아야 옷이 편해요. 옷을 고칠 때도 팔 길이와 비교해요": [76.08, 81.54], "목수는 나무로 책상과 의자를 만들어요. 자가 없을 때는 손을 쫙 펴서 한 뼘, 두 뼘 하고 길이를 재요": [81.66, 89.14], "책상의 긴 쪽은 몇 뼘일까요?.": [89.26, 91.31], "손 모양 하나가 한 뼘이에요. 손 모양을 하나씩 세어 봐요": [91.43, 95.65], "목수는 뼘으로 대강 길이를 재고, 어떤 책상을 만들지 생각해요": [95.77, 100.06], "나무 판자는 몇 뼘일까요?.": [100.18, 102.05], "왼쪽부터 손 모양을 하나씩 짚으며 세어 봐요": [102.17, 105.11], "판자 길이를 알면 무엇을 만들 수 있을지 정할 수 있어요": [105.23, 108.81], "의자의 높이는 몇 뼘일까요?.": [108.93, 110.8], "바닥부터 위로 손 모양을 세어 봐요": [110.92, 113.23], "의자 높이가 알맞아야 편하게 앉을 수 있어요": [113.35, 116.32], "책상은 선반보다 몇 뼘 더 길까요?.": [116.44, 118.85], "책상은 몇 뼘, 선반은 몇 뼘인지 따로 세고 비교해요": [118.97, 122.62], "목수는 두 나무의 길이를 비교해서 얼마나 더 필요한지 알아내요": [122.74, 126.8], "책장의 너비는 4뼘하고 조금 더 남아요. 약 몇 뼘이라고 할까요?.": [126.92, 131.75], "손 모양이 4개 있고 아주 조금 남았어요": [131.87, 134.81], "딱 맞지 않을 때는 \"약 몇 뼘\"이라고 어림해요. 목수도 처음에는 어림해서 재요": [134.93, 140.86], "농부는 밭에 씨앗을 심기 전에 밭의 길이를 걸음으로 재요. 한 걸음, 두 걸음 세며 걸어요": [140.98, 147.62], "배추밭의 길이는 몇 걸음일까요?.": [147.74, 149.95], "발자국 하나가 한 걸음이에요. 하나씩 세어 봐요": [150.07, 153.9], "밭 길이를 알면 씨앗을 몇 줄 심을지 정할 수 있어요": [154.02, 157.36], "꽃밭의 길이는 몇 걸음일까요?.": [157.48, 159.55], "발자국을 왼쪽부터 손가락으로 짚으며 세어 봐요": [159.67, 162.94], "정원사도 걸음으로 꽃밭 크기를 어림해요": [163.06, 165.8], "두 밭 중 어느 밭이 더 길까요?.": [165.92, 167.89], "두 밭의 걸음 수를 각각 세어 비교해요. 걸음 수가 많으면 더 길어요": [168.01, 172.99], "같은 사람이 걸었으니까 걸음 수가 많은 밭이 더 길어요": [173.11, 176.96], "고구마밭은 몇 걸음일까요?.": [177.08, 178.9], "발자국이 많아요. 다섯까지 센 다음 이어서 세어 봐요": [179.02, 183.17], "밭이 길면 걸음 수도 많아져요": [183.29, 185.57], "울타리는 5걸음하고 조금 더 남아요. 약 몇 걸음일까요?.": [185.69, 190.21], "발자국 5개에 아주 조금 남았어요": [190.33, 192.91], "딱 맞지 않을 때는 \"약 몇 걸음\"이라고 말해요": [193.03, 196.03], "도예가는 흙으로 그릇과 꽃병을 만들어요. 여러 개를 비슷한 크기로 만들려고 높이와 길이를 재요. 블록이나 클립을 이어서 재 볼까요?.": [196.15, 205.39], "꽃병의 높이는 블록 몇 개일까요?.": [205.51, 207.82], "아래부터 블록을 하나씩 세어 봐요": [207.94, 210.2], "도예가는 꽃병 높이를 재서 같은 크기로 여러 개를 만들어요": [210.32, 214.09], "컵의 높이는 블록 몇 개일까요?.": [214.21, 216.38], "블록이 컵 꼭대기까지 몇 개 쌓였는지 세어요": [216.5, 219.47], "컵 높이가 같아야 세트로 팔 수 있어요": [219.59, 222.16], "붓의 길이는 클립 몇 개일까요?.": [222.28, 224.22], "붓 아래에 있는 클립을 하나씩 세어 봐요": [224.34, 226.83], "도예가는 붓으로 그릇에 그림을 그려요": [226.95, 229.68], "항아리는 꽃병보다 블록 몇 개 더 높을까요?.": [229.8, 232.72], "꽃병 블록과 항아리 블록을 각각 세고 몇 개 차이인지 봐요": [232.84, 236.73], "높이를 비교하면 어느 쪽을 더 크게 만들었는지 알 수 있어요": [236.85, 240.51], "접시의 길이는 클립 몇 개일까요?.": [240.63, 242.72], "클립을 왼쪽부터 세어 봐요": [242.84, 244.74], "접시 크기를 재면 그릇장에 들어갈지 알 수 있어요": [244.86, 248.08], "요리사는 밥을 지을 때 쌀과 물을 컵으로 재요. 컵 수가 알맞아야 밥이 맛있게 돼요": [248.2, 254.17], "냄비에 물을 몇 컵 부었을까요?.": [254.29, 256.34], "컵을 하나씩 세어 봐요": [256.46, 258.08], "물을 컵으로 재면 매번 같은 맛을 낼 수 있어요": [258.2, 261.38], "밥솥에 쌀을 몇 컵 넣었을까요?.": [261.5, 263.8], "쌀이 담긴 컵을 세어요": [263.92, 265.55], "먹을 사람 수에 맞게 쌀 컵 수를 정해요": [265.67, 268.49], "물은 쌀보다 1컵 더 넣어요. 물은 몇 컵 넣을까요?.": [268.61, 272.71], "쌀 2컵에 1컵을 더해요": [272.83, 274.77], "쌀과 물의 양을 맞추면 밥이 질지도 되지도 않아요": [274.89, 278.26], "물이 더 많이 들어간 냄비는 어느 것일까요?.": [278.38, 281.04], "두 냄비에 부은 컵 수를 세어 비교해요": [281.16, 283.58], "같은 컵으로 부었으니 컵 수가 많은 쪽에 물이 더 많아요": [283.7, 287.35], "큰 냄비를 채우려면 5컵이 필요해요. 3컵 부었어요. 몇 컵 더 부어야 할까요?.": [287.47, 294.21], "점선 컵이 더 부어야 할 컵이에요. 점선 컵을 세어 봐요": [294.33, 298.65], "얼마나 더 필요한지 알면 넘치지 않게 부을 수 있어요": [298.77, 302.19], "카페 바리스타는 컵 크기에 맞게 음료를 담아요. 어느 컵에 물이 더 많이 들어가는지 비교해 봐요": [302.31, 308.93], "물이 더 많이 담긴 컵은 어느 것일까요?.": [309.05, 311.55], "두 컵의 크기가 똑같아요. 물의 높이를 비교해요": [311.67, 315.63], "크기가 같은 컵이면 물이 높이 찬 쪽이 더 많아요": [315.75, 319.02], "물이 가장 적게 담긴 컵은 어느 것일까요?.": [319.14, 321.85], "물의 높이가 가장 낮은 컵을 찾아요": [321.97, 324.44], "손님이 조금만 달라고 하면 적게 담아요": [324.56, 327.34], "두 병의 물을 똑같은 컵에 따랐어요. 어느 병에 물이 더 많았을까요?.": [327.46, 332.43], "병에서 나온 컵 수를 세어 비교해요": [332.55, 334.86], "같은 컵으로 재면 어느 그릇에 더 많이 들어가는지 알 수 있어요": [334.98, 338.77], "두 컵의 물 높이가 같아요. 물이 더 많은 컵은 어느 것일까요?.": [338.89, 343.5], "물 높이가 같으면 더 넓은 컵에 물이 더 많아요": [343.62, 346.91], "컵이 넓으면 같은 높이라도 물이 더 많이 들어가요": [347.03, 350.17], "작은 컵 2개로 큰 컵 1개가 가득 차요. 큰 컵 2개를 채우려면 작은 컵이 몇 개 필요할까요?.": [350.29, 357.2], "큰 컵 하나에 작은 컵 2개씩이에요. 2개씩 두 번 세어 봐요": [357.32, 361.9], "바리스타는 컵 크기를 알고 음료 양을 맞춰요": [362.02, 364.98], "과일가게 사장님은 저울로 과일 무게를 비교해요. 양팔저울에서는 무거운 쪽이 아래로 내려가요": [365.1, 371.69], "더 무거운 과일은 무엇일까요?.": [371.81, 373.87], "저울이 아래로 내려간 쪽을 봐요": [373.99, 376.07], "수박이 사과보다 무거워서 저울이 수박 쪽으로 내려갔어요": [376.19, 379.73], "더 가벼운 과일은 무엇일까요?.": [379.85, 381.92], "위로 올라간 쪽이 더 가벼워요": [382.04, 384.11], "가벼운 쪽은 위로 올라가요": [384.23, 386.03], "두 쪽의 무게는 어떤가요?.": [386.15, 387.96], "저울이 어느 쪽으로도 기울지 않았어요": [388.08, 390.52], "저울이 평평하면 양쪽 무게가 같아요": [390.64, 393.33], "가장 무거운 과일은 무엇일까요?.": [393.45, 395.67], "사과는 딸기보다 무겁고, 멜론은 사과보다 무거워요": [395.79, 399.51], "두 번 비교해서 가장 무거운 것을 찾았어요": [399.63, 402.54], "수박 1통은 멜론 몇 개와 무게가 같을까요?.": [402.66, 405.62], "저울이 평평해요. 오른쪽 멜론을 세어 봐요": [405.74, 409.33], "과일가게에서는 저울로 무게를 맞춰 팔아요": [409.45, 412.26], "옛날 시장에서는 돌을 저울에 올려 무게를 쟀어요. 바둑돌 몇 개와 무게가 같은지 세어 봐요": [412.38, 418.77], "사과는 바둑돌 몇 개와 무게가 같을까요?.": [418.89, 421.7], "저울이 평평해요. 오른쪽 바둑돌을 하나씩 세어 봐요": [421.82, 425.91], "사과의 무게는 바둑돌 6개만큼이에요": [426.03, 428.86], "귤은 바둑돌 몇 개와 무게가 같을까요?.": [428.98, 431.57], "바둑돌을 하나씩 짚으며 세어 봐요": [431.69, 433.94], "귤은 사과보다 가벼워서 바둑돌이 더 적어요": [434.06, 437.22], "감자는 바둑돌 8개, 양파는 바둑돌 5개와 무게가 같아요. 더 무거운 것은 무엇일까요?.": [437.34, 444.35], "바둑돌이 많을수록 더 무거워요": [444.47, 446.68], "바둑돌 수를 비교하면 어느 것이 더 무거운지 알 수 있어요": [446.8, 450.35], "감자는 양파보다 바둑돌 몇 개만큼 더 무거울까요?.": [450.47, 453.96], "8개와 5개의 차이를 세어 봐요": [454.08, 456.48], "무게의 차이도 바둑돌로 알 수 있어요": [456.6, 459.03], "배 쪽으로 저울이 내려갔어요. 배는 바둑돌 5개보다 어떨까요?.": [459.15, 463.95], "내려간 쪽이 더 무거워요": [464.07, 465.84], "저울이 기울면 두 쪽의 무게가 다르다는 뜻이에요": [465.96, 469.05], "가구점에 책상을 주문할 때 \"5뼘짜리 주세요\" 하면 어떻게 될까요? 사람마다 손 크기가 달라서 길이가 달라져요. 그래서 모두가 똑같이 쓰는 단위가 필요해요": [469.17, 480.36], "같은 책상을 아빠 뼘과 월이 뼘으로 쟀어요. 누구 뼘으로 잰 수가 더 많을까요?.": [480.48, 486.11], "두 줄의 손 모양 수를 각각 세어 봐요": [486.23, 488.66], "월이 손이 작아서 더 많이 재야 해요. 같은 책상인데 수가 달라졌어요!.": [488.78, 493.96], "같은 물을 큰 컵으로 2컵, 작은 컵으로 4컵 담았어요. 어느 컵이 더 클까요?.": [494.08, 499.72], "컵이 클수록 적은 수로도 다 담을 수 있어요": [499.84, 502.58], "컵 크기가 다르면 같은 물이라도 컵 수가 달라져요": [502.7, 506.2], "\"5뼘짜리 책상 주세요\" 하고 주문하면 어떻게 될까요?.": [506.32, 509.98], "아빠 뼘과 월이 뼘으로 잰 수가 달랐던 것을 생각해요": [510.1, 513.54], "그래서 가게에서는 누구나 똑같이 쓰는 cm로 주문해요": [513.66, 517.24], "누구나 똑같은 길이로 재려면 무엇을 쓸까요?.": [517.36, 520.3], "사람마다 달라지지 않는 도구를 찾아요": [520.42, 522.97], "자는 누가 써도 1cm가 똑같아요": [523.09, 525.83], "누구나 똑같은 무게로 재려면 무엇을 쓸까요?.": [525.95, 528.94], "눈금이 있어서 누가 재도 같은 도구를 찾아요": [529.06, 531.87], "저울은 누가 재도 같은 무게가 나와요": [531.99, 534.38], "누구나 똑같은 양으로 재려면 무엇을 쓸까요?.": [534.5, 537.48], "눈금이 그려진 컵을 찾아요": [537.6, 539.51], "계량컵에는 눈금이 있어서 늘 같은 양을 잴 수 있어요": [539.63, 542.97], "재단사는 옷을 만드는 사람이에요. 자로 천과 리본의 길이를 cm로 재요. 물건 끝을 자의 0에 맞추고, 다른 끝의 눈금을 읽어요": [543.09, 552.68], "리본의 길이는 몇 cm일까요?.": [552.8, 554.76], "리본 끝이 0에 맞춰져 있어요. 오른쪽 끝에 있는 숫자를 읽어요": [554.88, 559.67], "재단사는 리본을 cm로 재서 옷에 딱 맞게 달아요": [559.79, 563.23], "연필의 길이는 몇 cm일까요?.": [563.35, 565.35], "연필 뾰족한 끝이 가리키는 숫자를 읽어요": [565.47, 568.39], "재단사는 연필로 천에 자를 곳을 표시해요": [568.51, 571.44], "지우개의 길이는 몇 cm일까요?.": [571.56, 573.66], "지우개 오른쪽 끝 아래 숫자를 읽어요": [573.78, 576.34], "작은 물건도 자로 정확하게 잴 수 있어요": [576.46, 579.43], "실의 길이는 몇 cm일까요?.": [579.55, 581.39], "실 끝에서 내려온 점선이 가리키는 숫자를 읽어요": [581.51, 584.69], "옷을 꿰맬 때 실을 알맞은 길이로 잘라요": [584.81, 587.61], "단추를 꿴 줄의 길이는 몇 cm일까요?.": [587.73, 590.23], "줄의 오른쪽 끝 점선을 따라 내려가 숫자를 읽어요": [590.35, 593.53], "단추 사이 길이를 재서 옷에 고르게 달아요": [593.65, 596.37], "목수의 자는 끝이 닳아 있기도 해요. 그럴 때는 중간 눈금부터 재요. 1cm 칸이 몇 개인지 세면 길이를 알 수 있어요": [596.49, 605.5], "나무 막대의 길이는 몇 cm일까요?.": [605.62, 607.86], "막대가 2에서 시작해서 7에서 끝나요. 1cm 칸을 세어 봐요": [607.98, 612.94], "목수는 끝 눈금에서 시작 눈금을 빼서 길이를 구해요": [613.06, 616.5], "못의 길이는 몇 cm일까요?.": [616.62, 618.43], "못이 1에서 시작해요. 4까지 1cm 칸이 몇 개인지 세어요": [618.55, 623.47], "못 길이가 알맞아야 나무를 튼튼하게 붙일 수 있어요": [623.59, 626.87], "나무 조각의 길이는 몇 cm일까요?.": [626.99, 629.21], "3에서 시작해서 11에서 끝나요. 칸을 세어 봐요": [629.33, 633.4], "짧은 나무 조각도 길이를 재서 버리지 않고 써요": [633.52, 636.6], "의자 다리 모형의 길이는 몇 cm일까요?.": [636.72, 639.27], "5에서 시작해서 14에서 끝나요": [639.39, 641.69], "의자 다리 4개의 길이가 똑같아야 의자가 흔들리지 않아요": [641.81, 645.44], "연필이 4에서 시작해요. 10까지 칸을 세어 봐요": [645.56, 649.45], "시작이 0이 아니어도 칸을 세면 길이를 알 수 있어요": [649.57, 652.93], "집을 짓는 사람은 긴 것은 m(미터)로, 짧은 것은 cm(센티미터)로 재요. 1m는 100cm예요": [653.05, 659.92], "1m는 몇 cm일까요?.": [660.04, 661.8], "1m 막대에 10cm 칸이 10개 있어요. 10씩 세어 봐요": [661.92, 666.64], "1m는 100cm예요. 건축가는 긴 길이를 m로 말해요": [666.76, 671.6], "연필 길이에 알맞은 단위는 무엇일까요?.": [671.72, 674.32], "연필은 짧아요. 짧은 것은 cm로 재요": [674.44, 678.12], "손에 쥐는 작은 물건은 cm로 재요": [678.24, 680.79], "교실 긴 쪽의 길이에 알맞은 단위는 무엇일까요?.": [680.91, 684.02], "교실은 아주 길어요. 긴 것은 m로 재요": [684.14, 687.58], "건축가는 방의 크기를 m로 재서 설계도를 그려요": [687.7, 690.96], "문 높이에 알맞은 단위는 무엇일까요?.": [691.08, 693.46], "문은 사람보다 커요. 2cm라면 손가락보다 짧아요!.": [693.58, 698.34], "문 높이는 약 2m예요. 200cm라고도 말해요": [698.46, 702.83], "휴대폰 길이에 알맞은 단위는 무엇일까요?.": [702.95, 705.48], "휴대폰은 손에 쥘 만큼 짧아요": [705.6, 707.98], "15m라면 버스보다 긴 휴대폰이 돼요!.": [708.1, 710.97], "1m보다 긴 것은 무엇일까요?.": [711.09, 713.28], "1m는 어른 한 걸음쯤이에요. 그보다 긴 것을 찾아요": [713.4, 717.68], "버스는 길이가 약 11m예요": [717.8, 720.08], "보건 선생님과 간호사는 키와 몸무게를 재서 우리가 건강하게 자라는지 살펴봐요. 키는 cm, 몸무게는 kg으로 재요": [720.2, 728.25], "월이의 키는 몇 cm일까요?.": [728.37, 730.17], "빨간 선 아래쪽 큰 숫자 130을 찾고, 작은 눈금을 더 세어 봐요": [730.29, 735.13], "보건 선생님은 키를 재서 건강 기록에 적어요": [735.25, 738.62], "120과 130 사이 가운데 긴 눈금이 125예요": [740.67, 744.42], "키가 자라면 책상과 의자 높이도 맞춰 바꿔요": [744.54, 747.73], "아리의 몸무게는 몇 kg일까요?.": [747.85, 749.97], "바늘이 30을 조금 지났어요. 30에서 작은 눈금을 세어요": [750.09, 754.85], "몸무게를 재면 건강하게 자라는지 알 수 있어요": [754.97, 757.88], "월이의 몸무게는 몇 kg일까요?.": [758.0, 760.15], "바늘이 30보다 조금 덜 갔어요. 20에서 작은 눈금을 세어 봐요": [760.27, 765.27], "보건실 체중계는 kg으로 몸무게를 알려 줘요": [765.39, 768.53], "지난봄 월이 키는 128cm였어요. 지금은 132cm예요. 몇 cm 컸을까요?.": [768.65, 776.26], "파란 점선과 빨간 선 사이의 작은 눈금 칸을 세어 봐요": [776.38, 780.12], "키를 재서 비교하면 얼마나 자랐는지 알 수 있어요": [780.24, 783.4], "제빵사는 밀가루와 설탕을 g(그램)으로 재요. 조금만 달라져도 빵 맛이 달라지기 때문에 저울을 꼭 써요": [783.52, 790.59], "밀가루의 무게는 몇 g일까요?.": [790.71, 792.74], "바늘이 가리키는 큰 숫자를 읽어요": [792.86, 795.12], "빵 반죽에는 밀가루를 정확하게 넣어야 해요": [795.24, 798.13], "설탕의 무게는 몇 g일까요?.": [798.25, 800.21], "바늘이 100과 200 사이 가운데에 있어요. 가운데는 150이에요": [800.33, 805.23], "설탕을 너무 많이 넣으면 빵이 너무 달아져요": [805.35, 808.4], "버터의 무게는 몇 g일까요?.": [808.52, 810.44], "400과 500 사이 가운데 눈금이에요": [810.56, 813.04], "버터를 재서 넣으면 쿠키가 늘 똑같이 고소해요": [813.16, 816.52], "밀가루 500g이 필요한데 저울은 400g이에요. 어떻게 할까요?.": [816.64, 821.59], "400은 500보다 작아요. 모자라요": [821.71, 824.98], "모자라면 더 넣고, 많으면 덜어 내요": [825.1, 828.01], "초콜릿의 무게는 몇 g일까요?.": [828.13, 830.19], "바늘 끝에 있는 큰 숫자를 읽어요": [830.31, 832.52], "제빵사는 초콜릿 무게를 재서 케이크를 만들어요": [832.64, 835.78], "택배 기사님은 상자의 무게를 kg(킬로그램)으로 재요. 무거운 상자는 배달비가 더 들고, 조심해서 옮겨요": [835.9, 842.98], "상자의 무게는 몇 kg일까요?.": [843.1, 845.23], "바늘이 가리키는 숫자를 읽어요": [845.35, 847.39], "택배 기사님은 상자 무게를 보고 배달비를 정해요": [847.51, 851.19], "수박의 무게는 몇 kg일까요?.": [851.31, 853.37], "바늘 끝 숫자를 읽어요": [853.49, 855.11], "시장 상인도 수박을 kg으로 재서 팔아요": [855.23, 858.04], "쌀 포대의 무게는 몇 kg일까요?.": [858.16, 860.38], "바늘이 10을 지났어요. 10에서 작은 눈금을 세어 봐요": [860.5, 864.74], "무거운 쌀 포대는 둘이 함께 들어요": [864.86, 867.35], "5kg보다 무거운 상자는 배달비가 더 들어요. 이 상자는 어떨까요?.": [867.47, 872.66], "바늘이 5보다 더 많이 돌아갔어요": [872.78, 875.07], "7kg은 5kg보다 무거워서 배달비가 더 들어요": [875.19, 878.79], "사과 1개의 무게에 알맞은 단위는 무엇일까요?.": [878.91, 881.92], "사과는 가벼워요. 가벼운 것은 g으로 재요": [882.04, 885.77], "1kg은 1000g이에요. 사과 300kg이면 사과 상자 수십 개만큼 무거워요!.": [885.89, 891.36], "수박 1통의 무게에 알맞은 단위는 무엇일까요?.": [891.48, 894.46], "수박은 무거워요. 무거운 것은 kg으로 재요": [894.58, 898.39], "6g이면 사탕 몇 개 무게예요. 수박은 6kg쯤이에요": [898.51, 903.22], "바리스타는 우유와 물을 mL(밀리리터)로 재요. 늘 같은 양을 넣어야 언제 마셔도 맛이 똑같아요": [903.34, 909.82], "우유는 몇 mL일까요?.": [909.94, 911.54], "우유 윗면과 같은 높이의 숫자를 읽어요": [911.66, 914.29], "라떼에는 우유를 정확하게 재서 넣어요": [914.41, 916.92], "물은 몇 mL일까요?.": [917.04, 918.44], "300과 400 사이 가운데 눈금이에요": [918.56, 921.19], "아메리카노는 물의 양으로 맛이 진하거나 연해져요": [921.31, 924.51], "커피는 몇 mL일까요?.": [924.63, 926.24], "100과 200 사이 가운데 눈금이에요": [926.36, 928.71], "커피를 정해진 양만큼 담아요": [928.83, 931.01], "라떼에 우유 300mL가 필요해요. 지금 200mL예요. 어떻게 할까요?.": [931.13, 936.98], "우유가 빨간 점선까지 오지 않았어요": [937.1, 939.75], "모자라면 빨간 선까지 더 부어요": [939.87, 942.33], "더 많이 담긴 컵은 어느 것일까요?.": [942.45, 944.7], "두 컵의 눈금 숫자를 읽고 비교해요": [944.82, 947.37], "mL 숫자가 클수록 양이 많아요": [947.49, 949.84], "수족관 사육사는 어항의 물을 L(리터)로 재요. 많은 양은 L로, 적은 양은 mL로 재요. 1L는 1000mL예요": [949.96, 958.52], "어항의 물은 몇 L일까요?.": [958.64, 960.23], "물 윗면과 같은 높이의 숫자를 읽어요": [960.35, 962.84], "사육사는 물고기 수에 맞게 물의 양을 맞춰요": [962.96, 965.91], "물통의 물은 몇 L일까요?.": [966.03, 967.78], "물 윗면 옆 숫자를 읽어요": [967.9, 969.81], "큰 물통의 물은 L로 재요": [969.93, 971.93], "1L는 몇 mL일까요?.": [972.05, 973.75], "1L는 아주 많은 양이에요. 1 뒤에 0이 3개 붙어요": [973.87, 978.11], "1L는 1000mL예요. 큰 우유갑 하나가 1L예요": [978.23, 982.49], "우유 한 컵의 양에 알맞은 단위는 무엇일까요?.": [982.61, 985.41], "한 컵은 적은 양이에요. 적은 양은 mL로 재요": [985.53, 989.37], "200L라면 욕조를 가득 채울 만큼이에요!.": [989.49, 992.44], "욕조에 받은 물의 양에 알맞은 단위는 무엇일까요?.": [992.56, 995.61], "욕조는 아주 커요. 많은 양은 L로 재요": [995.73, 999.14], "욕조처럼 큰 그릇의 물은 L로 재요": [999.26, 1001.86], "간호사는 체온계로 몸의 온도를 재서 열이 나는지 알아봐요. 요리사는 오븐 온도를, 도예가는 가마 온도를 맞춰요. 온도는 ℃(도)로 읽어요": [1001.98, 1011.83], "오늘 기온은 몇 도일까요?.": [1011.95, 1013.62], "빨간 기둥 끝이 20과 30 사이 가운데에 있어요": [1013.74, 1017.14], "기온을 알면 어떤 옷을 입을지 정할 수 있어요": [1017.26, 1020.08], "체온이 36.5도예요. 37.5도부터 열이에요. 열이 있나요?.": [1020.2, 1026.1], "36.5는 37.5보다 낮아요": [1026.22, 1029.02], "36.5도쯤이 건강한 사람의 체온이에요": [1029.14, 1032.18], "체온이 38.2도예요. 열이 있나요?.": [1032.3, 1035.63], "38.2는 37.5보다 높아요": [1035.75, 1038.57], "열이 나면 보건 선생님께 알리고 쉬어야 해요": [1038.69, 1041.75], "추운 날 기온은 몇 도일까요?.": [1041.87, 1043.79], "빨간 기둥이 아주 짧아요. 0과 10 사이 가운데예요": [1043.91, 1047.99], "추운 날에는 두꺼운 옷을 입어요": [1048.11, 1050.3], "물이 펄펄 끓을 때 온도는 몇 도쯤일까요?.": [1050.42, 1053.2], "아주 뜨거운 온도를 골라요": [1053.32, 1055.2], "물은 약 100도에서 끓어요. 0도에서는 얼음이 돼요": [1055.32, 1059.39], "재단사는 천 두 장을 이어 붙여 옷을 만들어요. 이어 붙인 길이는 두 길이를 더해서 구해요": [1059.51, 1065.62], "40cm 천과 30cm 천을 이어 붙였어요. 모두 몇 cm일까요?.": [1065.74, 1071.24], "두 길이를 더해요": [1071.36, 1072.63], "재단사는 천 길이를 더해서 옷 길이를 정해요": [1072.75, 1075.86], "25cm 끈 2개를 이어서 허리끈을 만들어요. 모두 몇 cm일까요?.": [1075.98, 1081.14], "25와 25를 더해요. 20+20=40, 5+5=10이에요": [1081.26, 1087.18], "허리끈 길이가 맞아야 치마가 흘러내리지 않아요": [1087.3, 1090.24], "커튼 천 60cm에 45cm를 이어 붙였어요. 모두 몇 cm일까요?.": [1090.36, 1096.17], "60과 45를 더해요. 60+40=100, 거기에 5를 더해요": [1096.29, 1101.86], "긴 커튼은 천을 이어 붙여서 만들어요": [1101.98, 1104.5], "10cm 리본 3개를 이었어요. 모두 몇 cm일까요?.": [1104.62, 1108.84], "10씩 세어 봐요. 10, 20, 30": [1108.96, 1112.48], "리본을 이어서 선물 포장을 해요": [1112.6, 1114.69], "바지 길이 80cm에 10cm를 더 늘렸어요. 바지는 몇 cm가 될까요?.": [1114.81, 1120.44], "80에 10을 더해요": [1120.56, 1122.02], "키가 크면 옷 길이를 늘려서 고쳐 입어요": [1122.14, 1124.68], "목수는 긴 나무에서 필요한 만큼 잘라 써요. 남은 나무의 길이는 빼기로 구해요": [1124.8, 1130.56], "100cm 나무에서 30cm를 잘랐어요. 남은 나무는 몇 cm일까요?.": [1130.68, 1136.33], "전체 100cm에서 자른 30cm를 빼요": [1136.45, 1139.76], "남은 나무로 다른 물건을 만들 수 있어요": [1139.88, 1142.39], "90cm 나무에서 40cm를 잘랐어요. 남은 나무는 몇 cm일까요?.": [1142.51, 1148.31], "90에서 40을 빼요. 9−4를 생각해 봐요": [1148.43, 1152.22], "목수는 나무를 아껴 쓰려고 남은 길이를 계산해요": [1152.34, 1155.54], "80cm 판자에서 25cm를 잘랐어요. 남은 판자는 몇 cm일까요?.": [1155.66, 1161.58], "80에서 20을 빼고, 5를 더 빼요": [1161.7, 1164.44], "선반 하나를 만들고 남은 판자로 작은 상자를 만들어요": [1164.56, 1168.13], "120cm 나무에서 50cm를 잘랐어요. 남은 나무는 몇 cm일까요?.": [1168.25, 1174.12], "120에서 50을 빼요. 100에서 50을 빼면 50, 거기에 20을 더해요": [1174.24, 1179.89], "긴 나무는 잘라서 여러 곳에 나누어 써요": [1180.01, 1182.63], "책상 다리를 70cm로 만들려고 해요. 85cm 나무에서 몇 cm를 잘라 내야 할까요?.": [1182.75, 1189.56], "85에서 70을 빼면 잘라 낼 길이가 나와요": [1189.68, 1192.87], "필요한 길이만 남기고 나머지를 잘라 내요": [1192.99, 1195.95], "커튼 가게에서는 창문 길이를 m와 cm로 재요. 1m는 100cm예요. 1m 20cm는 100cm와 20cm를 합한 120cm예요": [1196.07, 1208.1], "1m 20cm는 몇 cm일까요?.": [1208.22, 1210.87], "1m는 100cm예요. 100에 20을 더해요": [1210.99, 1214.93], "커튼 가게에서는 cm로 바꿔서 천을 잘라요": [1215.05, 1218.39], "2m는 몇 cm일까요?.": [1218.51, 1220.22], "1m가 100cm니까 100을 두 번 더해요": [1220.34, 1223.7], "긴 커튼은 2m가 넘기도 해요": [1223.82, 1226.04], "150cm는 몇 m 몇 cm일까요?.": [1226.16, 1228.89], "100cm가 1m예요. 150cm는 100cm와 50cm예요": [1229.01, 1235.29], "150cm를 1m 50cm라고도 말해요": [1235.41, 1238.93], "1m 5cm는 몇 cm일까요?.": [1239.05, 1241.49], "100에 5를 더해요. 150이 아니에요!.": [1241.61, 1244.68], "5cm는 아주 짧아요. 1m 5cm는 105cm예요": [1244.8, 1250.03], "창문 길이는 1m 40cm예요. 커튼은 창문보다 20cm 더 길게 만들어요. 커튼은 몇 cm일까요?.": [1250.15, 1258.67], "1m 40cm는 140cm예요. 거기에 20cm를 더해요": [1258.79, 1264.66], "커튼을 창문보다 조금 길게 하면 빛이 새지 않아요": [1264.78, 1268.1], "택배 기사님은 상자 무게를 더해서 한 번에 옮길 수 있는지 계산해요. 제빵사는 그릇 무게를 빼고 재료 무게만 구해요": [1268.22, 1276.45], "1kg 상자에 3kg 책을 넣었어요. 모두 몇 kg일까요?.": [1276.57, 1281.41], "1과 3을 더해요": [1281.53, 1282.94], "택배 기사님은 전체 무게를 알고 상자를 옮겨요": [1283.06, 1286.47], "그릇에 밀가루를 담았더니 500g이에요. 그릇만 재면 200g이에요. 밀가루만 몇 g일까요?.": [1286.59, 1293.99], "전체 무게에서 그릇 무게를 빼요": [1294.11, 1296.37], "제빵사는 그릇 무게를 빼서 재료 무게만 알아내요": [1296.49, 1299.65], "5kg 수박과 2kg 멜론을 한 봉지에 담았어요. 모두 몇 kg일까요?.": [1299.77, 1305.25], "5와 2를 더해요": [1305.37, 1306.68], "무거운 봉지는 두 개로 나누어 들어요": [1306.8, 1309.23], "택배 상자는 10kg까지 보낼 수 있어요. 지금 6kg이에요. 몇 kg 더 넣을 수 있을까요?.": [1309.35, 1316.89], "10에서 6을 빼요": [1317.01, 1318.38], "정해진 무게를 넘지 않게 담아야 택배를 보낼 수 있어요": [1318.5, 1322.04], "설탕 300g과 버터 250g을 그릇에 넣었어요. 모두 몇 g일까요?.": [1322.16, 1327.93], "300에 200을 더하고, 50을 더 더해요": [1328.05, 1331.18], "재료 무게를 더하면 반죽 무게를 알 수 있어요": [1331.3, 1334.35], "쌀가게와 마트에서는 무게를 kg과 g으로 말해요. 1kg은 1000g이에요": [1334.47, 1340.32], "1kg은 몇 g일까요?.": [1340.44, 1342.29], "1kg은 1 뒤에 0이 3개 붙어요": [1342.41, 1344.98], "1kg은 1000g이에요. 큰 우유갑 하나쯤의 무게예요": [1345.1, 1349.56], "2kg은 몇 g일까요?.": [1349.68, 1351.49], "1000을 두 번 더해요": [1351.61, 1353.03], "쌀 2kg은 2000g이에요": [1353.15, 1355.44], "쌀 1kg 500g은 몇 g일까요?.": [1355.56, 1358.33], "1kg은 1000g이에요. 1000에 500을 더해요": [1358.45, 1362.39], "쌀가게는 g으로 바꿔서 봉지에 나누어 담아요": [1362.51, 1365.54], "3000g은 몇 kg일까요?.": [1365.66, 1367.57], "1000g이 1kg이에요. 1000g이 몇 개인지 세어 봐요": [1367.69, 1372.14], "3000g은 3kg이에요. kg으로 말하면 더 간단해요": [1372.26, 1377.13], "쌀 1kg을 500g 봉지에 나누어 담아요. 몇 봉지가 될까요?.": [1377.25, 1382.21], "500과 500을 더하면 1000이에요": [1382.33, 1384.53], "쌀가게는 큰 포대를 작은 봉지에 나누어 팔아요": [1384.65, 1387.76], "요리사는 국을 끓일 때 물과 육수의 양을 더하고 빼요. 1L는 1000mL예요": [1387.88, 1393.65], "물 500mL와 우유 300mL를 섞었어요. 모두 몇 mL일까요?.": [1393.77, 1398.61], "500과 300을 더해요. 5+3을 생각해요": [1398.73, 1402.73], "요리사는 재료의 양을 더해서 냄비 크기를 골라요": [1402.85, 1406.06], "1L 우유에서 200mL를 따랐어요. 남은 우유는 몇 mL일까요?.": [1406.18, 1411.05], "1L는 1000mL예요. 1000에서 200을 빼요": [1411.17, 1414.97], "남은 양을 알면 장을 볼 때 무엇이 필요한지 알 수 있어요": [1415.09, 1418.93], "육수 1L에 물 500mL를 더 넣었어요. 모두 몇 mL일까요?.": [1419.05, 1423.66], "1000에 500을 더해요": [1423.78, 1425.3], "국물이 짜면 물을 더 넣어 맛을 맞춰요": [1425.42, 1427.95], "국을 끓이려면 물 900mL가 필요해요. 지금 600mL를 넣었어요. 몇 mL 더 넣어야 할까요?.": [1428.07, 1435.34], "900에서 600을 빼요. 빨간 점선까지 몇 칸이 남았는지 세어도 돼요": [1435.46, 1440.56], "정해진 양을 맞춰야 국 맛이 늘 똑같아요": [1440.68, 1443.45], "물 2L에서 500mL를 썼어요. 남은 물은 몇 mL일까요?.": [1443.57, 1448.32], "2L는 2000mL예요. 2000에서 500을 빼요": [1448.44, 1452.44], "요리사는 남은 물로 다음 요리를 준비해요": [1452.56, 1455.27], "똑같은 것을 여러 개 만들 때는 곱하기를 써요. 목수는 의자 다리 4개를, 제빵사는 케이크 여러 개를 만들어요": [1455.39, 1462.84], "의자 다리 1개는 40cm예요. 다리 4개를 만들려면 나무가 몇 cm 필요할까요?.": [1462.96, 1469.22], "40을 4번 더해요. 40, 80, 120, 160": [1469.34, 1474.54], "목수는 필요한 나무 길이를 미리 계산해서 사요": [1474.66, 1477.65], "케이크 1개에 밀가루 200g이 들어가요. 케이크 2개를 만들려면 몇 g이 필요할까요?.": [1477.77, 1483.62], "200을 2번 더해요": [1483.74, 1485.16], "제빵사는 만들 개수만큼 재료를 곱해서 준비해요": [1485.28, 1488.53], "컵 3개에 우유를 200mL씩 담아요. 우유가 모두 몇 mL 필요할까요?.": [1488.65, 1493.88], "200을 3번 더해요. 200, 400, 600": [1494.0, 1498.1], "바리스타는 손님 수만큼 우유를 준비해요": [1498.22, 1501.02], "2kg 상자가 5개 있어요. 모두 몇 kg일까요?.": [1501.14, 1505.36], "2씩 5번 세어 봐요. 2, 4, 6, 8, 10": [1505.48, 1510.36], "택배 기사님은 상자 수와 무게로 전체 무게를 알아요": [1510.48, 1514.14], "선물 6개에 리본을 30cm씩 묶어요. 리본이 모두 몇 cm 필요할까요?.": [1514.26, 1520.27], "30을 6번 더해요. 30, 60, 90, 120, 150, 180": [1520.39, 1526.77], "포장하는 사람은 리본이 모자라지 않게 미리 계산해요": [1526.89, 1530.61], "많은 양을 똑같이 나눌 때는 나누기를 써요. 바리스타는 우유를 여러 컵에, 도예가는 점토를 여러 덩이로 나눠요": [1530.73, 1538.2], "우유 1L(1000mL)를 200mL 컵에 나누어 담아요. 몇 잔이 될까요?.": [1538.32, 1542.78], "200mL씩 몇 번 들어가는지 세어요. 200, 400, 600, 800, 1000": [1542.9, 1549.5], "바리스타는 우유 한 통으로 몇 잔을 만들 수 있는지 알아요": [1549.62, 1553.03], "리본 120cm를 30cm씩 잘라요. 몇 개가 될까요?.": [1553.15, 1558.23], "30씩 세어 120이 될 때까지 몇 번인지 봐요. 30, 60, 90, 120": [1558.35, 1564.87], "리본을 똑같이 잘라 선물마다 하나씩 묶어요": [1564.99, 1568.33], "점토 2kg(2000g)을 500g씩 나누어 그릇을 만들어요. 그릇을 몇 개 만들 수 있을까요?.": [1568.45, 1574.35], "500씩 세어 봐요. 500, 1000, 1500, 2000": [1574.47, 1578.98], "도예가는 점토를 똑같은 무게로 나누어 같은 크기 그릇을 만들어요": [1579.1, 1583.1], "나무 90cm를 똑같이 3도막으로 잘라요. 한 도막은 몇 cm일까요?.": [1583.22, 1588.69], "어떤 수를 3번 더하면 90이 될까요? 30+30+30을 생각해요": [1588.81, 1594.8], "목수는 나무를 똑같이 나누어 선반 칸을 만들어요": [1594.92, 1598.19], "쌀 3kg을 3봉지에 똑같이 나누어요. 한 봉지는 몇 kg일까요?.": [1598.31, 1603.53], "3을 셋으로 똑같이 나누면 하나에 몇일까요?.": [1603.65, 1606.53], "똑같이 나누면 모두 같은 양을 받아요": [1606.65, 1609.04], "이제 여러 직업 사람이 되어 재고 계산해 봐요. 두 번 계산해야 하는 문제도 있어요. 천천히 하나씩 풀어 봐요": [1609.16, 1617.04], "🏺 도예가: 점토 1kg으로 컵을 만들어요. 컵 1개에 점토 200g이 들어가요. 컵을 몇 개 만들 수 있을까요?.": [1617.16, 1625.99], "1kg은 1000g이에요. 200씩 세어 1000까지 가 봐요": [1626.11, 1630.5], "도예가는 점토 무게로 몇 개를 만들지 정해요": [1630.62, 1634.81], "🪑 목수: 의자 다리 45cm 4개와 등받이 50cm 1개를 만들어요. 나무가 모두 몇 cm 필요할까요?.": [1634.93, 1642.29], "먼저 다리 4개 길이를 구해요. 45, 90, 135, 180. 그다음 등받이 50을 더해요": [1642.41, 1651.15], "목수는 필요한 나무를 모두 더해서 한 번에 준비해요": [1651.27, 1654.66], "🍪 제빵사: 쿠키 1판에 버터 150g이 들어가요. 버터 500g으로 쿠키 2판을 만들면 버터가 몇 g 남을까요?.": [1654.78, 1662.56], "2판에 쓰는 버터는 150+150=300g이에요. 500에서 300을 빼요": [1662.68, 1669.0], "남은 재료를 알면 다음에 무엇을 만들지 정할 수 있어요": [1669.12, 1672.6], "✂️ 재단사: 치마 길이는 60cm예요. 위와 아래에 접어서 꿰맬 부분이 5cm씩 더 필요해요. 천은 몇 cm 필요할까요?.": [1672.72, 1682.17], "5와 60과 5를 모두 더해요": [1682.29, 1684.43], "재단사는 접는 부분까지 생각해서 천을 넉넉히 잘라요": [1684.55, 1688.36], "☕ 바리스타: 우유 1L로 라떼를 만들어요. 라떼 1잔에 우유 250mL가 들어가요. 몇 잔을 만들 수 있을까요?.": [1688.48, 1696.71], "250씩 세어 봐요. 250, 500, 750, 1000": [1696.83, 1702.0], "바리스타는 우유가 몇 잔 분량인지 알고 미리 준비해요": [1702.12, 1705.59], "🚚 택배 기사: 상자 3개의 무게가 2kg, 3kg, 4kg이에요. 모두 몇 kg일까요?.": [1705.71, 1712.14], "2와 3을 더하고, 4를 더 더해요": [1712.26, 1714.89], "택배 기사님은 차에 실은 전체 무게를 알아야 안전해요": [1715.01, 1718.59], "🩺 보건 선생님: 1학기 키는 128cm, 2학기 키는 133cm예요. 몇 cm 컸을까요?.": [1718.71, 1726.29], "133에서 128을 빼요. 두 선 사이 칸을 세어도 돼요": [1726.41, 1731.1]}, "parts": {"다시 생각해 봐요": 0, "색깔과 그림을 잘 봐요": 1, "반짝이는 곳을 봐요": 2, "흐린 숫자를 따라 눌러 봐요": 3, "빈칸에 숫자를 써요": 4, "맞아요": 5, "참 잘했어요": 6, "옷가게 직원은 손님에게 맞는 옷을 골라 줘요. 바지나 목도리의 길이를 비교해서 더 긴 것과 짧은 것을 찾아요.": 7, "가장 긴 바지는 어느 것일까요?": 8, "바지 아래쪽 끝이 똑같이 맞춰져 있어요. 위쪽 끝이 가장 높은 바지를 찾아요.": 9, "긴 바지는 키가 큰 손님에게 맞아요. 옷가게에서는 길이를 비교해서 옷을 골라 줘요.": 10, "가장 짧은 목도리는 어느 것일까요?": 11, "왼쪽 끝이 맞춰져 있어요. 오른쪽 끝이 가장 덜 나온 목도리를 찾아요.": 12, "짧은 목도리는 어린이에게 알맞아요.": 13, "키가 가장 큰 친구는 누구일까요?": 14, "세 친구 모두 같은 바닥에 서 있어요. 머리 꼭대기가 가장 높은 친구를 찾아요.": 15, "옷가게에서는 키를 보고 옷 크기를 골라요. 키가 크면 더 큰 옷이 필요해요.": 16, "어느 끈이 더 길까요?": 17, "끝이 맞춰져 있지 않아요. 왼쪽 끝을 똑같이 맞추고 비교해야 해요.": 18, "길이를 비교할 때는 한쪽 끝을 똑같이 맞춰요. 옷가게에서도 옷을 겹쳐서 끝을 맞춰 봐요.": 19, "손님 팔 길이와 똑같은 소매는 어느 것일까요?": 20, "회색 팔과 오른쪽 끝이 똑같이 끝나는 소매를 찾아요.": 21, "소매가 팔 길이와 같아야 옷이 편해요. 옷을 고칠 때도 팔 길이와 비교해요.": 22, "목수는 나무로 책상과 의자를 만들어요. 자가 없을 때는 손을 쫙 펴서 한 뼘, 두 뼘 하고 길이를 재요.": 23, "책상의 긴 쪽은 몇 뼘일까요?": 24, "손 모양 하나가 한 뼘이에요. 손 모양을 하나씩 세어 봐요.": 25, "목수는 뼘으로 대강 길이를 재고, 어떤 책상을 만들지 생각해요.": 26, "나무 판자는 몇 뼘일까요?": 27, "왼쪽부터 손 모양을 하나씩 짚으며 세어 봐요.": 28, "판자 길이를 알면 무엇을 만들 수 있을지 정할 수 있어요.": 29, "의자의 높이는 몇 뼘일까요?": 30, "바닥부터 위로 손 모양을 세어 봐요.": 31, "의자 높이가 알맞아야 편하게 앉을 수 있어요.": 32, "책상은 선반보다 몇 뼘 더 길까요?": 33, "책상은 몇 뼘, 선반은 몇 뼘인지 따로 세고 비교해요.": 34, "목수는 두 나무의 길이를 비교해서 얼마나 더 필요한지 알아내요.": 35, "책장의 너비는 4뼘하고 조금 더 남아요. 약 몇 뼘이라고 할까요?": 36, "손 모양이 4개 있고 아주 조금 남았어요.": 37, "딱 맞지 않을 때는 \"약 몇 뼘\"이라고 어림해요. 목수도 처음에는 어림해서 재요.": 38, "농부는 밭에 씨앗을 심기 전에 밭의 길이를 걸음으로 재요. 한 걸음, 두 걸음 세며 걸어요.": 39, "배추밭의 길이는 몇 걸음일까요?": 40, "발자국 하나가 한 걸음이에요. 하나씩 세어 봐요.": 41, "밭 길이를 알면 씨앗을 몇 줄 심을지 정할 수 있어요.": 42, "꽃밭의 길이는 몇 걸음일까요?": 43, "발자국을 왼쪽부터 손가락으로 짚으며 세어 봐요.": 44, "정원사도 걸음으로 꽃밭 크기를 어림해요.": 45, "두 밭 중 어느 밭이 더 길까요?": 46, "두 밭의 걸음 수를 각각 세어 비교해요. 걸음 수가 많으면 더 길어요.": 47, "같은 사람이 걸었으니까 걸음 수가 많은 밭이 더 길어요.": 48, "고구마밭은 몇 걸음일까요?": 49, "발자국이 많아요. 다섯까지 센 다음 이어서 세어 봐요.": 50, "밭이 길면 걸음 수도 많아져요.": 51, "울타리는 5걸음하고 조금 더 남아요. 약 몇 걸음일까요?": 52, "발자국 5개에 아주 조금 남았어요.": 53, "딱 맞지 않을 때는 \"약 몇 걸음\"이라고 말해요.": 54, "도예가는 흙으로 그릇과 꽃병을 만들어요. 여러 개를 비슷한 크기로 만들려고 높이와 길이를 재요. 블록이나 클립을 이어서 재 볼까요?": 55, "꽃병의 높이는 블록 몇 개일까요?": 56, "아래부터 블록을 하나씩 세어 봐요.": 57, "도예가는 꽃병 높이를 재서 같은 크기로 여러 개를 만들어요.": 58, "컵의 높이는 블록 몇 개일까요?": 59, "블록이 컵 꼭대기까지 몇 개 쌓였는지 세어요.": 60, "컵 높이가 같아야 세트로 팔 수 있어요.": 61, "붓의 길이는 클립 몇 개일까요?": 62, "붓 아래에 있는 클립을 하나씩 세어 봐요.": 63, "도예가는 붓으로 그릇에 그림을 그려요.": 64, "항아리는 꽃병보다 블록 몇 개 더 높을까요?": 65, "꽃병 블록과 항아리 블록을 각각 세고 몇 개 차이인지 봐요.": 66, "높이를 비교하면 어느 쪽을 더 크게 만들었는지 알 수 있어요.": 67, "접시의 길이는 클립 몇 개일까요?": 68, "클립을 왼쪽부터 세어 봐요.": 69, "접시 크기를 재면 그릇장에 들어갈지 알 수 있어요.": 70, "요리사는 밥을 지을 때 쌀과 물을 컵으로 재요. 컵 수가 알맞아야 밥이 맛있게 돼요.": 71, "냄비에 물을 몇 컵 부었을까요?": 72, "컵을 하나씩 세어 봐요.": 73, "물을 컵으로 재면 매번 같은 맛을 낼 수 있어요.": 74, "밥솥에 쌀을 몇 컵 넣었을까요?": 75, "쌀이 담긴 컵을 세어요.": 76, "먹을 사람 수에 맞게 쌀 컵 수를 정해요.": 77, "물은 쌀보다 1컵 더 넣어요. 물은 몇 컵 넣을까요?": 78, "쌀 2컵에 1컵을 더해요.": 79, "쌀과 물의 양을 맞추면 밥이 질지도 되지도 않아요.": 80, "물이 더 많이 들어간 냄비는 어느 것일까요?": 81, "두 냄비에 부은 컵 수를 세어 비교해요.": 82, "같은 컵으로 부었으니 컵 수가 많은 쪽에 물이 더 많아요.": 83, "큰 냄비를 채우려면 5컵이 필요해요. 3컵 부었어요. 몇 컵 더 부어야 할까요?": 84, "점선 컵이 더 부어야 할 컵이에요. 점선 컵을 세어 봐요.": 85, "얼마나 더 필요한지 알면 넘치지 않게 부을 수 있어요.": 86, "카페 바리스타는 컵 크기에 맞게 음료를 담아요. 어느 컵에 물이 더 많이 들어가는지 비교해 봐요.": 87, "물이 더 많이 담긴 컵은 어느 것일까요?": 88, "두 컵의 크기가 똑같아요. 물의 높이를 비교해요.": 89, "크기가 같은 컵이면 물이 높이 찬 쪽이 더 많아요.": 90, "물이 가장 적게 담긴 컵은 어느 것일까요?": 91, "물의 높이가 가장 낮은 컵을 찾아요.": 92, "손님이 조금만 달라고 하면 적게 담아요.": 93, "두 병의 물을 똑같은 컵에 따랐어요. 어느 병에 물이 더 많았을까요?": 94, "병에서 나온 컵 수를 세어 비교해요.": 95, "같은 컵으로 재면 어느 그릇에 더 많이 들어가는지 알 수 있어요.": 96, "두 컵의 물 높이가 같아요. 물이 더 많은 컵은 어느 것일까요?": 97, "물 높이가 같으면 더 넓은 컵에 물이 더 많아요.": 98, "컵이 넓으면 같은 높이라도 물이 더 많이 들어가요.": 99, "작은 컵 2개로 큰 컵 1개가 가득 차요. 큰 컵 2개를 채우려면 작은 컵이 몇 개 필요할까요?": 100, "큰 컵 하나에 작은 컵 2개씩이에요. 2개씩 두 번 세어 봐요.": 101, "바리스타는 컵 크기를 알고 음료 양을 맞춰요.": 102, "과일가게 사장님은 저울로 과일 무게를 비교해요. 양팔저울에서는 무거운 쪽이 아래로 내려가요.": 103, "더 무거운 과일은 무엇일까요?": 104, "저울이 아래로 내려간 쪽을 봐요.": 105, "수박이 사과보다 무거워서 저울이 수박 쪽으로 내려갔어요.": 106, "더 가벼운 과일은 무엇일까요?": 107, "위로 올라간 쪽이 더 가벼워요.": 108, "가벼운 쪽은 위로 올라가요.": 109, "두 쪽의 무게는 어떤가요?": 110, "저울이 어느 쪽으로도 기울지 않았어요.": 111, "저울이 평평하면 양쪽 무게가 같아요.": 112, "가장 무거운 과일은 무엇일까요?": 113, "사과는 딸기보다 무겁고, 멜론은 사과보다 무거워요.": 114, "두 번 비교해서 가장 무거운 것을 찾았어요.": 115, "수박 1통은 멜론 몇 개와 무게가 같을까요?": 116, "저울이 평평해요. 오른쪽 멜론을 세어 봐요.": 117, "과일가게에서는 저울로 무게를 맞춰 팔아요.": 118, "옛날 시장에서는 돌을 저울에 올려 무게를 쟀어요. 바둑돌 몇 개와 무게가 같은지 세어 봐요.": 119, "사과는 바둑돌 몇 개와 무게가 같을까요?": 120, "저울이 평평해요. 오른쪽 바둑돌을 하나씩 세어 봐요.": 121, "사과의 무게는 바둑돌 6개만큼이에요.": 122, "귤은 바둑돌 몇 개와 무게가 같을까요?": 123, "바둑돌을 하나씩 짚으며 세어 봐요.": 124, "귤은 사과보다 가벼워서 바둑돌이 더 적어요.": 125, "감자는 바둑돌 8개, 양파는 바둑돌 5개와 무게가 같아요. 더 무거운 것은 무엇일까요?": 126, "바둑돌이 많을수록 더 무거워요.": 127, "바둑돌 수를 비교하면 어느 것이 더 무거운지 알 수 있어요.": 128, "감자는 양파보다 바둑돌 몇 개만큼 더 무거울까요?": 129, "8개와 5개의 차이를 세어 봐요.": 130, "무게의 차이도 바둑돌로 알 수 있어요.": 131, "배 쪽으로 저울이 내려갔어요. 배는 바둑돌 5개보다 어떨까요?": 132, "내려간 쪽이 더 무거워요.": 133, "저울이 기울면 두 쪽의 무게가 다르다는 뜻이에요.": 134, "가구점에 책상을 주문할 때 \"5뼘짜리 주세요\" 하면 어떻게 될까요? 사람마다 손 크기가 달라서 길이가 달라져요. 그래서 모두가 똑같이 쓰는 단위가 필요해요.": 135, "같은 책상을 아빠 뼘과 월이 뼘으로 쟀어요. 누구 뼘으로 잰 수가 더 많을까요?": 136, "두 줄의 손 모양 수를 각각 세어 봐요.": 137, "월이 손이 작아서 더 많이 재야 해요. 같은 책상인데 수가 달라졌어요!": 138, "같은 물을 큰 컵으로 2컵, 작은 컵으로 4컵 담았어요. 어느 컵이 더 클까요?": 139, "컵이 클수록 적은 수로도 다 담을 수 있어요.": 140, "컵 크기가 다르면 같은 물이라도 컵 수가 달라져요.": 141, "\"5뼘짜리 책상 주세요\" 하고 주문하면 어떻게 될까요?": 142, "아빠 뼘과 월이 뼘으로 잰 수가 달랐던 것을 생각해요.": 143, "그래서 가게에서는 누구나 똑같이 쓰는 cm로 주문해요.": 144, "누구나 똑같은 길이로 재려면 무엇을 쓸까요?": 145, "사람마다 달라지지 않는 도구를 찾아요.": 146, "자는 누가 써도 1cm가 똑같아요.": 147, "누구나 똑같은 무게로 재려면 무엇을 쓸까요?": 148, "눈금이 있어서 누가 재도 같은 도구를 찾아요.": 149, "저울은 누가 재도 같은 무게가 나와요.": 150, "누구나 똑같은 양으로 재려면 무엇을 쓸까요?": 151, "눈금이 그려진 컵을 찾아요.": 152, "계량컵에는 눈금이 있어서 늘 같은 양을 잴 수 있어요.": 153, "재단사는 옷을 만드는 사람이에요. 자로 천과 리본의 길이를 cm로 재요. 물건 끝을 자의 0에 맞추고, 다른 끝의 눈금을 읽어요.": 154, "리본의 길이는 몇 cm일까요?": 155, "리본 끝이 0에 맞춰져 있어요. 오른쪽 끝에 있는 숫자를 읽어요.": 156, "재단사는 리본을 cm로 재서 옷에 딱 맞게 달아요.": 157, "연필의 길이는 몇 cm일까요?": 158, "연필 뾰족한 끝이 가리키는 숫자를 읽어요.": 159, "재단사는 연필로 천에 자를 곳을 표시해요.": 160, "지우개의 길이는 몇 cm일까요?": 161, "지우개 오른쪽 끝 아래 숫자를 읽어요.": 162, "작은 물건도 자로 정확하게 잴 수 있어요.": 163, "실의 길이는 몇 cm일까요?": 164, "실 끝에서 내려온 점선이 가리키는 숫자를 읽어요.": 165, "옷을 꿰맬 때 실을 알맞은 길이로 잘라요.": 166, "단추를 꿴 줄의 길이는 몇 cm일까요?": 167, "줄의 오른쪽 끝 점선을 따라 내려가 숫자를 읽어요.": 168, "단추 사이 길이를 재서 옷에 고르게 달아요.": 169, "목수의 자는 끝이 닳아 있기도 해요. 그럴 때는 중간 눈금부터 재요. 1cm 칸이 몇 개인지 세면 길이를 알 수 있어요.": 170, "나무 막대의 길이는 몇 cm일까요?": 171, "막대가 2에서 시작해서 7에서 끝나요. 1cm 칸을 세어 봐요.": 172, "목수는 끝 눈금에서 시작 눈금을 빼서 길이를 구해요.": 173, "못의 길이는 몇 cm일까요?": 174, "못이 1에서 시작해요. 4까지 1cm 칸이 몇 개인지 세어요.": 175, "못 길이가 알맞아야 나무를 튼튼하게 붙일 수 있어요.": 176, "나무 조각의 길이는 몇 cm일까요?": 177, "3에서 시작해서 11에서 끝나요. 칸을 세어 봐요.": 178, "짧은 나무 조각도 길이를 재서 버리지 않고 써요.": 179, "의자 다리 모형의 길이는 몇 cm일까요?": 180, "5에서 시작해서 14에서 끝나요.": 181, "의자 다리 4개의 길이가 똑같아야 의자가 흔들리지 않아요.": 182, "연필이 4에서 시작해요. 10까지 칸을 세어 봐요.": 183, "시작이 0이 아니어도 칸을 세면 길이를 알 수 있어요.": 184, "집을 짓는 사람은 긴 것은 m(미터)로, 짧은 것은 cm(센티미터)로 재요. 1m는 100cm예요.": 185, "1m는 몇 cm일까요?": 186, "1m 막대에 10cm 칸이 10개 있어요. 10씩 세어 봐요.": 187, "1m는 100cm예요. 건축가는 긴 길이를 m로 말해요.": 188, "연필 길이에 알맞은 단위는 무엇일까요?": 189, "연필은 짧아요. 짧은 것은 cm로 재요.": 190, "손에 쥐는 작은 물건은 cm로 재요.": 191, "교실 긴 쪽의 길이에 알맞은 단위는 무엇일까요?": 192, "교실은 아주 길어요. 긴 것은 m로 재요.": 193, "건축가는 방의 크기를 m로 재서 설계도를 그려요.": 194, "문 높이에 알맞은 단위는 무엇일까요?": 195, "문은 사람보다 커요. 2cm라면 손가락보다 짧아요!": 196, "문 높이는 약 2m예요. 200cm라고도 말해요.": 197, "휴대폰 길이에 알맞은 단위는 무엇일까요?": 198, "휴대폰은 손에 쥘 만큼 짧아요.": 199, "15m라면 버스보다 긴 휴대폰이 돼요!": 200, "1m보다 긴 것은 무엇일까요?": 201, "1m는 어른 한 걸음쯤이에요. 그보다 긴 것을 찾아요.": 202, "버스는 길이가 약 11m예요.": 203, "보건 선생님과 간호사는 키와 몸무게를 재서 우리가 건강하게 자라는지 살펴봐요. 키는 cm, 몸무게는 kg으로 재요.": 204, "월이의 키는 몇 cm일까요?": 205, "빨간 선 아래쪽 큰 숫자 130을 찾고, 작은 눈금을 더 세어 봐요.": 206, "보건 선생님은 키를 재서 건강 기록에 적어요.": 207, "120과 130 사이 가운데 긴 눈금이 125예요.": 209, "키가 자라면 책상과 의자 높이도 맞춰 바꿔요.": 210, "아리의 몸무게는 몇 kg일까요?": 211, "바늘이 30을 조금 지났어요. 30에서 작은 눈금을 세어요.": 212, "몸무게를 재면 건강하게 자라는지 알 수 있어요.": 213, "월이의 몸무게는 몇 kg일까요?": 214, "바늘이 30보다 조금 덜 갔어요. 20에서 작은 눈금을 세어 봐요.": 215, "보건실 체중계는 kg으로 몸무게를 알려 줘요.": 216, "지난봄 월이 키는 128cm였어요. 지금은 132cm예요. 몇 cm 컸을까요?": 217, "파란 점선과 빨간 선 사이의 작은 눈금 칸을 세어 봐요.": 218, "키를 재서 비교하면 얼마나 자랐는지 알 수 있어요.": 219, "제빵사는 밀가루와 설탕을 g(그램)으로 재요. 조금만 달라져도 빵 맛이 달라지기 때문에 저울을 꼭 써요.": 220, "밀가루의 무게는 몇 g일까요?": 221, "바늘이 가리키는 큰 숫자를 읽어요.": 222, "빵 반죽에는 밀가루를 정확하게 넣어야 해요.": 223, "설탕의 무게는 몇 g일까요?": 224, "바늘이 100과 200 사이 가운데에 있어요. 가운데는 150이에요.": 225, "설탕을 너무 많이 넣으면 빵이 너무 달아져요.": 226, "버터의 무게는 몇 g일까요?": 227, "400과 500 사이 가운데 눈금이에요.": 228, "버터를 재서 넣으면 쿠키가 늘 똑같이 고소해요.": 229, "밀가루 500g이 필요한데 저울은 400g이에요. 어떻게 할까요?": 230, "400은 500보다 작아요. 모자라요.": 231, "모자라면 더 넣고, 많으면 덜어 내요.": 232, "초콜릿의 무게는 몇 g일까요?": 233, "바늘 끝에 있는 큰 숫자를 읽어요.": 234, "제빵사는 초콜릿 무게를 재서 케이크를 만들어요.": 235, "택배 기사님은 상자의 무게를 kg(킬로그램)으로 재요. 무거운 상자는 배달비가 더 들고, 조심해서 옮겨요.": 236, "상자의 무게는 몇 kg일까요?": 237, "바늘이 가리키는 숫자를 읽어요.": 238, "택배 기사님은 상자 무게를 보고 배달비를 정해요.": 239, "수박의 무게는 몇 kg일까요?": 240, "바늘 끝 숫자를 읽어요.": 241, "시장 상인도 수박을 kg으로 재서 팔아요.": 242, "쌀 포대의 무게는 몇 kg일까요?": 243, "바늘이 10을 지났어요. 10에서 작은 눈금을 세어 봐요.": 244, "무거운 쌀 포대는 둘이 함께 들어요.": 245, "5kg보다 무거운 상자는 배달비가 더 들어요. 이 상자는 어떨까요?": 246, "바늘이 5보다 더 많이 돌아갔어요.": 247, "7kg은 5kg보다 무거워서 배달비가 더 들어요.": 248, "사과 1개의 무게에 알맞은 단위는 무엇일까요?": 249, "사과는 가벼워요. 가벼운 것은 g으로 재요.": 250, "1kg은 1000g이에요. 사과 300kg이면 사과 상자 수십 개만큼 무거워요!": 251, "수박 1통의 무게에 알맞은 단위는 무엇일까요?": 252, "수박은 무거워요. 무거운 것은 kg으로 재요.": 253, "6g이면 사탕 몇 개 무게예요. 수박은 6kg쯤이에요.": 254, "바리스타는 우유와 물을 mL(밀리리터)로 재요. 늘 같은 양을 넣어야 언제 마셔도 맛이 똑같아요.": 255, "우유는 몇 mL일까요?": 256, "우유 윗면과 같은 높이의 숫자를 읽어요.": 257, "라떼에는 우유를 정확하게 재서 넣어요.": 258, "물은 몇 mL일까요?": 259, "300과 400 사이 가운데 눈금이에요.": 260, "아메리카노는 물의 양으로 맛이 진하거나 연해져요.": 261, "커피는 몇 mL일까요?": 262, "100과 200 사이 가운데 눈금이에요.": 263, "커피를 정해진 양만큼 담아요.": 264, "라떼에 우유 300mL가 필요해요. 지금 200mL예요. 어떻게 할까요?": 265, "우유가 빨간 점선까지 오지 않았어요.": 266, "모자라면 빨간 선까지 더 부어요.": 267, "더 많이 담긴 컵은 어느 것일까요?": 268, "두 컵의 눈금 숫자를 읽고 비교해요.": 269, "mL 숫자가 클수록 양이 많아요.": 270, "수족관 사육사는 어항의 물을 L(리터)로 재요. 많은 양은 L로, 적은 양은 mL로 재요. 1L는 1000mL예요.": 271, "어항의 물은 몇 L일까요?": 272, "물 윗면과 같은 높이의 숫자를 읽어요.": 273, "사육사는 물고기 수에 맞게 물의 양을 맞춰요.": 274, "물통의 물은 몇 L일까요?": 275, "물 윗면 옆 숫자를 읽어요.": 276, "큰 물통의 물은 L로 재요.": 277, "1L는 몇 mL일까요?": 278, "1L는 아주 많은 양이에요. 1 뒤에 0이 3개 붙어요.": 279, "1L는 1000mL예요. 큰 우유갑 하나가 1L예요.": 280, "우유 한 컵의 양에 알맞은 단위는 무엇일까요?": 281, "한 컵은 적은 양이에요. 적은 양은 mL로 재요.": 282, "200L라면 욕조를 가득 채울 만큼이에요!": 283, "욕조에 받은 물의 양에 알맞은 단위는 무엇일까요?": 284, "욕조는 아주 커요. 많은 양은 L로 재요.": 285, "욕조처럼 큰 그릇의 물은 L로 재요.": 286, "간호사는 체온계로 몸의 온도를 재서 열이 나는지 알아봐요. 요리사는 오븐 온도를, 도예가는 가마 온도를 맞춰요. 온도는 ℃(도)로 읽어요.": 287, "오늘 기온은 몇 도일까요?": 288, "빨간 기둥 끝이 20과 30 사이 가운데에 있어요.": 289, "기온을 알면 어떤 옷을 입을지 정할 수 있어요.": 290, "체온이 36.5도예요. 37.5도부터 열이에요. 열이 있나요?": 291, "36.5는 37.5보다 낮아요.": 292, "36.5도쯤이 건강한 사람의 체온이에요.": 293, "체온이 38.2도예요. 열이 있나요?": 294, "38.2는 37.5보다 높아요.": 295, "열이 나면 보건 선생님께 알리고 쉬어야 해요.": 296, "추운 날 기온은 몇 도일까요?": 297, "빨간 기둥이 아주 짧아요. 0과 10 사이 가운데예요.": 298, "추운 날에는 두꺼운 옷을 입어요.": 299, "물이 펄펄 끓을 때 온도는 몇 도쯤일까요?": 300, "아주 뜨거운 온도를 골라요.": 301, "물은 약 100도에서 끓어요. 0도에서는 얼음이 돼요.": 302, "재단사는 천 두 장을 이어 붙여 옷을 만들어요. 이어 붙인 길이는 두 길이를 더해서 구해요.": 303, "40cm 천과 30cm 천을 이어 붙였어요. 모두 몇 cm일까요?": 304, "두 길이를 더해요.": 305, "재단사는 천 길이를 더해서 옷 길이를 정해요.": 306, "25cm 끈 2개를 이어서 허리끈을 만들어요. 모두 몇 cm일까요?": 307, "25와 25를 더해요. 20+20=40, 5+5=10이에요.": 308, "허리끈 길이가 맞아야 치마가 흘러내리지 않아요.": 309, "커튼 천 60cm에 45cm를 이어 붙였어요. 모두 몇 cm일까요?": 310, "60과 45를 더해요. 60+40=100, 거기에 5를 더해요.": 311, "긴 커튼은 천을 이어 붙여서 만들어요.": 312, "10cm 리본 3개를 이었어요. 모두 몇 cm일까요?": 313, "10씩 세어 봐요. 10, 20, 30.": 314, "리본을 이어서 선물 포장을 해요.": 315, "바지 길이 80cm에 10cm를 더 늘렸어요. 바지는 몇 cm가 될까요?": 316, "80에 10을 더해요.": 317, "키가 크면 옷 길이를 늘려서 고쳐 입어요.": 318, "목수는 긴 나무에서 필요한 만큼 잘라 써요. 남은 나무의 길이는 빼기로 구해요.": 319, "100cm 나무에서 30cm를 잘랐어요. 남은 나무는 몇 cm일까요?": 320, "전체 100cm에서 자른 30cm를 빼요.": 321, "남은 나무로 다른 물건을 만들 수 있어요.": 322, "90cm 나무에서 40cm를 잘랐어요. 남은 나무는 몇 cm일까요?": 323, "90에서 40을 빼요. 9−4를 생각해 봐요.": 324, "목수는 나무를 아껴 쓰려고 남은 길이를 계산해요.": 325, "80cm 판자에서 25cm를 잘랐어요. 남은 판자는 몇 cm일까요?": 326, "80에서 20을 빼고, 5를 더 빼요.": 327, "선반 하나를 만들고 남은 판자로 작은 상자를 만들어요.": 328, "120cm 나무에서 50cm를 잘랐어요. 남은 나무는 몇 cm일까요?": 329, "120에서 50을 빼요. 100에서 50을 빼면 50, 거기에 20을 더해요.": 330, "긴 나무는 잘라서 여러 곳에 나누어 써요.": 331, "책상 다리를 70cm로 만들려고 해요. 85cm 나무에서 몇 cm를 잘라 내야 할까요?": 332, "85에서 70을 빼면 잘라 낼 길이가 나와요.": 333, "필요한 길이만 남기고 나머지를 잘라 내요.": 334, "커튼 가게에서는 창문 길이를 m와 cm로 재요. 1m는 100cm예요. 1m 20cm는 100cm와 20cm를 합한 120cm예요.": 335, "1m 20cm는 몇 cm일까요?": 336, "1m는 100cm예요. 100에 20을 더해요.": 337, "커튼 가게에서는 cm로 바꿔서 천을 잘라요.": 338, "2m는 몇 cm일까요?": 339, "1m가 100cm니까 100을 두 번 더해요.": 340, "긴 커튼은 2m가 넘기도 해요.": 341, "150cm는 몇 m 몇 cm일까요?": 342, "100cm가 1m예요. 150cm는 100cm와 50cm예요.": 343, "150cm를 1m 50cm라고도 말해요.": 344, "1m 5cm는 몇 cm일까요?": 345, "100에 5를 더해요. 150이 아니에요!": 346, "5cm는 아주 짧아요. 1m 5cm는 105cm예요.": 347, "창문 길이는 1m 40cm예요. 커튼은 창문보다 20cm 더 길게 만들어요. 커튼은 몇 cm일까요?": 348, "1m 40cm는 140cm예요. 거기에 20cm를 더해요.": 349, "커튼을 창문보다 조금 길게 하면 빛이 새지 않아요.": 350, "택배 기사님은 상자 무게를 더해서 한 번에 옮길 수 있는지 계산해요. 제빵사는 그릇 무게를 빼고 재료 무게만 구해요.": 351, "1kg 상자에 3kg 책을 넣었어요. 모두 몇 kg일까요?": 352, "1과 3을 더해요.": 353, "택배 기사님은 전체 무게를 알고 상자를 옮겨요.": 354, "그릇에 밀가루를 담았더니 500g이에요. 그릇만 재면 200g이에요. 밀가루만 몇 g일까요?": 355, "전체 무게에서 그릇 무게를 빼요.": 356, "제빵사는 그릇 무게를 빼서 재료 무게만 알아내요.": 357, "5kg 수박과 2kg 멜론을 한 봉지에 담았어요. 모두 몇 kg일까요?": 358, "5와 2를 더해요.": 359, "무거운 봉지는 두 개로 나누어 들어요.": 360, "택배 상자는 10kg까지 보낼 수 있어요. 지금 6kg이에요. 몇 kg 더 넣을 수 있을까요?": 361, "10에서 6을 빼요.": 362, "정해진 무게를 넘지 않게 담아야 택배를 보낼 수 있어요.": 363, "설탕 300g과 버터 250g을 그릇에 넣었어요. 모두 몇 g일까요?": 364, "300에 200을 더하고, 50을 더 더해요.": 365, "재료 무게를 더하면 반죽 무게를 알 수 있어요.": 366, "쌀가게와 마트에서는 무게를 kg과 g으로 말해요. 1kg은 1000g이에요.": 367, "1kg은 몇 g일까요?": 368, "1kg은 1 뒤에 0이 3개 붙어요.": 369, "1kg은 1000g이에요. 큰 우유갑 하나쯤의 무게예요.": 370, "2kg은 몇 g일까요?": 371, "1000을 두 번 더해요.": 372, "쌀 2kg은 2000g이에요.": 373, "쌀 1kg 500g은 몇 g일까요?": 374, "1kg은 1000g이에요. 1000에 500을 더해요.": 375, "쌀가게는 g으로 바꿔서 봉지에 나누어 담아요.": 376, "3000g은 몇 kg일까요?": 377, "1000g이 1kg이에요. 1000g이 몇 개인지 세어 봐요.": 378, "3000g은 3kg이에요. kg으로 말하면 더 간단해요.": 379, "쌀 1kg을 500g 봉지에 나누어 담아요. 몇 봉지가 될까요?": 380, "500과 500을 더하면 1000이에요.": 381, "쌀가게는 큰 포대를 작은 봉지에 나누어 팔아요.": 382, "요리사는 국을 끓일 때 물과 육수의 양을 더하고 빼요. 1L는 1000mL예요.": 383, "물 500mL와 우유 300mL를 섞었어요. 모두 몇 mL일까요?": 384, "500과 300을 더해요. 5+3을 생각해요.": 385, "요리사는 재료의 양을 더해서 냄비 크기를 골라요.": 386, "1L 우유에서 200mL를 따랐어요. 남은 우유는 몇 mL일까요?": 387, "1L는 1000mL예요. 1000에서 200을 빼요.": 388, "남은 양을 알면 장을 볼 때 무엇이 필요한지 알 수 있어요.": 389, "육수 1L에 물 500mL를 더 넣었어요. 모두 몇 mL일까요?": 390, "1000에 500을 더해요.": 391, "국물이 짜면 물을 더 넣어 맛을 맞춰요.": 392, "국을 끓이려면 물 900mL가 필요해요. 지금 600mL를 넣었어요. 몇 mL 더 넣어야 할까요?": 393, "900에서 600을 빼요. 빨간 점선까지 몇 칸이 남았는지 세어도 돼요.": 394, "정해진 양을 맞춰야 국 맛이 늘 똑같아요.": 395, "물 2L에서 500mL를 썼어요. 남은 물은 몇 mL일까요?": 396, "2L는 2000mL예요. 2000에서 500을 빼요.": 397, "요리사는 남은 물로 다음 요리를 준비해요.": 398, "똑같은 것을 여러 개 만들 때는 곱하기를 써요. 목수는 의자 다리 4개를, 제빵사는 케이크 여러 개를 만들어요.": 399, "의자 다리 1개는 40cm예요. 다리 4개를 만들려면 나무가 몇 cm 필요할까요?": 400, "40을 4번 더해요. 40, 80, 120, 160.": 401, "목수는 필요한 나무 길이를 미리 계산해서 사요.": 402, "케이크 1개에 밀가루 200g이 들어가요. 케이크 2개를 만들려면 몇 g이 필요할까요?": 403, "200을 2번 더해요.": 404, "제빵사는 만들 개수만큼 재료를 곱해서 준비해요.": 405, "컵 3개에 우유를 200mL씩 담아요. 우유가 모두 몇 mL 필요할까요?": 406, "200을 3번 더해요. 200, 400, 600.": 407, "바리스타는 손님 수만큼 우유를 준비해요.": 408, "2kg 상자가 5개 있어요. 모두 몇 kg일까요?": 409, "2씩 5번 세어 봐요. 2, 4, 6, 8, 10.": 410, "택배 기사님은 상자 수와 무게로 전체 무게를 알아요.": 411, "선물 6개에 리본을 30cm씩 묶어요. 리본이 모두 몇 cm 필요할까요?": 412, "30을 6번 더해요. 30, 60, 90, 120, 150, 180.": 413, "포장하는 사람은 리본이 모자라지 않게 미리 계산해요.": 414, "많은 양을 똑같이 나눌 때는 나누기를 써요. 바리스타는 우유를 여러 컵에, 도예가는 점토를 여러 덩이로 나눠요.": 415, "우유 1L(1000mL)를 200mL 컵에 나누어 담아요. 몇 잔이 될까요?": 416, "200mL씩 몇 번 들어가는지 세어요. 200, 400, 600, 800, 1000.": 417, "바리스타는 우유 한 통으로 몇 잔을 만들 수 있는지 알아요.": 418, "리본 120cm를 30cm씩 잘라요. 몇 개가 될까요?": 419, "30씩 세어 120이 될 때까지 몇 번인지 봐요. 30, 60, 90, 120.": 420, "리본을 똑같이 잘라 선물마다 하나씩 묶어요.": 421, "점토 2kg(2000g)을 500g씩 나누어 그릇을 만들어요. 그릇을 몇 개 만들 수 있을까요?": 422, "500씩 세어 봐요. 500, 1000, 1500, 2000.": 423, "도예가는 점토를 똑같은 무게로 나누어 같은 크기 그릇을 만들어요.": 424, "나무 90cm를 똑같이 3도막으로 잘라요. 한 도막은 몇 cm일까요?": 425, "어떤 수를 3번 더하면 90이 될까요? 30+30+30을 생각해요.": 426, "목수는 나무를 똑같이 나누어 선반 칸을 만들어요.": 427, "쌀 3kg을 3봉지에 똑같이 나누어요. 한 봉지는 몇 kg일까요?": 428, "3을 셋으로 똑같이 나누면 하나에 몇일까요?": 429, "똑같이 나누면 모두 같은 양을 받아요.": 430, "이제 여러 직업 사람이 되어 재고 계산해 봐요. 두 번 계산해야 하는 문제도 있어요. 천천히 하나씩 풀어 봐요.": 431, "🏺 도예가: 점토 1kg으로 컵을 만들어요. 컵 1개에 점토 200g이 들어가요. 컵을 몇 개 만들 수 있을까요?": 432, "1kg은 1000g이에요. 200씩 세어 1000까지 가 봐요.": 433, "도예가는 점토 무게로 몇 개를 만들지 정해요.": 434, "🪑 목수: 의자 다리 45cm 4개와 등받이 50cm 1개를 만들어요. 나무가 모두 몇 cm 필요할까요?": 435, "먼저 다리 4개 길이를 구해요. 45, 90, 135, 180. 그다음 등받이 50을 더해요.": 436, "목수는 필요한 나무를 모두 더해서 한 번에 준비해요.": 437, "🍪 제빵사: 쿠키 1판에 버터 150g이 들어가요. 버터 500g으로 쿠키 2판을 만들면 버터가 몇 g 남을까요?": 438, "2판에 쓰는 버터는 150+150=300g이에요. 500에서 300을 빼요.": 439, "남은 재료를 알면 다음에 무엇을 만들지 정할 수 있어요.": 440, "✂️ 재단사: 치마 길이는 60cm예요. 위와 아래에 접어서 꿰맬 부분이 5cm씩 더 필요해요. 천은 몇 cm 필요할까요?": 441, "5와 60과 5를 모두 더해요.": 442, "재단사는 접는 부분까지 생각해서 천을 넉넉히 잘라요.": 443, "☕ 바리스타: 우유 1L로 라떼를 만들어요. 라떼 1잔에 우유 250mL가 들어가요. 몇 잔을 만들 수 있을까요?": 444, "250씩 세어 봐요. 250, 500, 750, 1000.": 445, "바리스타는 우유가 몇 잔 분량인지 알고 미리 준비해요.": 446, "🚚 택배 기사: 상자 3개의 무게가 2kg, 3kg, 4kg이에요. 모두 몇 kg일까요?": 447, "2와 3을 더하고, 4를 더 더해요.": 448, "택배 기사님은 차에 실은 전체 무게를 알아야 안전해요.": 449, "🩺 보건 선생님: 1학기 키는 128cm, 2학기 키는 133cm예요. 몇 cm 컸을까요?": 450, "133에서 128을 빼요. 두 선 사이 칸을 세어도 돼요.": 451, "다시 생각해 봐요.": 0, "색깔과 그림을 잘 봐요.": 1, "반짝이는 곳을 봐요.": 2, "흐린 숫자를 따라 눌러 봐요.": 3, "빈칸에 숫자를 써요.": 4, "맞아요.": 5, "참 잘했어요.": 6, "옷가게 직원은 손님에게 맞는 옷을 골라 줘요. 바지나 목도리의 길이를 비교해서 더 긴 것과 짧은 것을 찾아요": 7, "가장 긴 바지는 어느 것일까요?.": 8, "바지 아래쪽 끝이 똑같이 맞춰져 있어요. 위쪽 끝이 가장 높은 바지를 찾아요": 9, "긴 바지는 키가 큰 손님에게 맞아요. 옷가게에서는 길이를 비교해서 옷을 골라 줘요": 10, "가장 짧은 목도리는 어느 것일까요?.": 11, "왼쪽 끝이 맞춰져 있어요. 오른쪽 끝이 가장 덜 나온 목도리를 찾아요": 12, "짧은 목도리는 어린이에게 알맞아요": 13, "키가 가장 큰 친구는 누구일까요?.": 14, "세 친구 모두 같은 바닥에 서 있어요. 머리 꼭대기가 가장 높은 친구를 찾아요": 15, "옷가게에서는 키를 보고 옷 크기를 골라요. 키가 크면 더 큰 옷이 필요해요": 16, "어느 끈이 더 길까요?.": 17, "끝이 맞춰져 있지 않아요. 왼쪽 끝을 똑같이 맞추고 비교해야 해요": 18, "길이를 비교할 때는 한쪽 끝을 똑같이 맞춰요. 옷가게에서도 옷을 겹쳐서 끝을 맞춰 봐요": 19, "손님 팔 길이와 똑같은 소매는 어느 것일까요?.": 20, "회색 팔과 오른쪽 끝이 똑같이 끝나는 소매를 찾아요": 21, "소매가 팔 길이와 같아야 옷이 편해요. 옷을 고칠 때도 팔 길이와 비교해요": 22, "목수는 나무로 책상과 의자를 만들어요. 자가 없을 때는 손을 쫙 펴서 한 뼘, 두 뼘 하고 길이를 재요": 23, "책상의 긴 쪽은 몇 뼘일까요?.": 24, "손 모양 하나가 한 뼘이에요. 손 모양을 하나씩 세어 봐요": 25, "목수는 뼘으로 대강 길이를 재고, 어떤 책상을 만들지 생각해요": 26, "나무 판자는 몇 뼘일까요?.": 27, "왼쪽부터 손 모양을 하나씩 짚으며 세어 봐요": 28, "판자 길이를 알면 무엇을 만들 수 있을지 정할 수 있어요": 29, "의자의 높이는 몇 뼘일까요?.": 30, "바닥부터 위로 손 모양을 세어 봐요": 31, "의자 높이가 알맞아야 편하게 앉을 수 있어요": 32, "책상은 선반보다 몇 뼘 더 길까요?.": 33, "책상은 몇 뼘, 선반은 몇 뼘인지 따로 세고 비교해요": 34, "목수는 두 나무의 길이를 비교해서 얼마나 더 필요한지 알아내요": 35, "책장의 너비는 4뼘하고 조금 더 남아요. 약 몇 뼘이라고 할까요?.": 36, "손 모양이 4개 있고 아주 조금 남았어요": 37, "딱 맞지 않을 때는 \"약 몇 뼘\"이라고 어림해요. 목수도 처음에는 어림해서 재요": 38, "농부는 밭에 씨앗을 심기 전에 밭의 길이를 걸음으로 재요. 한 걸음, 두 걸음 세며 걸어요": 39, "배추밭의 길이는 몇 걸음일까요?.": 40, "발자국 하나가 한 걸음이에요. 하나씩 세어 봐요": 41, "밭 길이를 알면 씨앗을 몇 줄 심을지 정할 수 있어요": 42, "꽃밭의 길이는 몇 걸음일까요?.": 43, "발자국을 왼쪽부터 손가락으로 짚으며 세어 봐요": 44, "정원사도 걸음으로 꽃밭 크기를 어림해요": 45, "두 밭 중 어느 밭이 더 길까요?.": 46, "두 밭의 걸음 수를 각각 세어 비교해요. 걸음 수가 많으면 더 길어요": 47, "같은 사람이 걸었으니까 걸음 수가 많은 밭이 더 길어요": 48, "고구마밭은 몇 걸음일까요?.": 49, "발자국이 많아요. 다섯까지 센 다음 이어서 세어 봐요": 50, "밭이 길면 걸음 수도 많아져요": 51, "울타리는 5걸음하고 조금 더 남아요. 약 몇 걸음일까요?.": 52, "발자국 5개에 아주 조금 남았어요": 53, "딱 맞지 않을 때는 \"약 몇 걸음\"이라고 말해요": 54, "도예가는 흙으로 그릇과 꽃병을 만들어요. 여러 개를 비슷한 크기로 만들려고 높이와 길이를 재요. 블록이나 클립을 이어서 재 볼까요?.": 55, "꽃병의 높이는 블록 몇 개일까요?.": 56, "아래부터 블록을 하나씩 세어 봐요": 57, "도예가는 꽃병 높이를 재서 같은 크기로 여러 개를 만들어요": 58, "컵의 높이는 블록 몇 개일까요?.": 59, "블록이 컵 꼭대기까지 몇 개 쌓였는지 세어요": 60, "컵 높이가 같아야 세트로 팔 수 있어요": 61, "붓의 길이는 클립 몇 개일까요?.": 62, "붓 아래에 있는 클립을 하나씩 세어 봐요": 63, "도예가는 붓으로 그릇에 그림을 그려요": 64, "항아리는 꽃병보다 블록 몇 개 더 높을까요?.": 65, "꽃병 블록과 항아리 블록을 각각 세고 몇 개 차이인지 봐요": 66, "높이를 비교하면 어느 쪽을 더 크게 만들었는지 알 수 있어요": 67, "접시의 길이는 클립 몇 개일까요?.": 68, "클립을 왼쪽부터 세어 봐요": 69, "접시 크기를 재면 그릇장에 들어갈지 알 수 있어요": 70, "요리사는 밥을 지을 때 쌀과 물을 컵으로 재요. 컵 수가 알맞아야 밥이 맛있게 돼요": 71, "냄비에 물을 몇 컵 부었을까요?.": 72, "컵을 하나씩 세어 봐요": 73, "물을 컵으로 재면 매번 같은 맛을 낼 수 있어요": 74, "밥솥에 쌀을 몇 컵 넣었을까요?.": 75, "쌀이 담긴 컵을 세어요": 76, "먹을 사람 수에 맞게 쌀 컵 수를 정해요": 77, "물은 쌀보다 1컵 더 넣어요. 물은 몇 컵 넣을까요?.": 78, "쌀 2컵에 1컵을 더해요": 79, "쌀과 물의 양을 맞추면 밥이 질지도 되지도 않아요": 80, "물이 더 많이 들어간 냄비는 어느 것일까요?.": 81, "두 냄비에 부은 컵 수를 세어 비교해요": 82, "같은 컵으로 부었으니 컵 수가 많은 쪽에 물이 더 많아요": 83, "큰 냄비를 채우려면 5컵이 필요해요. 3컵 부었어요. 몇 컵 더 부어야 할까요?.": 84, "점선 컵이 더 부어야 할 컵이에요. 점선 컵을 세어 봐요": 85, "얼마나 더 필요한지 알면 넘치지 않게 부을 수 있어요": 86, "카페 바리스타는 컵 크기에 맞게 음료를 담아요. 어느 컵에 물이 더 많이 들어가는지 비교해 봐요": 87, "물이 더 많이 담긴 컵은 어느 것일까요?.": 88, "두 컵의 크기가 똑같아요. 물의 높이를 비교해요": 89, "크기가 같은 컵이면 물이 높이 찬 쪽이 더 많아요": 90, "물이 가장 적게 담긴 컵은 어느 것일까요?.": 91, "물의 높이가 가장 낮은 컵을 찾아요": 92, "손님이 조금만 달라고 하면 적게 담아요": 93, "두 병의 물을 똑같은 컵에 따랐어요. 어느 병에 물이 더 많았을까요?.": 94, "병에서 나온 컵 수를 세어 비교해요": 95, "같은 컵으로 재면 어느 그릇에 더 많이 들어가는지 알 수 있어요": 96, "두 컵의 물 높이가 같아요. 물이 더 많은 컵은 어느 것일까요?.": 97, "물 높이가 같으면 더 넓은 컵에 물이 더 많아요": 98, "컵이 넓으면 같은 높이라도 물이 더 많이 들어가요": 99, "작은 컵 2개로 큰 컵 1개가 가득 차요. 큰 컵 2개를 채우려면 작은 컵이 몇 개 필요할까요?.": 100, "큰 컵 하나에 작은 컵 2개씩이에요. 2개씩 두 번 세어 봐요": 101, "바리스타는 컵 크기를 알고 음료 양을 맞춰요": 102, "과일가게 사장님은 저울로 과일 무게를 비교해요. 양팔저울에서는 무거운 쪽이 아래로 내려가요": 103, "더 무거운 과일은 무엇일까요?.": 104, "저울이 아래로 내려간 쪽을 봐요": 105, "수박이 사과보다 무거워서 저울이 수박 쪽으로 내려갔어요": 106, "더 가벼운 과일은 무엇일까요?.": 107, "위로 올라간 쪽이 더 가벼워요": 108, "가벼운 쪽은 위로 올라가요": 109, "두 쪽의 무게는 어떤가요?.": 110, "저울이 어느 쪽으로도 기울지 않았어요": 111, "저울이 평평하면 양쪽 무게가 같아요": 112, "가장 무거운 과일은 무엇일까요?.": 113, "사과는 딸기보다 무겁고, 멜론은 사과보다 무거워요": 114, "두 번 비교해서 가장 무거운 것을 찾았어요": 115, "수박 1통은 멜론 몇 개와 무게가 같을까요?.": 116, "저울이 평평해요. 오른쪽 멜론을 세어 봐요": 117, "과일가게에서는 저울로 무게를 맞춰 팔아요": 118, "옛날 시장에서는 돌을 저울에 올려 무게를 쟀어요. 바둑돌 몇 개와 무게가 같은지 세어 봐요": 119, "사과는 바둑돌 몇 개와 무게가 같을까요?.": 120, "저울이 평평해요. 오른쪽 바둑돌을 하나씩 세어 봐요": 121, "사과의 무게는 바둑돌 6개만큼이에요": 122, "귤은 바둑돌 몇 개와 무게가 같을까요?.": 123, "바둑돌을 하나씩 짚으며 세어 봐요": 124, "귤은 사과보다 가벼워서 바둑돌이 더 적어요": 125, "감자는 바둑돌 8개, 양파는 바둑돌 5개와 무게가 같아요. 더 무거운 것은 무엇일까요?.": 126, "바둑돌이 많을수록 더 무거워요": 127, "바둑돌 수를 비교하면 어느 것이 더 무거운지 알 수 있어요": 128, "감자는 양파보다 바둑돌 몇 개만큼 더 무거울까요?.": 129, "8개와 5개의 차이를 세어 봐요": 130, "무게의 차이도 바둑돌로 알 수 있어요": 131, "배 쪽으로 저울이 내려갔어요. 배는 바둑돌 5개보다 어떨까요?.": 132, "내려간 쪽이 더 무거워요": 133, "저울이 기울면 두 쪽의 무게가 다르다는 뜻이에요": 134, "가구점에 책상을 주문할 때 \"5뼘짜리 주세요\" 하면 어떻게 될까요? 사람마다 손 크기가 달라서 길이가 달라져요. 그래서 모두가 똑같이 쓰는 단위가 필요해요": 135, "같은 책상을 아빠 뼘과 월이 뼘으로 쟀어요. 누구 뼘으로 잰 수가 더 많을까요?.": 136, "두 줄의 손 모양 수를 각각 세어 봐요": 137, "월이 손이 작아서 더 많이 재야 해요. 같은 책상인데 수가 달라졌어요!.": 138, "같은 물을 큰 컵으로 2컵, 작은 컵으로 4컵 담았어요. 어느 컵이 더 클까요?.": 139, "컵이 클수록 적은 수로도 다 담을 수 있어요": 140, "컵 크기가 다르면 같은 물이라도 컵 수가 달라져요": 141, "\"5뼘짜리 책상 주세요\" 하고 주문하면 어떻게 될까요?.": 142, "아빠 뼘과 월이 뼘으로 잰 수가 달랐던 것을 생각해요": 143, "그래서 가게에서는 누구나 똑같이 쓰는 cm로 주문해요": 144, "누구나 똑같은 길이로 재려면 무엇을 쓸까요?.": 145, "사람마다 달라지지 않는 도구를 찾아요": 146, "자는 누가 써도 1cm가 똑같아요": 147, "누구나 똑같은 무게로 재려면 무엇을 쓸까요?.": 148, "눈금이 있어서 누가 재도 같은 도구를 찾아요": 149, "저울은 누가 재도 같은 무게가 나와요": 150, "누구나 똑같은 양으로 재려면 무엇을 쓸까요?.": 151, "눈금이 그려진 컵을 찾아요": 152, "계량컵에는 눈금이 있어서 늘 같은 양을 잴 수 있어요": 153, "재단사는 옷을 만드는 사람이에요. 자로 천과 리본의 길이를 cm로 재요. 물건 끝을 자의 0에 맞추고, 다른 끝의 눈금을 읽어요": 154, "리본의 길이는 몇 cm일까요?.": 155, "리본 끝이 0에 맞춰져 있어요. 오른쪽 끝에 있는 숫자를 읽어요": 156, "재단사는 리본을 cm로 재서 옷에 딱 맞게 달아요": 157, "연필의 길이는 몇 cm일까요?.": 158, "연필 뾰족한 끝이 가리키는 숫자를 읽어요": 159, "재단사는 연필로 천에 자를 곳을 표시해요": 160, "지우개의 길이는 몇 cm일까요?.": 161, "지우개 오른쪽 끝 아래 숫자를 읽어요": 162, "작은 물건도 자로 정확하게 잴 수 있어요": 163, "실의 길이는 몇 cm일까요?.": 164, "실 끝에서 내려온 점선이 가리키는 숫자를 읽어요": 165, "옷을 꿰맬 때 실을 알맞은 길이로 잘라요": 166, "단추를 꿴 줄의 길이는 몇 cm일까요?.": 167, "줄의 오른쪽 끝 점선을 따라 내려가 숫자를 읽어요": 168, "단추 사이 길이를 재서 옷에 고르게 달아요": 169, "목수의 자는 끝이 닳아 있기도 해요. 그럴 때는 중간 눈금부터 재요. 1cm 칸이 몇 개인지 세면 길이를 알 수 있어요": 170, "나무 막대의 길이는 몇 cm일까요?.": 171, "막대가 2에서 시작해서 7에서 끝나요. 1cm 칸을 세어 봐요": 172, "목수는 끝 눈금에서 시작 눈금을 빼서 길이를 구해요": 173, "못의 길이는 몇 cm일까요?.": 174, "못이 1에서 시작해요. 4까지 1cm 칸이 몇 개인지 세어요": 175, "못 길이가 알맞아야 나무를 튼튼하게 붙일 수 있어요": 176, "나무 조각의 길이는 몇 cm일까요?.": 177, "3에서 시작해서 11에서 끝나요. 칸을 세어 봐요": 178, "짧은 나무 조각도 길이를 재서 버리지 않고 써요": 179, "의자 다리 모형의 길이는 몇 cm일까요?.": 180, "5에서 시작해서 14에서 끝나요": 181, "의자 다리 4개의 길이가 똑같아야 의자가 흔들리지 않아요": 182, "연필이 4에서 시작해요. 10까지 칸을 세어 봐요": 183, "시작이 0이 아니어도 칸을 세면 길이를 알 수 있어요": 184, "집을 짓는 사람은 긴 것은 m(미터)로, 짧은 것은 cm(센티미터)로 재요. 1m는 100cm예요": 185, "1m는 몇 cm일까요?.": 186, "1m 막대에 10cm 칸이 10개 있어요. 10씩 세어 봐요": 187, "1m는 100cm예요. 건축가는 긴 길이를 m로 말해요": 188, "연필 길이에 알맞은 단위는 무엇일까요?.": 189, "연필은 짧아요. 짧은 것은 cm로 재요": 190, "손에 쥐는 작은 물건은 cm로 재요": 191, "교실 긴 쪽의 길이에 알맞은 단위는 무엇일까요?.": 192, "교실은 아주 길어요. 긴 것은 m로 재요": 193, "건축가는 방의 크기를 m로 재서 설계도를 그려요": 194, "문 높이에 알맞은 단위는 무엇일까요?.": 195, "문은 사람보다 커요. 2cm라면 손가락보다 짧아요!.": 196, "문 높이는 약 2m예요. 200cm라고도 말해요": 197, "휴대폰 길이에 알맞은 단위는 무엇일까요?.": 198, "휴대폰은 손에 쥘 만큼 짧아요": 199, "15m라면 버스보다 긴 휴대폰이 돼요!.": 200, "1m보다 긴 것은 무엇일까요?.": 201, "1m는 어른 한 걸음쯤이에요. 그보다 긴 것을 찾아요": 202, "버스는 길이가 약 11m예요": 203, "보건 선생님과 간호사는 키와 몸무게를 재서 우리가 건강하게 자라는지 살펴봐요. 키는 cm, 몸무게는 kg으로 재요": 204, "월이의 키는 몇 cm일까요?.": 205, "빨간 선 아래쪽 큰 숫자 130을 찾고, 작은 눈금을 더 세어 봐요": 206, "보건 선생님은 키를 재서 건강 기록에 적어요": 207, "120과 130 사이 가운데 긴 눈금이 125예요": 209, "키가 자라면 책상과 의자 높이도 맞춰 바꿔요": 210, "아리의 몸무게는 몇 kg일까요?.": 211, "바늘이 30을 조금 지났어요. 30에서 작은 눈금을 세어요": 212, "몸무게를 재면 건강하게 자라는지 알 수 있어요": 213, "월이의 몸무게는 몇 kg일까요?.": 214, "바늘이 30보다 조금 덜 갔어요. 20에서 작은 눈금을 세어 봐요": 215, "보건실 체중계는 kg으로 몸무게를 알려 줘요": 216, "지난봄 월이 키는 128cm였어요. 지금은 132cm예요. 몇 cm 컸을까요?.": 217, "파란 점선과 빨간 선 사이의 작은 눈금 칸을 세어 봐요": 218, "키를 재서 비교하면 얼마나 자랐는지 알 수 있어요": 219, "제빵사는 밀가루와 설탕을 g(그램)으로 재요. 조금만 달라져도 빵 맛이 달라지기 때문에 저울을 꼭 써요": 220, "밀가루의 무게는 몇 g일까요?.": 221, "바늘이 가리키는 큰 숫자를 읽어요": 222, "빵 반죽에는 밀가루를 정확하게 넣어야 해요": 223, "설탕의 무게는 몇 g일까요?.": 224, "바늘이 100과 200 사이 가운데에 있어요. 가운데는 150이에요": 225, "설탕을 너무 많이 넣으면 빵이 너무 달아져요": 226, "버터의 무게는 몇 g일까요?.": 227, "400과 500 사이 가운데 눈금이에요": 228, "버터를 재서 넣으면 쿠키가 늘 똑같이 고소해요": 229, "밀가루 500g이 필요한데 저울은 400g이에요. 어떻게 할까요?.": 230, "400은 500보다 작아요. 모자라요": 231, "모자라면 더 넣고, 많으면 덜어 내요": 232, "초콜릿의 무게는 몇 g일까요?.": 233, "바늘 끝에 있는 큰 숫자를 읽어요": 234, "제빵사는 초콜릿 무게를 재서 케이크를 만들어요": 235, "택배 기사님은 상자의 무게를 kg(킬로그램)으로 재요. 무거운 상자는 배달비가 더 들고, 조심해서 옮겨요": 236, "상자의 무게는 몇 kg일까요?.": 237, "바늘이 가리키는 숫자를 읽어요": 238, "택배 기사님은 상자 무게를 보고 배달비를 정해요": 239, "수박의 무게는 몇 kg일까요?.": 240, "바늘 끝 숫자를 읽어요": 241, "시장 상인도 수박을 kg으로 재서 팔아요": 242, "쌀 포대의 무게는 몇 kg일까요?.": 243, "바늘이 10을 지났어요. 10에서 작은 눈금을 세어 봐요": 244, "무거운 쌀 포대는 둘이 함께 들어요": 245, "5kg보다 무거운 상자는 배달비가 더 들어요. 이 상자는 어떨까요?.": 246, "바늘이 5보다 더 많이 돌아갔어요": 247, "7kg은 5kg보다 무거워서 배달비가 더 들어요": 248, "사과 1개의 무게에 알맞은 단위는 무엇일까요?.": 249, "사과는 가벼워요. 가벼운 것은 g으로 재요": 250, "1kg은 1000g이에요. 사과 300kg이면 사과 상자 수십 개만큼 무거워요!.": 251, "수박 1통의 무게에 알맞은 단위는 무엇일까요?.": 252, "수박은 무거워요. 무거운 것은 kg으로 재요": 253, "6g이면 사탕 몇 개 무게예요. 수박은 6kg쯤이에요": 254, "바리스타는 우유와 물을 mL(밀리리터)로 재요. 늘 같은 양을 넣어야 언제 마셔도 맛이 똑같아요": 255, "우유는 몇 mL일까요?.": 256, "우유 윗면과 같은 높이의 숫자를 읽어요": 257, "라떼에는 우유를 정확하게 재서 넣어요": 258, "물은 몇 mL일까요?.": 259, "300과 400 사이 가운데 눈금이에요": 260, "아메리카노는 물의 양으로 맛이 진하거나 연해져요": 261, "커피는 몇 mL일까요?.": 262, "100과 200 사이 가운데 눈금이에요": 263, "커피를 정해진 양만큼 담아요": 264, "라떼에 우유 300mL가 필요해요. 지금 200mL예요. 어떻게 할까요?.": 265, "우유가 빨간 점선까지 오지 않았어요": 266, "모자라면 빨간 선까지 더 부어요": 267, "더 많이 담긴 컵은 어느 것일까요?.": 268, "두 컵의 눈금 숫자를 읽고 비교해요": 269, "mL 숫자가 클수록 양이 많아요": 270, "수족관 사육사는 어항의 물을 L(리터)로 재요. 많은 양은 L로, 적은 양은 mL로 재요. 1L는 1000mL예요": 271, "어항의 물은 몇 L일까요?.": 272, "물 윗면과 같은 높이의 숫자를 읽어요": 273, "사육사는 물고기 수에 맞게 물의 양을 맞춰요": 274, "물통의 물은 몇 L일까요?.": 275, "물 윗면 옆 숫자를 읽어요": 276, "큰 물통의 물은 L로 재요": 277, "1L는 몇 mL일까요?.": 278, "1L는 아주 많은 양이에요. 1 뒤에 0이 3개 붙어요": 279, "1L는 1000mL예요. 큰 우유갑 하나가 1L예요": 280, "우유 한 컵의 양에 알맞은 단위는 무엇일까요?.": 281, "한 컵은 적은 양이에요. 적은 양은 mL로 재요": 282, "200L라면 욕조를 가득 채울 만큼이에요!.": 283, "욕조에 받은 물의 양에 알맞은 단위는 무엇일까요?.": 284, "욕조는 아주 커요. 많은 양은 L로 재요": 285, "욕조처럼 큰 그릇의 물은 L로 재요": 286, "간호사는 체온계로 몸의 온도를 재서 열이 나는지 알아봐요. 요리사는 오븐 온도를, 도예가는 가마 온도를 맞춰요. 온도는 ℃(도)로 읽어요": 287, "오늘 기온은 몇 도일까요?.": 288, "빨간 기둥 끝이 20과 30 사이 가운데에 있어요": 289, "기온을 알면 어떤 옷을 입을지 정할 수 있어요": 290, "체온이 36.5도예요. 37.5도부터 열이에요. 열이 있나요?.": 291, "36.5는 37.5보다 낮아요": 292, "36.5도쯤이 건강한 사람의 체온이에요": 293, "체온이 38.2도예요. 열이 있나요?.": 294, "38.2는 37.5보다 높아요": 295, "열이 나면 보건 선생님께 알리고 쉬어야 해요": 296, "추운 날 기온은 몇 도일까요?.": 297, "빨간 기둥이 아주 짧아요. 0과 10 사이 가운데예요": 298, "추운 날에는 두꺼운 옷을 입어요": 299, "물이 펄펄 끓을 때 온도는 몇 도쯤일까요?.": 300, "아주 뜨거운 온도를 골라요": 301, "물은 약 100도에서 끓어요. 0도에서는 얼음이 돼요": 302, "재단사는 천 두 장을 이어 붙여 옷을 만들어요. 이어 붙인 길이는 두 길이를 더해서 구해요": 303, "40cm 천과 30cm 천을 이어 붙였어요. 모두 몇 cm일까요?.": 304, "두 길이를 더해요": 305, "재단사는 천 길이를 더해서 옷 길이를 정해요": 306, "25cm 끈 2개를 이어서 허리끈을 만들어요. 모두 몇 cm일까요?.": 307, "25와 25를 더해요. 20+20=40, 5+5=10이에요": 308, "허리끈 길이가 맞아야 치마가 흘러내리지 않아요": 309, "커튼 천 60cm에 45cm를 이어 붙였어요. 모두 몇 cm일까요?.": 310, "60과 45를 더해요. 60+40=100, 거기에 5를 더해요": 311, "긴 커튼은 천을 이어 붙여서 만들어요": 312, "10cm 리본 3개를 이었어요. 모두 몇 cm일까요?.": 313, "10씩 세어 봐요. 10, 20, 30": 314, "리본을 이어서 선물 포장을 해요": 315, "바지 길이 80cm에 10cm를 더 늘렸어요. 바지는 몇 cm가 될까요?.": 316, "80에 10을 더해요": 317, "키가 크면 옷 길이를 늘려서 고쳐 입어요": 318, "목수는 긴 나무에서 필요한 만큼 잘라 써요. 남은 나무의 길이는 빼기로 구해요": 319, "100cm 나무에서 30cm를 잘랐어요. 남은 나무는 몇 cm일까요?.": 320, "전체 100cm에서 자른 30cm를 빼요": 321, "남은 나무로 다른 물건을 만들 수 있어요": 322, "90cm 나무에서 40cm를 잘랐어요. 남은 나무는 몇 cm일까요?.": 323, "90에서 40을 빼요. 9−4를 생각해 봐요": 324, "목수는 나무를 아껴 쓰려고 남은 길이를 계산해요": 325, "80cm 판자에서 25cm를 잘랐어요. 남은 판자는 몇 cm일까요?.": 326, "80에서 20을 빼고, 5를 더 빼요": 327, "선반 하나를 만들고 남은 판자로 작은 상자를 만들어요": 328, "120cm 나무에서 50cm를 잘랐어요. 남은 나무는 몇 cm일까요?.": 329, "120에서 50을 빼요. 100에서 50을 빼면 50, 거기에 20을 더해요": 330, "긴 나무는 잘라서 여러 곳에 나누어 써요": 331, "책상 다리를 70cm로 만들려고 해요. 85cm 나무에서 몇 cm를 잘라 내야 할까요?.": 332, "85에서 70을 빼면 잘라 낼 길이가 나와요": 333, "필요한 길이만 남기고 나머지를 잘라 내요": 334, "커튼 가게에서는 창문 길이를 m와 cm로 재요. 1m는 100cm예요. 1m 20cm는 100cm와 20cm를 합한 120cm예요": 335, "1m 20cm는 몇 cm일까요?.": 336, "1m는 100cm예요. 100에 20을 더해요": 337, "커튼 가게에서는 cm로 바꿔서 천을 잘라요": 338, "2m는 몇 cm일까요?.": 339, "1m가 100cm니까 100을 두 번 더해요": 340, "긴 커튼은 2m가 넘기도 해요": 341, "150cm는 몇 m 몇 cm일까요?.": 342, "100cm가 1m예요. 150cm는 100cm와 50cm예요": 343, "150cm를 1m 50cm라고도 말해요": 344, "1m 5cm는 몇 cm일까요?.": 345, "100에 5를 더해요. 150이 아니에요!.": 346, "5cm는 아주 짧아요. 1m 5cm는 105cm예요": 347, "창문 길이는 1m 40cm예요. 커튼은 창문보다 20cm 더 길게 만들어요. 커튼은 몇 cm일까요?.": 348, "1m 40cm는 140cm예요. 거기에 20cm를 더해요": 349, "커튼을 창문보다 조금 길게 하면 빛이 새지 않아요": 350, "택배 기사님은 상자 무게를 더해서 한 번에 옮길 수 있는지 계산해요. 제빵사는 그릇 무게를 빼고 재료 무게만 구해요": 351, "1kg 상자에 3kg 책을 넣었어요. 모두 몇 kg일까요?.": 352, "1과 3을 더해요": 353, "택배 기사님은 전체 무게를 알고 상자를 옮겨요": 354, "그릇에 밀가루를 담았더니 500g이에요. 그릇만 재면 200g이에요. 밀가루만 몇 g일까요?.": 355, "전체 무게에서 그릇 무게를 빼요": 356, "제빵사는 그릇 무게를 빼서 재료 무게만 알아내요": 357, "5kg 수박과 2kg 멜론을 한 봉지에 담았어요. 모두 몇 kg일까요?.": 358, "5와 2를 더해요": 359, "무거운 봉지는 두 개로 나누어 들어요": 360, "택배 상자는 10kg까지 보낼 수 있어요. 지금 6kg이에요. 몇 kg 더 넣을 수 있을까요?.": 361, "10에서 6을 빼요": 362, "정해진 무게를 넘지 않게 담아야 택배를 보낼 수 있어요": 363, "설탕 300g과 버터 250g을 그릇에 넣었어요. 모두 몇 g일까요?.": 364, "300에 200을 더하고, 50을 더 더해요": 365, "재료 무게를 더하면 반죽 무게를 알 수 있어요": 366, "쌀가게와 마트에서는 무게를 kg과 g으로 말해요. 1kg은 1000g이에요": 367, "1kg은 몇 g일까요?.": 368, "1kg은 1 뒤에 0이 3개 붙어요": 369, "1kg은 1000g이에요. 큰 우유갑 하나쯤의 무게예요": 370, "2kg은 몇 g일까요?.": 371, "1000을 두 번 더해요": 372, "쌀 2kg은 2000g이에요": 373, "쌀 1kg 500g은 몇 g일까요?.": 374, "1kg은 1000g이에요. 1000에 500을 더해요": 375, "쌀가게는 g으로 바꿔서 봉지에 나누어 담아요": 376, "3000g은 몇 kg일까요?.": 377, "1000g이 1kg이에요. 1000g이 몇 개인지 세어 봐요": 378, "3000g은 3kg이에요. kg으로 말하면 더 간단해요": 379, "쌀 1kg을 500g 봉지에 나누어 담아요. 몇 봉지가 될까요?.": 380, "500과 500을 더하면 1000이에요": 381, "쌀가게는 큰 포대를 작은 봉지에 나누어 팔아요": 382, "요리사는 국을 끓일 때 물과 육수의 양을 더하고 빼요. 1L는 1000mL예요": 383, "물 500mL와 우유 300mL를 섞었어요. 모두 몇 mL일까요?.": 384, "500과 300을 더해요. 5+3을 생각해요": 385, "요리사는 재료의 양을 더해서 냄비 크기를 골라요": 386, "1L 우유에서 200mL를 따랐어요. 남은 우유는 몇 mL일까요?.": 387, "1L는 1000mL예요. 1000에서 200을 빼요": 388, "남은 양을 알면 장을 볼 때 무엇이 필요한지 알 수 있어요": 389, "육수 1L에 물 500mL를 더 넣었어요. 모두 몇 mL일까요?.": 390, "1000에 500을 더해요": 391, "국물이 짜면 물을 더 넣어 맛을 맞춰요": 392, "국을 끓이려면 물 900mL가 필요해요. 지금 600mL를 넣었어요. 몇 mL 더 넣어야 할까요?.": 393, "900에서 600을 빼요. 빨간 점선까지 몇 칸이 남았는지 세어도 돼요": 394, "정해진 양을 맞춰야 국 맛이 늘 똑같아요": 395, "물 2L에서 500mL를 썼어요. 남은 물은 몇 mL일까요?.": 396, "2L는 2000mL예요. 2000에서 500을 빼요": 397, "요리사는 남은 물로 다음 요리를 준비해요": 398, "똑같은 것을 여러 개 만들 때는 곱하기를 써요. 목수는 의자 다리 4개를, 제빵사는 케이크 여러 개를 만들어요": 399, "의자 다리 1개는 40cm예요. 다리 4개를 만들려면 나무가 몇 cm 필요할까요?.": 400, "40을 4번 더해요. 40, 80, 120, 160": 401, "목수는 필요한 나무 길이를 미리 계산해서 사요": 402, "케이크 1개에 밀가루 200g이 들어가요. 케이크 2개를 만들려면 몇 g이 필요할까요?.": 403, "200을 2번 더해요": 404, "제빵사는 만들 개수만큼 재료를 곱해서 준비해요": 405, "컵 3개에 우유를 200mL씩 담아요. 우유가 모두 몇 mL 필요할까요?.": 406, "200을 3번 더해요. 200, 400, 600": 407, "바리스타는 손님 수만큼 우유를 준비해요": 408, "2kg 상자가 5개 있어요. 모두 몇 kg일까요?.": 409, "2씩 5번 세어 봐요. 2, 4, 6, 8, 10": 410, "택배 기사님은 상자 수와 무게로 전체 무게를 알아요": 411, "선물 6개에 리본을 30cm씩 묶어요. 리본이 모두 몇 cm 필요할까요?.": 412, "30을 6번 더해요. 30, 60, 90, 120, 150, 180": 413, "포장하는 사람은 리본이 모자라지 않게 미리 계산해요": 414, "많은 양을 똑같이 나눌 때는 나누기를 써요. 바리스타는 우유를 여러 컵에, 도예가는 점토를 여러 덩이로 나눠요": 415, "우유 1L(1000mL)를 200mL 컵에 나누어 담아요. 몇 잔이 될까요?.": 416, "200mL씩 몇 번 들어가는지 세어요. 200, 400, 600, 800, 1000": 417, "바리스타는 우유 한 통으로 몇 잔을 만들 수 있는지 알아요": 418, "리본 120cm를 30cm씩 잘라요. 몇 개가 될까요?.": 419, "30씩 세어 120이 될 때까지 몇 번인지 봐요. 30, 60, 90, 120": 420, "리본을 똑같이 잘라 선물마다 하나씩 묶어요": 421, "점토 2kg(2000g)을 500g씩 나누어 그릇을 만들어요. 그릇을 몇 개 만들 수 있을까요?.": 422, "500씩 세어 봐요. 500, 1000, 1500, 2000": 423, "도예가는 점토를 똑같은 무게로 나누어 같은 크기 그릇을 만들어요": 424, "나무 90cm를 똑같이 3도막으로 잘라요. 한 도막은 몇 cm일까요?.": 425, "어떤 수를 3번 더하면 90이 될까요? 30+30+30을 생각해요": 426, "목수는 나무를 똑같이 나누어 선반 칸을 만들어요": 427, "쌀 3kg을 3봉지에 똑같이 나누어요. 한 봉지는 몇 kg일까요?.": 428, "3을 셋으로 똑같이 나누면 하나에 몇일까요?.": 429, "똑같이 나누면 모두 같은 양을 받아요": 430, "이제 여러 직업 사람이 되어 재고 계산해 봐요. 두 번 계산해야 하는 문제도 있어요. 천천히 하나씩 풀어 봐요": 431, "🏺 도예가: 점토 1kg으로 컵을 만들어요. 컵 1개에 점토 200g이 들어가요. 컵을 몇 개 만들 수 있을까요?.": 432, "1kg은 1000g이에요. 200씩 세어 1000까지 가 봐요": 433, "도예가는 점토 무게로 몇 개를 만들지 정해요": 434, "🪑 목수: 의자 다리 45cm 4개와 등받이 50cm 1개를 만들어요. 나무가 모두 몇 cm 필요할까요?.": 435, "먼저 다리 4개 길이를 구해요. 45, 90, 135, 180. 그다음 등받이 50을 더해요": 436, "목수는 필요한 나무를 모두 더해서 한 번에 준비해요": 437, "🍪 제빵사: 쿠키 1판에 버터 150g이 들어가요. 버터 500g으로 쿠키 2판을 만들면 버터가 몇 g 남을까요?.": 438, "2판에 쓰는 버터는 150+150=300g이에요. 500에서 300을 빼요": 439, "남은 재료를 알면 다음에 무엇을 만들지 정할 수 있어요": 440, "✂️ 재단사: 치마 길이는 60cm예요. 위와 아래에 접어서 꿰맬 부분이 5cm씩 더 필요해요. 천은 몇 cm 필요할까요?.": 441, "5와 60과 5를 모두 더해요": 442, "재단사는 접는 부분까지 생각해서 천을 넉넉히 잘라요": 443, "☕ 바리스타: 우유 1L로 라떼를 만들어요. 라떼 1잔에 우유 250mL가 들어가요. 몇 잔을 만들 수 있을까요?.": 444, "250씩 세어 봐요. 250, 500, 750, 1000": 445, "바리스타는 우유가 몇 잔 분량인지 알고 미리 준비해요": 446, "🚚 택배 기사: 상자 3개의 무게가 2kg, 3kg, 4kg이에요. 모두 몇 kg일까요?.": 447, "2와 3을 더하고, 4를 더 더해요": 448, "택배 기사님은 차에 실은 전체 무게를 알아야 안전해요": 449, "🩺 보건 선생님: 1학기 키는 128cm, 2학기 키는 133cm예요. 몇 cm 컸을까요?.": 450, "133에서 128을 빼요. 두 선 사이 칸을 세어도 돼요": 451}, "data": ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "